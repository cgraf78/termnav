#!/usr/bin/env bash
# Run all repo-owned termnav test suites.

set -euo pipefail

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${test_dir%/test}"

# Shell/Lua integration suites exercise the optimized artifact that users
# receive, not a historical script facade or Cargo's debug-only test binary.
# Build once here and pass one explicit path to every suite.
if [[ -z ${TERMNAV_TEST_BINARY:-} ]]; then
  cargo build --release --locked --manifest-path "$root/Cargo.toml"
  TERMNAV_TEST_BINARY="$root/target/release/termnav"
  export TERMNAV_TEST_BINARY
fi

# Keep runtime entry points explicit so additions require a lint review.
runtime_shell_files=(
  "$root/lib/termnav/nvim-open/launcher.sh"
  "$root/lib/termnav/shell/file-links.sh"
  "$root/lib/termnav/shell/wezterm-vars.sh"
  "$root/share/termnav/shell.sh"
  "$root/share/termnav/shims/ssh"
)

example_shell_files=(
  "$root/examples/tmux-follow/extensions.d/example-ticket.sh"
)

tooling_shell_files=(
  "$root/install.sh"
  "$root/scripts/package-release.sh"
  "$root/scripts/release-lib.sh"
  "$root/scripts/release-smoke-hook.sh"
  "$root/scripts/release-tag.sh"
  "$root/scripts/release-version.sh"
  "$root/scripts/release.sh"
  "$root/scripts/smoke-release.sh"
)

check_runtime_shell_inventory() {
  local file first_line listed discovered
  listed=$(
    for file in "${runtime_shell_files[@]}"; do
      printf '%s\n' "${file#"$root"/}"
    done | LC_ALL=C sort
  )
  discovered=$(
    while IFS= read -r file; do
      # `git ls-files` still reports deletions until they are staged. Ignore
      # absent paths so local pre-commit verification sees the same inventory
      # that CI will see from the resulting commit.
      [[ -f "$root/$file" ]] || continue
      case "$file" in
        *.sh | *.sh.template)
          printf '%s\n' "$file"
          continue
          ;;
      esac
      first_line=""
      IFS= read -r first_line <"$root/$file" || true
      if [[ "$first_line" == '#!'*bash* ||
        "$first_line" == '#!'*dash* ||
        "$first_line" == '#!'*ksh* ||
        "$first_line" == '#!'*/sh ||
        "$first_line" == '#!'*'/sh '* ||
        "$first_line" == '#!'*' sh' ||
        "$first_line" == '#!'*' sh '* ||
        "$first_line" == '# shellcheck shell=bash' ||
        "$first_line" == '# shellcheck shell=dash' ||
        "$first_line" == '# shellcheck shell=ksh' ||
        "$first_line" == '# shellcheck shell=sh' ]]; then
        printf '%s\n' "$file"
      fi
    done < <(git -C "$root" ls-files -- bin lib share)
  )
  discovered=$(printf '%s\n' "$discovered" | sed '/^$/d' | LC_ALL=C sort)

  if [[ "$listed" != "$discovered" ]]; then
    printf 'termnav-test: runtime shell inventory is stale\n' >&2
    diff -u \
      <(printf '%s\n' "$listed") \
      <(printf '%s\n' "$discovered") >&2 || true
    return 1
  fi
}

check_runtime_shell_inventory
# CI's matrix legs lint here. Only the Termux leg sets TERMNAV_SKIP_SHELLCHECK=1,
# because its dependency profile has no ShellCheck.
if [[ "${TERMNAV_SKIP_SHELLCHECK:-0}" != 1 ]]; then
  shellcheck -x -P SCRIPTDIR \
    "${runtime_shell_files[@]}" \
    "${example_shell_files[@]}" \
    "${tooling_shell_files[@]}" \
    "$test_dir/termnav-test" \
    "$test_dir/helpers.sh" \
    "$test_dir/tmux-version.sh" \
    "$test_dir"/suites/*-test
fi

# Settle tmux once for every suite. TERMNAV_REQUIRE_TMUX=1, which CI sets
# wherever it runs these suites, turns a missing or unsupported tmux into a
# failure rather than skipped cases. Feature gates inside suites (send-keys -K
# needs 3.4, and so on) stay ordinary skips.
# Only the version rule: helpers.sh sets up a suite's own temporary HOME,
# XDG and TMPDIR roots and EXIT trap, which must not nest under the runner's.
# shellcheck source=tmux-version.sh
. "$test_dir/tmux-version.sh"
_tmux_floor >/dev/null || exit 1
TERMNAV_TEST_TMUX=$(_termnav_tmux_state)
export TERMNAV_TEST_TMUX
if [[ $TERMNAV_TEST_TMUX != ok ]]; then
  read -r floor_major floor_minor <<<"$(_tmux_floor)"
  reason="tmux $floor_major.$floor_minor or newer is required (${TERMNAV_TEST_TMUX})"
  if [[ ${TERMNAV_REQUIRE_TMUX:-0} == 1 ]]; then
    printf 'termnav-test: FAIL: %s\n' "$reason" >&2
    exit 1
  fi
  printf 'termnav-test: SKIP: tmux cases: %s\n' "$reason"
fi
# The CI floor profile names the floor it provides, and, on the leg that built
# it, that this run must use exactly that release.
if [[ -n ${CI_TMUX_FLOOR:-} ]]; then
  read -r floor_major floor_minor <<<"$(_tmux_floor)"
  if [[ $(_tmux_release "$CI_TMUX_FLOOR") != "$floor_major $floor_minor" ]]; then
    printf 'termnav-test: FAIL: CI provides tmux %s, but the floor is %s.%s\n' \
      "$CI_TMUX_FLOOR" "$floor_major" "$floor_minor" >&2
    exit 1
  fi
  if [[ ${CI_TMUX_FLOOR_EXACT:-} == 1 && $(tmux -V 2>/dev/null) != "tmux $CI_TMUX_FLOOR" ]]; then
    printf 'termnav-test: FAIL: this leg built tmux %s, but runs %s\n' \
      "$CI_TMUX_FLOOR" "$(tmux -V 2>&1)" >&2
    exit 1
  fi
fi

for suite in "$test_dir"/suites/*-test; do
  "$suite"
done

printf 'termnav-test: ok\n'
