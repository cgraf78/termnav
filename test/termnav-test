#!/usr/bin/env bash
# Run all repo-owned termnav test suites.

set -euo pipefail

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${test_dir%/test}"

# Shell/Lua integration suites exercise the optimized artifact that users
# receive, not a historical script facade or Cargo's debug-only test binary.
# Build once here and pass one explicit path to every suite.
if [[ -z ${TERMNAV_TEST_BINARY:-} ]]; then
  cargo build --release --locked --manifest-path "$root/Cargo.toml"
  TERMNAV_TEST_BINARY="$root/target/release/termnav"
  export TERMNAV_TEST_BINARY
fi

# Keep runtime entry points explicit so additions require a lint review.
runtime_shell_files=(
  "$root/lib/termnav/nvim-open/launcher.sh"
  "$root/lib/termnav/shell/file-links.sh"
  "$root/lib/termnav/shell/wezterm-vars.sh"
  "$root/share/termnav/shell.sh"
  "$root/share/termnav/shims/ssh"
)

example_shell_files=(
  "$root/examples/tmux-follow/extensions.d/example-ticket.sh"
)

tooling_shell_files=(
  "$root/install.sh"
  "$root/scripts/package-release.sh"
  "$root/scripts/release-lib.sh"
  "$root/scripts/release-smoke-hook.sh"
  "$root/scripts/release-tag.sh"
  "$root/scripts/release-version.sh"
  "$root/scripts/release.sh"
  "$root/scripts/smoke-release.sh"
)

check_runtime_shell_inventory() {
  local file first_line listed discovered
  listed=$(
    for file in "${runtime_shell_files[@]}"; do
      printf '%s\n' "${file#"$root"/}"
    done | LC_ALL=C sort
  )
  discovered=$(
    while IFS= read -r file; do
      # `git ls-files` still reports deletions until they are staged. Ignore
      # absent paths so local pre-commit verification sees the same inventory
      # that CI will see from the resulting commit.
      [[ -f "$root/$file" ]] || continue
      case "$file" in
        *.sh | *.sh.template)
          printf '%s\n' "$file"
          continue
          ;;
      esac
      first_line=""
      IFS= read -r first_line <"$root/$file" || true
      if [[ "$first_line" == '#!'*bash* ||
        "$first_line" == '#!'*dash* ||
        "$first_line" == '#!'*ksh* ||
        "$first_line" == '#!'*/sh ||
        "$first_line" == '#!'*'/sh '* ||
        "$first_line" == '#!'*' sh' ||
        "$first_line" == '#!'*' sh '* ||
        "$first_line" == '# shellcheck shell=bash' ||
        "$first_line" == '# shellcheck shell=dash' ||
        "$first_line" == '# shellcheck shell=ksh' ||
        "$first_line" == '# shellcheck shell=sh' ]]; then
        printf '%s\n' "$file"
      fi
    done < <(git -C "$root" ls-files -- bin lib share)
  )
  discovered=$(printf '%s\n' "$discovered" | sed '/^$/d' | LC_ALL=C sort)

  if [[ "$listed" != "$discovered" ]]; then
    printf 'termnav-test: runtime shell inventory is stale\n' >&2
    diff -u \
      <(printf '%s\n' "$listed") \
      <(printf '%s\n' "$discovered") >&2 || true
    return 1
  fi
}

check_runtime_shell_inventory
# Shared CI lints once in its dedicated job; local runs still lint by default.
if [[ "${TERMNAV_SKIP_SHELLCHECK:-0}" != 1 ]]; then
  shellcheck -x -P SCRIPTDIR \
    "${runtime_shell_files[@]}" \
    "${example_shell_files[@]}" \
    "${tooling_shell_files[@]}" \
    "$test_dir/termnav-test" \
    "$test_dir/helpers.sh" \
    "$test_dir"/suites/*-test
fi

for suite in "$test_dir"/suites/*-test; do
  "$suite"
done

printf 'termnav-test: ok\n'
