#!/usr/bin/env bash
# relay-terminal-test - real tmux and PTY coverage for the terminal commit barrier.

set -euo pipefail
export NO_COLOR=1

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"
# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"

echo "=== terminal-independent relay commit ==="
relay_adapter=$(_tmpdir)/termnav-relay
_termnav_command_adapter "$relay_adapter" \
  "${TERMNAV_TEST_BINARY:-$root/target/release/termnav}" relay
set +e
output=$(_with_timeout 10m python3 "$test_dir/support/relay-terminal.py" \
  --relay "$relay_adapter" \
  --python-relay "$test_dir/support/python-peer/relay.py" \
  --termnav "${TERMNAV_TEST_BINARY:-$root/target/release/termnav}" 2>&1)
rc=$?
set -e
printf '%s\n' "$output"
_assert_exit "relay terminal: real tmux/PTY integration passes" 0 "$rc"
_assert_contains "relay terminal: all five DECRQM states are exercised" \
  "test_all_decrqm_states_commit_pane_navigation" "$output"
_assert_contains "relay terminal: nested tmux handoff and parent bubble are exercised" \
  "test_nested_commit_and_parent_bubble_use_one_terminal_barrier" "$output"
_assert_contains "relay terminal: three nested tmux levels share one barrier" \
  "test_three_tmux_levels_prepare_before_one_terminal_barrier" "$output"
_assert_contains "relay terminal: mixed Rust/Python paths commit both ways" \
  "test_mixed_version_three_level_paths_commit_in_both_directions" "$output"
_assert_contains "relay terminal: mixed lost prepare replies abort cleanly" \
  "test_mixed_version_lost_prepare_reply_can_be_aborted" "$output"
_assert_contains "relay terminal: one-shot continuation preserves burst routing" \
  "test_one_shot_continuation_preserves_a_nested_navigation_burst" "$output"
_assert_contains "relay terminal: every canonical navigation action is exercised" \
  "test_window_move_commits_after_terminal_response" "$output"
if [[ $output == *APPLICATION_DECRQM_PRESERVED* ]]; then
  _pass "relay terminal: pane DECRQM remains application-safe"
elif [[ $output == *"tmux neither virtualizes nor forwards application DECRQM"* ]]; then
  # Some tmux builds consume this application query without forwarding or
  # virtualizing it. Report that platform limitation honestly rather than using
  # unittest's printed method name as a false-positive coverage signal.
  echo "  SKIP: relay terminal: tmux does not expose application DECRQM behavior"
else
  _fail "relay terminal: pane DECRQM behavior produced no result"
fi
_assert_contains "relay terminal: a one-window SSH hop reaches the outer terminal" \
  "test_one_window_tab_selection_reaches_the_outer_terminal" "$output"
_assert_contains "relay terminal: remote bubbling reaches the VS Code window adapter" \
  "test_one_window_tab_selection_reaches_the_vscode_window_adapter" "$output"
_assert_contains "relay terminal: post-start focus changes select the live client" \
  "test_relay_started_before_focus_switch_targets_the_live_client" "$output"

_test_summary
