#!/usr/bin/env bash
# vscode-focus-test - fail-closed VS Code Neovim focus ownership.

set -euo pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

client_pids=()
_cleanup_focus_test() {
  if ((${#client_pids[@]})); then
    kill "${client_pids[@]}" 2>/dev/null || true
    wait "${client_pids[@]}" 2>/dev/null || true
  fi
  _cleanup
}
trap _cleanup_focus_test EXIT

_process_environment() {
  local pid="$1"

  if [[ -r "/proc/$pid/environ" ]]; then
    tr '\0' '\n' <"/proc/$pid/environ"
    return
  fi
  ps eww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n'
}

extension_dir="$TERMNAV_ROOT/share/termnav/vscode/termnav-0.2.0"
focus_cli="$TERMNAV_ROOT/bin/vscode-nvim-focus"

echo "=== VS Code nvim focus state machine ==="

_assert_file_exists "focus publisher: CLI is shipped" "$focus_cli"
_assert_file_exists "focus adapter: versioned manifest is shipped" \
  "$extension_dir/package.json"
_assert_file_exists "focus adapter: implementation is shipped" \
  "$extension_dir/extension.js"

if [[ ! -x "$focus_cli" || ! -r "$extension_dir/extension.js" ]]; then
  _test_summary
fi

mock_bin=$(_tmpdir)
focus_log=$(_tmpdir)/focus.log
cat >"$mock_bin/curl" <<'EOF'
#!/usr/bin/env bash
{
  printf 'argv:'
  printf ' <%s>' "$@"
  printf '\n'
} >>"$TERMNAV_FOCUS_LOG"
printf '{"ok":true}\n'
EOF
chmod +x "$mock_bin/curl"

TERMNAV_VSCODE_SOCKET=/tmp/window.sock TERMNAV_FOCUS_LOG="$focus_log" \
  PATH="$mock_bin:$PATH" env -u TMUX -u TMUX_PANE \
  "$focus_cli" claim nvim-a 2 7 12345
focus_call=$(cat "$focus_log")
_assert_contains "focus publisher: direct terminal uses its window socket" \
  "<--unix-socket> </tmp/window.sock>" "$focus_call"
_assert_contains "focus publisher: posts only to the focus endpoint" \
  "<http://localhost/nvim-focus>" "$focus_call"
_assert_contains "focus publisher: sends versioned ordered ownership" \
  '"version":1,"source":"nvim-a","cycle":2,"sequence":7,"observed":12345,"operation":"claim"' \
  "$focus_call"

set +e
invalid_output=$("$focus_cli" claim 'bad source' 1 1 1 2>&1)
invalid_rc=$?
set -e
_assert_exit "focus publisher: rejects unsafe source identifiers" 2 "$invalid_rc"
_assert_contains "focus publisher: invalid input has an actionable diagnostic" \
  "invalid source" "$invalid_output"

cat >"$mock_bin/tmux" <<'EOF'
#!/usr/bin/env bash
printf '%b' "$TERMNAV_TMUX_CLIENTS"
EOF
chmod +x "$mock_bin/tmux"

env TERMNAV_VSCODE_SOCKET=/tmp/window-a.sock sleep 60 &
client_a=$!
client_pids+=("$client_a")
env TERMNAV_VSCODE_SOCKET=/tmp/window-b.sock sleep 60 &
client_b=$!
client_pids+=("$client_b")
for _ in {1..100}; do
  if _process_environment "$client_a" |
    grep -Fqx 'TERMNAV_VSCODE_SOCKET=/tmp/window-a.sock' &&
    _process_environment "$client_b" |
    grep -Fqx 'TERMNAV_VSCODE_SOCKET=/tmp/window-b.sock'; then
    break
  fi
  sleep 0.01
done
_assert_contains "focus publisher fixture: first client environment is ready" \
  "TERMNAV_VSCODE_SOCKET=/tmp/window-a.sock" \
  "$(_process_environment "$client_a")"
_assert_contains "focus publisher fixture: second client environment is ready" \
  "TERMNAV_VSCODE_SOCKET=/tmp/window-b.sock" \
  "$(_process_environment "$client_b")"

: >"$focus_log"
TERMNAV_TMUX_CLIENTS="$client_a|%1|attached,focused\n$client_b|%2|attached\n" \
  TERMNAV_FOCUS_LOG="$focus_log" TMUX=/tmp/tmux.sock,1,0 TMUX_PANE=%1 \
  PATH="$mock_bin:$PATH" "$focus_cli" claim nvim-tmux 1 1 20000
tmux_claim=$(cat "$focus_log")
_assert_contains "focus publisher: tmux claim uses the focused client window" \
  "</tmp/window-a.sock>" "$tmux_claim"
_assert_not_contains "focus publisher: tmux claim ignores another pane" \
  "</tmp/window-b.sock>" "$tmux_claim"

: >"$focus_log"
TERMNAV_TMUX_CLIENTS="$client_a|%2|attached\n$client_b|%2|attached,focused\n" \
  TERMNAV_FOCUS_LOG="$focus_log" TMUX=/tmp/tmux.sock,1,0 TMUX_PANE=%1 \
  PATH="$mock_bin:$PATH" "$focus_cli" release nvim-tmux 1 2 20001
tmux_release=$(cat "$focus_log")
_assert_contains "focus publisher: release reaches the previously focused window" \
  "</tmp/window-a.sock>" "$tmux_release"
_assert_contains "focus publisher: release is harmlessly broadcast to attached windows" \
  "</tmp/window-b.sock>" "$tmux_release"

: >"$focus_log"
set +e
TERMNAV_TMUX_CLIENTS="" TERMNAV_FOCUS_LOG="$focus_log" \
  TMUX=/tmp/tmux.sock,1,0 TMUX_PANE=%1 PATH="$mock_bin:$PATH" \
  "$focus_cli" claim nvim-detached 1 1 20002
detached_rc=$?
set -e
_assert_exit "focus publisher: detached tmux has no renewable owner" 10 "$detached_rc"
_assert_eq "focus publisher: detached tmux emits no stale claim" "" "$(cat "$focus_log")"

if command -v node >/dev/null 2>&1; then
  node_modules=$(_tmpdir)/node_modules
  mkdir -p "$node_modules/vscode"
  cat >"$node_modules/vscode/index.js" <<'EOF'
const calls = [];
let rejectNextContext = false;
const listeners = {
  activeTerminal: [],
  closeTerminal: [],
  windowState: [],
};

const terminal = { processId: Promise.resolve(process.pid) };
const window = {
  activeTerminal: terminal,
  state: { focused: true },
  onDidChangeActiveTerminal(callback) {
    listeners.activeTerminal.push(callback);
    return { dispose() {} };
  },
  onDidCloseTerminal(callback) {
    listeners.closeTerminal.push(callback);
    return { dispose() {} };
  },
  onDidChangeWindowState(callback) {
    listeners.windowState.push(callback);
    return { dispose() {} };
  },
};

module.exports = {
  commands: {
    executeCommand(command, ...args) {
      calls.push([command, ...args]);
      if (command === "setContext" && rejectNextContext) {
        rejectNextContext = false;
        return Promise.reject(new Error("injected setContext failure"));
      }
      return Promise.resolve();
    },
  },
  window,
  __calls: calls,
  __listeners: listeners,
  __rejectNextContext() {
    rejectNextContext = true;
  },
  __terminal: terminal,
};
EOF

  focus_output=$(
    NODE_PATH="${node_modules%/node_modules}/node_modules" node - "$extension_dir/extension.js" <<'NODE'
const extension = require(process.argv[2]);
const vscode = require("vscode");

let now = 1000;
let nextTimer = 1;
const timers = new Map();
const controller = extension.createFocusController({
  leaseMs: 3000,
  now: () => now,
  observedNow: () => now,
  setTimer(callback, delay) {
    const id = nextTimer++;
    timers.set(id, { callback, at: now + delay });
    return id;
  },
  clearTimer(id) {
    timers.delete(id);
  },
  isDescendant: async (pid, ancestor) => pid === ancestor,
});

async function flush() {
  await controller.flush();
}

async function advance(milliseconds) {
  now += milliseconds;
  const due = [...timers.entries()].filter(([, timer]) => timer.at <= now);
  for (const [id, timer] of due) {
    timers.delete(id);
    timer.callback();
  }
  await flush();
}

function message(source, cycle, sequence, observed, operation, clientPid = process.pid) {
  return { version: 1, source, cycle, sequence, observed, operation, clientPid };
}

function contextValues() {
  return vscode.__calls
    .filter((call) => call[0] === "setContext" && call[1] === "termnav.nvimFocused")
    .map((call) => String(call[2]));
}

async function main() {
  await controller.initialize();
  console.log("initial=" + contextValues().at(-1));

  console.log("claim=" + (await controller.handle(
    message("nvim-a", 1, 1, 1000, "claim"),
  )));
  await flush();
  console.log("claimed=" + contextValues().at(-1));

  console.log("stale-release=" + (await controller.handle(
    message("nvim-a", 1, 0, 999, "release"),
  )));
  await flush();
  console.log("after-stale=" + contextValues().at(-1));

  await controller.handle(message("nvim-b", 1, 1, 1002, "claim"));
  await controller.handle(message("nvim-a", 1, 2, 1003, "release"));
  await flush();
  console.log("foreign-release=" + contextValues().at(-1));

  await controller.handle(message("nvim-a", 2, 1, 1001, "claim"));
  await flush();
  console.log("delayed-claim=" + contextValues().at(-1));

  await advance(3001);
  console.log("expired=" + contextValues().at(-1));

  now = 5000;
  await controller.handle(message("nvim-c", 1, 1, 5000, "claim"));
  await flush();
  vscode.window.activeTerminal = { processId: Promise.resolve(process.pid + 1) };
  await controller.activeTerminalChanged();
  await flush();
  console.log("terminal-change=" + contextValues().at(-1));

  vscode.window.state.focused = true;
  vscode.window.activeTerminal = vscode.__terminal;
  now = 6000;
  await controller.handle(message("nvim-d", 1, 1, 6000, "claim"));
  await flush();
  await controller.terminalClosed(vscode.__terminal);
  await flush();
  console.log("active-close=" + contextValues().at(-1));

  now = 7000;
  await controller.handle(message("nvim-e", 1, 1, 7000, "claim"));
  await flush();
  vscode.window.state.focused = false;
  await controller.windowStateChanged({ focused: false });
  await flush();
  console.log("window-blur=" + contextValues().at(-1));

  vscode.window.state.focused = true;
  console.log("pre-blur-claim=" + (await controller.handle(
    message("nvim-delayed", 1, 1, 6999, "claim"),
  )));
  await flush();
  console.log("after-pre-blur-claim=" + contextValues().at(-1));

  console.log("dead-pid=" + (await controller.handle(
    message("nvim-f", 1, 1, 7001, "claim", process.pid + 99),
  )));

  now = 8001;
  vscode.__rejectNextContext();
  let contextFailure = false;
  try {
    await controller.handle(message("nvim-g", 1, 1, 8001, "claim"));
  } catch {
    contextFailure = true;
  }
  console.log("context-failure=" + contextFailure);
  await controller.activeTerminalChanged();
  await flush();
  console.log("context-recovery=" + contextValues().at(-1));
  await controller.dispose();
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
NODE
  )

  _assert_contains "focus adapter: activation starts fail closed" \
    "initial=false" "$focus_output"
  _assert_contains "focus adapter: validated claim enables passthrough" \
    "claim=true" "$focus_output"
  _assert_contains "focus adapter: context reflects a validated claim" \
    "claimed=true" "$focus_output"
  _assert_contains "focus adapter: stale release is rejected" \
    "stale-release=false" "$focus_output"
  _assert_contains "focus adapter: stale release cannot clear ownership" \
    "after-stale=true" "$focus_output"
  _assert_contains "focus adapter: one source cannot release another owner" \
    "foreign-release=true" "$focus_output"
  _assert_contains "focus adapter: globally delayed claim cannot replace newer focus" \
    "delayed-claim=true" "$focus_output"
  _assert_contains "focus adapter: lease expiry clears a crashed nvim" \
    "expired=false" "$focus_output"
  _assert_contains "focus adapter: active terminal changes clear immediately" \
    "terminal-change=false" "$focus_output"
  _assert_contains "focus adapter: closing the active terminal clears immediately" \
    "active-close=false" "$focus_output"
  _assert_contains "focus adapter: losing VS Code window focus clears immediately" \
    "window-blur=false" "$focus_output"
  _assert_contains "focus adapter: rejects claims observed before window blur" \
    "pre-blur-claim=false" "$focus_output"
  _assert_contains "focus adapter: delayed pre-blur claims cannot resurrect context" \
    "after-pre-blur-claim=false" "$focus_output"
  _assert_contains "focus adapter: unrelated process cannot claim the active terminal" \
    "dead-pid=false" "$focus_output"
  _assert_contains "focus adapter: reports a failed VS Code context update" \
    "context-failure=true" "$focus_output"
  _assert_contains "focus adapter: one failed context update cannot poison later clears" \
    "context-recovery=false" "$focus_output"
else
  echo "  SKIP: VS Code focus runtime assertions (node unavailable)"
fi

_test_summary
