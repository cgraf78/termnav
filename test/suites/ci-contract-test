#!/usr/bin/env bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
workflow="$root/.github/workflows/test.yml"
retry_workflow="$root/.github/workflows/retry-infrastructure.yml"
lock_file="$root/.github/cgraf78-actions.lock"

fail() {
  printf 'ci-contract-test: %s\n' "$*" >&2
  exit 1
}

[[ -f "$lock_file" && ! -L "$lock_file" ]] ||
  fail "cgraf78/actions lock is missing or is not a regular file"
actions_sha=$(tr -d '\n' <"$lock_file")
if [[ ! "$actions_sha" =~ ^[0-9a-f]{40}$ ]] ||
  [[ $(wc -l <"$lock_file") -ne 1 ]]; then
  fail "cgraf78/actions lock must contain one lowercase full commit SHA"
fi

content=$(<"$workflow")
retry_content=$(<"$retry_workflow")
[[ "$content" == *'branches: [main]'* ]] ||
  fail "push CI does not target only the maintained main branch"
[[ "$content" == *'cron: "57 8 * * *"'* ]] ||
  fail "daily matrix does not retain its portfolio offset"
[[ "$content" == *"cgraf78/actions/.github/workflows/rust-ci.yml@$actions_sha"* ]] ||
  fail "Rust CI does not use the locked actions revision"
[[ "$content" == *'profiles: base,shellcheck,zsh,lua,neovim,tmux,python,openssh-netcat-lsof'* ]] ||
  fail "Rust CI does not install the integration-test profiles"
[[ "$content" == *'matrix-set: full'* ]] ||
  fail "Rust CI does not run the full pull-request platform matrix"
[[ "$content" == *'termux-profiles: base,zsh,neovim,tmux,python,openssh-netcat-lsof'* ]] ||
  fail "Termux CI does not install the full integration-test profiles"
[[ "$content" == *'termux-command: TERMNAV_TEST_BINARY=./termnav TERMNAV_SKIP_SHELLCHECK=1 test/termnav-test'* ]] ||
  fail "Termux CI does not run the packaged binary through the full suite"
[[ "$content" == *'test-command: cargo test --locked && test/termnav-test'* ]] ||
  fail "Rust CI does not run the native and integration suites together"
[[ "$retry_content" == *"cgraf78/actions/.github/actions/infra-retry@$actions_sha"* ]] ||
  fail "infrastructure retry does not use the locked actions revision"

actions_sync_job=$(awk '
  /^  actions-sync:$/ { in_sync = 1 }
  in_sync && /^  [^ ]/ && $0 != "  actions-sync:" { exit }
  in_sync { print }
' "$workflow")

for contract in \
  'name: cgraf78/actions sync' \
  'runs-on: ubuntu-24.04' \
  'contents: read' \
  'persist-credentials: false' \
  "cgraf78/actions/.github/actions/verify-consumer-sync@$actions_sha"; do
  [[ "$actions_sync_job" == *"$contract"* ]] ||
    fail "actions synchronization job is missing: $contract"
done
[[ $(printf '%s\n' "$actions_sync_job" | grep -Ec \
  '^[[:space:]]+- uses:[[:space:]]+actions/checkout@[0-9a-f]{40}([[:space:]]+#[^[:cntrl:]]*)?$') -eq 1 ]] ||
  fail "actions synchronization checkout is not pinned to a full commit"

required_job=$(awk '
  /^  required:$/ { in_required = 1 }
  in_required && /^  [^ ]/ && $0 != "  required:" { exit }
  in_required { print }
' "$workflow")

performance_job=$(awk '
  /^  relay-performance:$/ { in_performance = 1 }
  in_performance && /^  [^ ]/ && $0 != "  relay-performance:" { exit }
  in_performance { print }
' "$workflow")

performance_macos_job=$(awk '
  /^  relay-performance-macos:$/ { in_performance = 1 }
  in_performance && /^  [^ ]/ && $0 != "  relay-performance-macos:" { exit }
  in_performance { print }
' "$workflow")

# These are literal GitHub expressions in the workflow contract.
# shellcheck disable=SC2016
for contract in \
  'name: Relay hot path / Ubuntu' \
  "if: \${{ github.event_name == 'pull_request' }}" \
  'runs-on: ubuntu-24.04' \
  'fetch-depth: 0' \
  'name: Install Rust' \
  'toolchain: stable' \
  'TERMNAV_PERFORMANCE_BASELINE: ${{ github.event.pull_request.base.sha }}' \
  'TERMNAV_PERFORMANCE_BASELINE: HEAD' \
  'TERMNAV_PERFORMANCE_SAMPLES: "2"' \
  'run: test/suites/relay-performance-test'; do
  [[ "$performance_job" == *"$contract"* ]] ||
    fail "Relay performance job is missing: $contract"
done

# The macOS job protects the procfs-free ancestry path, where each avoidable
# process spawn is visible latency that Linux-only measurements would miss.
# shellcheck disable=SC2016
for contract in \
  'name: Relay hot path / macOS' \
  "if: \${{ github.event_name == 'pull_request' }}" \
  'runs-on: macos-latest' \
  'fetch-depth: 0' \
  'name: Install Rust' \
  'toolchain: stable' \
  'name: Install tmux' \
  'TERMNAV_PERFORMANCE_BASELINE: ${{ github.event.pull_request.base.sha }}' \
  'TERMNAV_PERFORMANCE_SAMPLES: "20"' \
  'run: test/suites/relay-performance-test'; do
  [[ "$performance_macos_job" == *"$contract"* ]] ||
    fail "macOS relay performance job is missing: $contract"
done

# These are literal GitHub and shell expressions in the workflow contract.
# shellcheck disable=SC2016
for contract in \
  'name: Required' \
  'if: ${{ always() }}' \
  'needs: [rust, eza-current, relay-performance, relay-performance-macos]' \
  'RUST_RESULT: ${{ needs.rust.result }}' \
  'EZA_CURRENT_RESULT: ${{ needs.eza-current.result }}' \
  'RELAY_PERFORMANCE_RESULT: ${{ needs.relay-performance.result }}' \
  'RELAY_PERFORMANCE_MACOS_RESULT: ${{ needs.relay-performance-macos.result }}' \
  'test "$RUST_RESULT" = success' \
  'test "$EZA_CURRENT_RESULT" = success' \
  'success | skipped) ;;' \
  '*) exit 1 ;;'; do
  [[ "$required_job" == *"$contract"* ]] ||
    fail "Required aggregate is missing: $contract"
done
[[ "$required_job" == *"case \"\$RELAY_PERFORMANCE_MACOS_RESULT\" in"* ]] ||
  fail "Required aggregate does not validate the macOS performance result"

printf 'ci-contract-test: ok\n'
