#!/usr/bin/env bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
workflow="$root/.github/workflows/test.yml"
retry_workflow="$root/.github/workflows/retry-infrastructure.yml"
release_workflow="$root/.github/workflows/release.yml"
lock_file="$root/.github/cgraf78-actions.lock"
performance_suite="$root/test/suites/relay-performance-test"
performance_harness="$root/test/relay-performance.py"
relay_suite="$root/test/suites/relay-test"
terminal_suite="$root/test/suites/relay-terminal-test"
focus_suite="$root/test/suites/tmux-focus-test"

fail() {
  printf 'ci-contract-test: %s\n' "$*" >&2
  exit 1
}

[[ -f "$lock_file" && ! -L "$lock_file" ]] ||
  fail "cgraf78/actions lock is missing or is not a regular file"
actions_sha=$(tr -d '\n' <"$lock_file")
if [[ ! "$actions_sha" =~ ^[0-9a-f]{40}$ ]] ||
  [[ $(wc -l <"$lock_file") -ne 1 ]]; then
  fail "cgraf78/actions lock must contain one lowercase full commit SHA"
fi

content=$(<"$workflow")
retry_content=$(<"$retry_workflow")
release_content=$(<"$release_workflow")
[[ "$content" == *'branches: [main]'* ]] ||
  fail "push CI does not target only the maintained main branch"
[[ "$content" == *'cron: "57 8 * * *"'* ]] ||
  fail "daily matrix does not retain its portfolio offset"
[[ "$content" == *"cgraf78/actions/.github/workflows/rust-ci.yml@$actions_sha"* ]] ||
  fail "Rust CI does not use the locked actions revision"
[[ "$content" == *'profiles: base,shellcheck,zsh,lua,neovim,tmux-pinned,python,openssh-netcat-lsof'* ]] ||
  fail "Rust CI does not install the integration-test profiles"
[[ "$content" == *'matrix-set: full'* ]] ||
  fail "Rust CI does not run the full pull-request platform matrix"
[[ "$content" == *'termux-profiles: base,zsh,neovim,tmux,python,openssh-netcat-lsof'* ]] ||
  fail "Termux CI does not install native tmux with the integration-test profiles"
[[ "$content" == *'termux-command: TERMNAV_REQUIRE_TMUX=1 TERMNAV_TEST_BINARY=./termnav TERMNAV_SKIP_SHELLCHECK=1 test/termnav-test'* ]] ||
  fail "Termux CI does not run the packaged binary through the full suite"
[[ "$content" == *'test-command: export TERMNAV_REQUIRE_TMUX=1 && cargo test --locked && test/termnav-test'* ]] ||
  fail "Rust CI does not run the native and integration suites together"
[[ "$retry_content" == *"cgraf78/actions/.github/actions/infra-retry@$actions_sha"* ]] ||
  fail "infrastructure retry does not use the locked actions revision"
[[ "$release_content" == *'android-aarch64: true'* ]] ||
  fail "release workflow does not publish supported Android aarch64"
[[ "$release_content" != *'android-x86_64:'* ]] ||
  fail "release workflow publishes Android x86_64 that the installer rejects"

actions_sync_job=$(awk '
  /^  actions-sync:$/ { in_sync = 1 }
  in_sync && /^  [^ ]/ && $0 != "  actions-sync:" { exit }
  in_sync { print }
' "$workflow")

for contract in \
  'name: cgraf78/actions sync' \
  'runs-on: ubuntu-24.04' \
  'contents: read' \
  'persist-credentials: false' \
  "cgraf78/actions/.github/actions/verify-consumer-sync@$actions_sha"; do
  [[ "$actions_sync_job" == *"$contract"* ]] ||
    fail "actions synchronization job is missing: $contract"
done
[[ $(printf '%s\n' "$actions_sync_job" | grep -Ec \
  '^[[:space:]]+- uses:[[:space:]]+actions/checkout@[0-9a-f]{40}([[:space:]]+#[^[:cntrl:]]*)?$') -eq 1 ]] ||
  fail "actions synchronization checkout is not pinned to a full commit"

required_job=$(awk '
  /^  required:$/ { in_required = 1 }
  in_required && /^  [^ ]/ && $0 != "  required:" { exit }
  in_required { print }
' "$workflow")

performance_job=$(awk '
  /^  relay-performance:$/ { in_performance = 1 }
  in_performance && /^  [^ ]/ && $0 != "  relay-performance:" { exit }
  in_performance { print }
' "$workflow")

performance_macos_job=$(awk '
  /^  relay-performance-macos:$/ { in_performance = 1 }
  in_performance && /^  [^ ]/ && $0 != "  relay-performance-macos:" { exit }
  in_performance { print }
' "$workflow")

vscode_job=$(awk '
  /^  vscode-adapter:$/ { in_vscode = 1 }
  in_vscode && /^  [^ ]/ && $0 != "  vscode-adapter:" { exit }
  in_vscode { print }
' "$workflow")

# These are literal GitHub expressions in the workflow contract.
# shellcheck disable=SC2016
for contract in \
  'name: Relay hot path / Ubuntu' \
  "if: \${{ github.event_name == 'pull_request' }}" \
  'runs-on: ubuntu-24.04' \
  'timeout-minutes: 20' \
  'fetch-depth: 0' \
  'name: Install Rust' \
  'toolchain: stable' \
  "cgraf78/actions/.github/actions/shell-ci-prereqs@$actions_sha" \
  'profiles: tmux-pinned' \
  'TERMNAV_PERFORMANCE_BASELINE: ${{ github.event.pull_request.base.sha }}' \
  'TERMNAV_PERFORMANCE_BASELINE: HEAD' \
  'TERMNAV_PERFORMANCE_SAMPLES: "2"' \
  'run: test/suites/relay-performance-test'; do
  [[ "$performance_job" == *"$contract"* ]] ||
    fail "Relay performance job is missing: $contract"
done

for contract in \
  'name: VS Code adapter / Ubuntu' \
  'runs-on: ubuntu-24.04' \
  'timeout-minutes: 5' \
  'node --version' \
  'test/suites/vscode-adapter-test'; do
  [[ "$vscode_job" == *"$contract"* ]] ||
    fail "required VS Code adapter job is missing: $contract"
done

# The macOS job protects the procfs-free ancestry path, where each avoidable
# process spawn is visible latency that Linux-only measurements would miss.
# shellcheck disable=SC2016
for contract in \
  'name: Relay hot path / macOS' \
  "if: \${{ github.event_name == 'pull_request' }}" \
  'runs-on: macos-latest' \
  'timeout-minutes: 20' \
  'fetch-depth: 0' \
  'name: Install Rust' \
  'toolchain: stable' \
  "cgraf78/actions/.github/actions/shell-ci-prereqs@$actions_sha" \
  'profiles: tmux-pinned' \
  'TERMNAV_PERFORMANCE_BASELINE: ${{ github.event.pull_request.base.sha }}' \
  'TERMNAV_PERFORMANCE_SAMPLES: "20"' \
  'run: test/suites/relay-performance-test'; do
  [[ "$performance_macos_job" == *"$contract"* ]] ||
    fail "macOS relay performance job is missing: $contract"
done

# These are literal GitHub and shell expressions in the workflow contract.
# shellcheck disable=SC2016
for contract in \
  'name: Required' \
  'if: ${{ always() }}' \
  'needs: [rust, tmux-floor, vscode-adapter, eza-current, image-paste, relay-performance, relay-performance-macos]' \
  'RUST_RESULT: ${{ needs.rust.result }}' \
  'TMUX_FLOOR_RESULT: ${{ needs.tmux-floor.result }}' \
  'VSCODE_ADAPTER_RESULT: ${{ needs.vscode-adapter.result }}' \
  'EZA_CURRENT_RESULT: ${{ needs.eza-current.result }}' \
  'IMAGE_PASTE_RESULT: ${{ needs.image-paste.result }}' \
  'RELAY_PERFORMANCE_RESULT: ${{ needs.relay-performance.result }}' \
  'RELAY_PERFORMANCE_MACOS_RESULT: ${{ needs.relay-performance-macos.result }}' \
  'test "$RUST_RESULT" = success' \
  'test "$TMUX_FLOOR_RESULT" = success' \
  'test "$VSCODE_ADAPTER_RESULT" = success' \
  'test "$EZA_CURRENT_RESULT" = success' \
  'test "$IMAGE_PASTE_RESULT" = success' \
  'success | skipped) ;;' \
  '*) exit 1 ;;'; do
  [[ "$required_job" == *"$contract"* ]] ||
    fail "Required aggregate is missing: $contract"
done
[[ "$required_job" == *"case \"\$RELAY_PERFORMANCE_MACOS_RESULT\" in"* ]] ||
  fail "Required aggregate does not validate the macOS performance result"

image_paste_job=$(awk '
  /^  image-paste:$/ { in_image_paste = 1 }
  in_image_paste && /^  [^ ]/ && $0 != "  image-paste:" { exit }
  in_image_paste { print }
' "$workflow")
# shellcheck disable=SC2016 # Commands are inspected as literal workflow text.
for contract in \
  "cgraf78/actions/.github/actions/shell-ci-prereqs@$actions_sha" \
  'profiles: tmux-pinned,wezterm-pinned' \
  'test -n "$CI_WEZTERM_PINNED_RELEASE"' \
  'test "$("$CI_WEZTERM_PINNED_BIN" --version)" = "wezterm $CI_WEZTERM_PINNED_VERSION"' \
  'python3 test/paste-image.py "$package/bin/termnav" --preview "$package"' \
  'python3 test/paste-image-gui.py "$package/bin/termnav" "$package"'; do
  [[ "$image_paste_job" == *"$contract"* ]] || fail "image paste CI is missing: $contract"
done
[[ "$image_paste_job" != *'tmux-builds/releases/'* ]] ||
  fail "image paste CI downloads tmux outside the shared installer"
[[ "$image_paste_job" != *'wezterm/releases/'* &&
  "$image_paste_job" != *'wezterm-builds/releases/'* ]] ||
  fail "image paste CI downloads WezTerm outside the shared installer"

tmux_floor_job=$(awk '
  /^  tmux-floor:$/ { in_floor = 1 }
  in_floor && /^  [^ ]/ && $0 != "  tmux-floor:" { exit }
  in_floor { print }
' "$workflow")
for contract in \
  'runs-on: ubuntu-24.04' \
  "cgraf78/actions/.github/actions/shell-ci-prereqs@$actions_sha" \
  'profiles: python,tmux-floor-exact' \
  'TERMNAV_REQUIRE_TMUX: "1"' \
  'run: test/termnav-test --tmux-floor-smoke'; do
  [[ "$tmux_floor_job" == *"$contract"* ]] || fail "tmux floor CI is missing: $contract"
done
# Use a mismatched floor so even a runner that lost the smoke mode exits
# before entering the full suite and invoking this contract again.
floor_status=0
floor_output=$(CI_TMUX_FLOOR=0.0 CI_TMUX_FLOOR_EXACT='' \
  "$root/test/termnav-test" --tmux-floor-smoke 2>&1) || floor_status=$?
[[ $floor_status == 1 && $floor_output == *'needs an exact CI_TMUX_FLOOR'* ]] ||
  fail 'tmux floor smoke does not reject a missing exact floor binding'

# Process-heavy integration fixtures intentionally own subprocess trees. Keep
# their outer deadline in the portable process-group wrapper so a child that
# defeats an inner protocol timeout cannot occupy a CI worker indefinitely.
grep -Fq "_with_timeout 15m python3 \"\$test_dir/relay-performance.py\"" "$performance_suite" ||
  fail "relay performance suite has no bounded outer deadline"
grep -Fq "_with_timeout 5m python3 \"\$test_dir/support/relay_lifecycle_test.py\"" "$relay_suite" ||
  fail "relay lifecycle suite has no bounded outer deadline"
grep -Fq "_with_timeout 10m python3 \"\$test_dir/support/relay-terminal.py\"" "$terminal_suite" ||
  fail "relay terminal suite has no bounded outer deadline"
grep -Fq "_with_timeout 10m python3 \"\$test_dir/support/tmux-focus.py\"" "$focus_suite" ||
  fail "tmux focus suite has no bounded outer deadline"

performance_content=$(<"$performance_harness")
for contract in \
  '"baseline_median_ms": tmux_before_median' \
  '"candidate_median_ms": tmux_after_median' \
  'if tmux_after_median > 75:' \
  'if tmux_after_p95 > 100:' \
  'if tmux_after_median > tmux_before_median * 1.20 + 5:' \
  'navigation tmux route did not select'; do
  [[ "$performance_content" == *"$contract"* ]] ||
    fail "local tmux performance contract is missing: $contract"
done

printf 'ci-contract-test: ok\n'
