#!/usr/bin/env bash
# test-isolation-test — proves integration tests cannot reach live terminal state.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

# Deliberately seed values that would route native Termnav calls into the
# developer's real tmux and Neovim sessions if the shared harness leaked them.
export HOME=/termnav-live-home-sentinel
export XDG_STATE_HOME=/termnav-live-state-sentinel
export TMUX=/tmp/termnav-live-tmux-sentinel,1,0
export TMUX_PANE=%999
export NVIM=/tmp/termnav-live-nvim-sentinel
export SSH_CONNECTION='192.0.2.1 1 192.0.2.2 22'
export BROWSER=/termnav-live-browser-sentinel
export DISPLAY=:99
export WAYLAND_DISPLAY=wayland-99

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

_process_running() {
  local pid=$1 stat state

  # `kill -0` also succeeds for a zombie. Minimal container PID 1 processes
  # do not consistently reap orphaned fixture grandchildren promptly, so an
  # existence-only probe makes the cleanup assertion depend on the CI image.
  # The contract under test is that no descendant can still execute or retain
  # IO after its owned process group is killed; a zombie has already met it.
  if [[ -r /proc/$pid/stat ]]; then
    stat=$(<"/proc/$pid/stat") || return 1
    stat=${stat##*) }
    state=${stat%% *}
    [[ $state != Z ]]
    return
  fi

  # macOS has no procfs. Its BSD `ps` exposes the same state field, while the
  # final signal probe preserves compatibility with an unusual ps lacking it.
  if state=$(ps -o stat= -p "$pid" 2>/dev/null); then
    state=${state#"${state%%[![:space:]]*}"}
    [[ -n $state && $state != Z* ]]
    return
  fi
  kill -0 "$pid" 2>/dev/null
}

case "$HOME" in
  "$_TEST_TMP_ROOT"/*) _pass "test isolation: HOME is invocation-owned" ;;
  *) _fail "test isolation: HOME escaped the invocation root ($HOME)" ;;
esac
case "$XDG_STATE_HOME" in
  "$_TEST_TMP_ROOT"/*) _pass "test isolation: XDG state is invocation-owned" ;;
  *) _fail "test isolation: XDG state escaped the invocation root ($XDG_STATE_HOME)" ;;
esac

for variable in TMUX TMUX_PANE NVIM SSH_CONNECTION DISPLAY WAYLAND_DISPLAY; do
  if [[ -v $variable ]]; then
    _fail "test isolation: $variable leaked into a suite"
  else
    _pass "test isolation: $variable is cleared"
  fi
done

_assert_eq "test isolation: URL fallbacks reach a failing opener, not a browser" \
  false "${BROWSER-unset}"

tool_fixture=$(_tmpdir)
mkdir "$tool_fixture/candidate:dir" "$tool_fixture/ambient" "$tool_fixture/tmp:dir"
mkdir "$tool_fixture/mktemp-bin" "$tool_fixture/-nested-tmp" "$tool_fixture/platform-tmp"
printf '#!/bin/sh\nprintf "selected fixture\\n"\n' >"$tool_fixture/candidate:dir/selected"
printf '#!/bin/sh\nprintf "ambient fixture\\n"\n' >"$tool_fixture/ambient/termnav"
chmod +x "$tool_fixture/candidate:dir/selected" "$tool_fixture/ambient/termnav"
# Darwin chooses its per-user temp root for a template-less mktemp. Model
# that default here so the nested-directory contract is exercised on Linux.
cat >"$tool_fixture/mktemp-bin/mktemp" <<'EOF'
#!/usr/bin/env bash
if [[ $# -eq 1 && $1 == -d ]]; then
  exec "$FIXTURE_MKTEMP" -d "$FIXTURE_PLATFORM_TMP/tmp.XXXXXXXXXX"
fi
exec "$FIXTURE_MKTEMP" "$@"
EOF
chmod +x "$tool_fixture/mktemp-bin/mktemp"
fixture_mktemp=$(type -P mktemp) || exit 1
# The child shell expands its own positional parameters.
# shellcheck disable=SC2016
tool_output=$(env -u BASH_ENV -u ENV PATH="$tool_fixture/mktemp-bin:$tool_fixture/ambient:$PATH" \
  FIXTURE_MKTEMP="$fixture_mktemp" FIXTURE_PLATFORM_TMP="$tool_fixture/platform-tmp" \
  TMPDIR=-nested-tmp \
  TERMNAV_TEST_BINARY="./candidate:dir/selected" "$BASH" -c '
    cd -- "$1" && . "$2" || exit 1
    binary=$(type -P termnav) || exit 1
    binary_dir=$(CDPATH="" cd -P -- "${binary%/*}" && pwd -P) || exit 1
    caller_tmp=$(CDPATH="" cd -P -- "$3" && pwd -P) || exit 1
    case "$binary_dir" in
      "$caller_tmp"/*) "$binary" ;;
      *) printf "adapter directory escaped nested TMPDIR: %s\n" "$binary_dir" >&2; exit 2 ;;
    esac
  ' bash "$tool_fixture" "$TERMNAV_TEST_DIR/helpers.sh" "$tool_fixture/-nested-tmp")
_assert_exit "test isolation: a renamed relative binary is available as termnav" 0 "$?"
_assert_eq "test isolation: name lookup uses the selected binary, even with a colon in its path" \
  "selected fixture" "$tool_output"

mkdir "$tool_fixture/editor"
cp "$tool_fixture/candidate:dir/selected" "$tool_fixture/ambient/selected"
cp "$tool_fixture/ambient/termnav" "$tool_fixture/editor/selected"
# Resolve the bare test override from caller PATH, before adding editor tools.
# shellcheck disable=SC2016
tool_output=$(env -u BASH_ENV -u ENV PATH="$tool_fixture/ambient:$PATH" \
  TERMNAV_TEST_NVIM_BINARY="$tool_fixture/editor/nvim" TERMNAV_TEST_BINARY=selected \
  "$BASH" -c '. "$1" && "$TERMNAV_TEST_BINARY"' bash "$TERMNAV_TEST_DIR/helpers.sh")
_assert_exit "test isolation: a bare binary override resolves successfully" 0 "$?"
_assert_eq "test isolation: editor tools cannot replace a bare override" "selected fixture" "$tool_output"

tool_status=0
# shellcheck disable=SC2016 # The child shell sets its own positional parameters.
tool_output=$(TMPDIR="$tool_fixture/tmp:dir" "$BASH" -c '. "$1"; echo setup-continued' \
  bash "$TERMNAV_TEST_DIR/helpers.sh" 2>&1) || tool_status=$?
_assert_exit "test isolation: fixture setup rejects an unrepresentable TMPDIR" 1 "$tool_status"
_assert_contains "test isolation: TMPDIR diagnostic explains the restriction" \
  'TMPDIR must not contain a colon' "$tool_output"

if command -v nvim >/dev/null 2>&1 && nvim --version >/dev/null 2>&1; then
  nvim_fixture_dir=$(_tmpdir)
  nvim_fixture=$nvim_fixture_dir/runner.lua
  cat >"$nvim_fixture" <<'LUA'
if arg[1] == "fail" then
  error({kind = "non-string"})
end
print(arg[1], arg[2])
LUA

  set +e
  nvim_output=$(_run_nvim_lua "$nvim_fixture" "left value" "right:value" 2>&1)
  nvim_status=$?
  set -e
  _assert_exit "test isolation: Neovim Lua runner returns success" 0 "$nvim_status"
  _assert_eq "test isolation: Neovim Lua runner preserves arguments and output" \
    $'left value\tright:value' "$nvim_output"

  set +e
  nvim_output=$(_run_nvim_lua "$nvim_fixture" fail 2>&1)
  nvim_status=$?
  set -e
  if [[ $nvim_status -eq 0 || $nvim_status -eq 124 ]]; then
    _fail "test isolation: Neovim Lua runner reports non-string errors promptly"
  else
    _pass "test isolation: Neovim Lua runner reports non-string errors promptly"
  fi
  _assert_contains "test isolation: Neovim Lua runner renders non-string errors" \
    "table:" "$nvim_output"
else
  _test_style dim "  - skipping Neovim Lua runner checks (nvim unavailable)"
fi

timeout_fixture=$(_tmpdir)
timeout_leader_pid=$timeout_fixture/leader.pid
timeout_child_pid=$timeout_fixture/child.pid
test_shell=$(command -v sh)
test_sleep=$(command -v sleep)
set +e
(
  # The leader deliberately exits when TERM arrives while its forked child
  # ignores TERM. Waiting only for the leader therefore leaks the exact process
  # class that an outer suite deadline is supposed to contain.
  # shellcheck disable=SC2016
  _with_timeout 1s "$test_shell" -c '
    trap "exit 0" TERM
    "$3" -c '\''trap "" TERM; exec "$1" 60'\'' sh "$4" &
    child=$!
    printf "%s\n" "$$" >"$1"
    printf "%s\n" "$child" >"$2"
    wait "$child"
  ' sh "$timeout_leader_pid" "$timeout_child_pid" "$test_shell" "$test_sleep"
) &
timeout_runner=$!
deadline=$((SECONDS + 5))
while kill -0 "$timeout_runner" 2>/dev/null && ((SECONDS < deadline)); do
  sleep 0.02
done
if kill -0 "$timeout_runner" 2>/dev/null; then
  # This watchdog exists only to make a broken timeout regression fail quickly
  # instead of reproducing the same unbounded CI hang that the helper prevents.
  [[ -s $timeout_leader_pid ]] && kill -KILL -- "-$(cat "$timeout_leader_pid")" 2>/dev/null
  kill -KILL "$timeout_runner" 2>/dev/null
  wait "$timeout_runner" 2>/dev/null
  timeout_status=255
else
  wait "$timeout_runner"
  timeout_status=$?
fi
set -e
_assert_exit "test isolation: timeout returns its stable deadline status" 124 "$timeout_status"
if [[ ! -s $timeout_leader_pid || ! -s $timeout_child_pid ]]; then
  _fail "test isolation: timeout did not start both owned fixture processes"
elif _process_running "$(cat "$timeout_child_pid")"; then
  _fail "test isolation: timeout left a stubborn descendant running"
  if [[ -s $timeout_leader_pid ]]; then
    kill -KILL -- "-$(cat "$timeout_leader_pid")" 2>/dev/null || true
  fi
else
  _pass "test isolation: timeout cleans up the complete fixture process group"
fi

run_timeout_model() (
  local real_python
  real_python=$(command -v python3) || exit
  # shellcheck disable=SC2329 # Indirectly invoked by _with_timeout.
  python3() {
    # The supervisor sends its Python body on stdin after a leading '-'.
    shift
    "$real_python" "$TERMNAV_TEST_DIR/support/timeout-model.py" "$@"
  }
  _with_timeout 1s "$1"
)

model_status=0
model_output=$(run_timeout_model completed-wait 2>&1) || model_status=$?
_assert_exit "test isolation: completion wins a signal during leader reaping" 7 "$model_status"
_assert_not_contains "test isolation: cancellation never signals a reaped group" \
  "signalled a group after its leader was reaped" "$model_output"

model_status=0
model_output=$(run_timeout_model owned-group 2>&1) || model_status=$?
_assert_exit "test isolation: timeout retains its group ID up to escalation" 124 "$model_status"
_assert_contains "test isolation: timeout signals its owned group before reaping" \
  "attempted final signal to owned group" "$model_output"

model_status=0
model_output=$(run_timeout_model zombie-only 2>&1) || model_status=$?
_assert_exit "test isolation: Darwin zombie-only group reaches normal timeout status" \
  124 "$model_status"
_assert_not_contains "test isolation: Darwin zombie-only cleanup has no traceback" \
  "Traceback" "$model_output"

model_status=0
model_output=$(run_timeout_model live-denial 2>&1) || model_status=$?
_assert_exit "test isolation: denied Darwin signal to a live group fails cleanup" \
  1 "$model_status"
_assert_contains "test isolation: checks the denial after final escalation" \
  "attempted final signal to owned group" "$model_output"
_assert_contains "test isolation: preserves a genuine Darwin permission error" \
  "PermissionError: group has no authority for requested signal" "$model_output"

# Blocking terminal signals around fork closes the supervisor's ownership race,
# but that mask must be restored in the command before exec. Otherwise every
# process in a wrapped suite silently inherits blocked INT/TERM and lifecycle
# assertions test a different signal contract than production.
set +e
_with_timeout 2s python3 -c '
import signal
import sys

blocked = signal.pthread_sigmask(signal.SIG_BLOCK, set())
raise SystemExit(1 if signal.SIGINT in blocked or signal.SIGTERM in blocked else 0)
'
signal_mask_status=$?
set -e
_assert_exit "test isolation: child inherits an unblocked terminal signal mask" 0 "$signal_mask_status"

# Signals delivered to the Python supervisor are another cancellation boundary.
# The wrapper must tear down the owned command group before reporting the
# conventional 128+signal status, even when both child generations ignore it.
signal_fixture=$(_tmpdir)
signal_supervisor_pid=$signal_fixture/supervisor.pid
signal_leader_pid=$signal_fixture/leader.pid
signal_child_pid=$signal_fixture/child.pid
set +e
(
  # shellcheck disable=SC2016
  _with_timeout 60s "$test_shell" -c '
    trap "" INT TERM
    "$4" -c '\''trap "" INT TERM; exec "$1" 60'\'' sh "$5" &
    child=$!
    printf "%s\n" "$PPID" >"$1"
    printf "%s\n" "$$" >"$2"
    printf "%s\n" "$child" >"$3"
    wait "$child"
  ' sh "$signal_supervisor_pid" "$signal_leader_pid" "$signal_child_pid" "$test_shell" "$test_sleep"
) &
signal_runner=$!
deadline=$((SECONDS + 3))
while [[ ! -s $signal_child_pid || ! -s $signal_supervisor_pid ]] && ((SECONDS < deadline)); do
  sleep 0.02
done
if [[ -s $signal_supervisor_pid ]]; then
  kill -TERM "$(cat "$signal_supervisor_pid")" 2>/dev/null
fi
deadline=$((SECONDS + 3))
while kill -0 "$signal_runner" 2>/dev/null && ((SECONDS < deadline)); do
  sleep 0.02
done
if kill -0 "$signal_runner" 2>/dev/null; then
  [[ -s $signal_leader_pid ]] && kill -KILL -- "-$(cat "$signal_leader_pid")" 2>/dev/null
  kill -KILL "$signal_runner" 2>/dev/null
  wait "$signal_runner" 2>/dev/null
  signal_status=255
else
  wait "$signal_runner"
  signal_status=$?
fi
set -e
_assert_exit "test isolation: TERM returns the conventional signal status" 143 "$signal_status"
if [[ ! -s $signal_leader_pid || ! -s $signal_child_pid ]]; then
  _fail "test isolation: cancellation did not start both owned fixture processes"
elif _process_running "$(cat "$signal_child_pid")"; then
  _fail "test isolation: interrupted timeout supervisor left a descendant running"
  if [[ -s $signal_leader_pid ]]; then
    kill -KILL -- "-$(cat "$signal_leader_pid")" 2>/dev/null || true
  fi
else
  _pass "test isolation: interrupted timeout supervisor cleans up its process group"
fi

# test/termnav-test runs every suite, so it must not source helpers.sh: the
# suites' temporary roots would nest under its own, and its HOME, XDG and
# TMPDIR overrides and EXIT trap would reach them. It sources only the tmux
# version rule, which must define functions and do nothing else.
runner_sources=$(grep -E '^[[:space:]]*(\.|source)[[:space:]]' "$TERMNAV_TEST_DIR/termnav-test")
# shellcheck disable=SC2016 # The runner's own source line, verbatim.
_assert_eq "test isolation: the runner sources only the tmux version rule" \
  '. "$test_dir/tmux-version.sh"' "$(printf '%s\n' "$runner_sources" | sed 's/^[[:space:]]*//')"
# shellcheck disable=SC2016 # The inner script expands its own variables.
rule_effects=$(
  env -i PATH="$PATH" HOME=/rule-home TMPDIR=/rule-tmp bash --norc --noprofile -c '
    state() { trap -p; export -p; compgen -v | grep -Evx "BASH_.*|FUNCNAME|_|PIPESTATUS|LINENO|SECONDS|RANDOM|SRANDOM|EPOCH.*|BASHPID|before|after"; }
    before=$(state)
    . "$1"
    after=$(state)
    [[ $before == "$after" ]] || diff <(printf "%s\n" "$before") <(printf "%s\n" "$after")
    declare -F | grep -c " _tmux_usable$"
  ' rule "$TERMNAV_TEST_DIR/tmux-version.sh" 2>&1
)
_assert_eq "test isolation: the tmux version rule only defines functions" 1 "$rule_effects"

_test_summary
