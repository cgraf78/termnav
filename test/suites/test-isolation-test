#!/usr/bin/env bash
# test-isolation-test — proves integration tests cannot reach live terminal state.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

# Deliberately seed values that would route native Termnav calls into the
# developer's real tmux and Neovim sessions if the shared harness leaked them.
export HOME=/termnav-live-home-sentinel
export XDG_STATE_HOME=/termnav-live-state-sentinel
export TMUX=/tmp/termnav-live-tmux-sentinel,1,0
export TMUX_PANE=%999
export NVIM=/tmp/termnav-live-nvim-sentinel
export SSH_CONNECTION='192.0.2.1 1 192.0.2.2 22'

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

case "$HOME" in
  "$_TEST_TMP_ROOT"/*) _pass "test isolation: HOME is invocation-owned" ;;
  *) _fail "test isolation: HOME escaped the invocation root ($HOME)" ;;
esac
case "$XDG_STATE_HOME" in
  "$_TEST_TMP_ROOT"/*) _pass "test isolation: XDG state is invocation-owned" ;;
  *) _fail "test isolation: XDG state escaped the invocation root ($XDG_STATE_HOME)" ;;
esac

for variable in TMUX TMUX_PANE NVIM SSH_CONNECTION; do
  if [[ -v $variable ]]; then
    _fail "test isolation: $variable leaked into a suite"
  else
    _pass "test isolation: $variable is cleared"
  fi
done

timeout_fixture=$(_tmpdir)
timeout_child_pid=$timeout_fixture/child.pid
test_shell=$(command -v sh)
test_sleep=$(command -v sleep)
set +e
(
  # The single-quoted body is interpreted by the child shell, where $1, $2,
  # and $$ deliberately refer to that isolated fixture process.
  # shellcheck disable=SC2016
  _with_timeout 0.1s "$test_shell" -c '
    trap "" TERM
    printf "%s\n" "$$" >"$1"
    exec "$2" 60
  ' sh "$timeout_child_pid" "$test_sleep"
) &
timeout_runner=$!
deadline=$((SECONDS + 3))
while kill -0 "$timeout_runner" 2>/dev/null && ((SECONDS < deadline)); do
  sleep 0.02
done
if kill -0 "$timeout_runner" 2>/dev/null; then
  # This watchdog exists only to make a broken timeout regression fail quickly
  # instead of reproducing the same unbounded CI hang that the helper prevents.
  [[ -s $timeout_child_pid ]] && kill -KILL "$(cat "$timeout_child_pid")" 2>/dev/null
  kill -KILL "$timeout_runner" 2>/dev/null
  wait "$timeout_runner" 2>/dev/null
  timeout_status=255
else
  wait "$timeout_runner"
  timeout_status=$?
fi
set -e
_assert_exit "test isolation: timeout returns its stable deadline status" 124 "$timeout_status"
if [[ -s $timeout_child_pid ]] && kill -0 "$(cat "$timeout_child_pid")" 2>/dev/null; then
  _fail "test isolation: timeout left a stubborn descendant running"
  kill -KILL "$(cat "$timeout_child_pid")" 2>/dev/null || true
else
  _pass "test isolation: timeout cleans up the complete fixture process group"
fi

_test_summary
