#!/usr/bin/env bash
# install-test - Termnav policy layered on the shared release installer.

set -euo pipefail
export NO_COLOR=1

test_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
root="${test_dir%/test}"
# shellcheck source=test/helpers.sh
. "$test_dir/helpers.sh"

installer="$root/install.sh"
config="$root/scripts/release.conf"

_assert_file_exists "installer: generated release installer is present" "$installer"
_assert_eq "installer: identifies the shared release generator" \
  "# Generated by cgraf78/actions release-installer. Do not edit." \
  "$(sed -n '2p' "$installer")"
_assert_file_exists "installer: release policy is present" "$config"
_assert_file_exists "installer: unified manual page is present" \
  "$root/man/man1/termnav.1"

help=$(/bin/bash "$installer" --help)
_assert_contains "installer: help names the release repository" \
  "cgraf78/termnav" "$help"

installer_source=$(cat "$installer")
_assert_not_contains "installer: publishes no compatibility aliases" \
  "release_binary_aliases" "$installer_source"

for retired_alias in \
  nvim-link-host \
  eza-nvim-links \
  nvim-ssh-control-open \
  nvim-tmux-open \
  termnav-navigate \
  termnav-relay \
  termnav-tmux-context \
  termnav-tmux-focus \
  tmux-follow-click \
  vscode-nvim-focus; do
  _assert_not_contains "installer: omits retired alias $retired_alias" \
    "$retired_alias" "$installer_source"
done

_assert_not_contains "installer: checkout bootstrap is retired" \
  "checkout-backed" "$installer_source"
_assert_eq "installer: release path needs no checkout-specific installer" false \
  "$([[ -e "$root/support/install-checkout.sh" || -L "$root/support/install-checkout.sh" ]] && echo true || echo false)"

_test_summary
