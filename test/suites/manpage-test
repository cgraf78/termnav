#!/usr/bin/env bash
# Verify that the PATH-visible termnav helpers have manual pages.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_REPO_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

echo "=== termnav: manpages ==="

termnav_page=$(cat "$TERMNAV_REPO_ROOT/man/man1/termnav.1")
for section in SYNOPSIS "COMMAND SYNTAX" ENVIRONMENT "EXIT STATUS" "WEZTERM PROTOCOL"; do
  _assert_contains "manpage documents $section" ".SH $section" "$termnav_page"
done
for contract in asset-path TERMNAV_REMOTE_TOOL_PATH TERMNAV_VSCODE_MCP_TOKEN_FILE \
  TERMNAV_TAB_SELECT TERMNAV_OPEN_URL; do
  _assert_contains "manpage documents public contract: $contract" "$contract" "$termnav_page"
done
_assert_not_contains "manpage does not document a zero-argument integration mode" \
  "With no arguments" "$termnav_page"

while IFS= read -r command; do
  page="$TERMNAV_REPO_ROOT/man/man1/$command.1"
  _assert_file_exists "manpage exists: $command" "$page"
  content=$(cat "$page")
  _assert_contains "manpage NAME section: $command" ".SH NAME" "$content"
  _assert_contains "manpage names command: $command" "$command \\" "$content"
done < <(
  for source in "$TERMNAV_REPO_ROOT"/bin/*; do
    [[ -f "$source" && -x "$source" ]] || continue
    basename "$source"
  done | LC_ALL=C sort
)

_test_summary
