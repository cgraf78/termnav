#!/usr/bin/env bash
# paste-image-test - WezTerm paste-image module decisions and the receiver
# through real private tmux servers.

set -uo pipefail
export NO_COLOR=1

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"
# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"
termnav=${TERMNAV_TEST_BINARY:-$root/target/release/termnav}
module="$root/lib/termnav/wezterm/paste-image.lua"
routes="$root/lib/termnav/wezterm/link-routes.lua"

_run_lua() {
  if command -v lua >/dev/null 2>&1; then
    lua "$@"
    return
  fi
  if command -v nvim >/dev/null 2>&1; then
    _run_nvim_lua "$@" 2>&1
    return
  fi
  return 127
}

echo "=== paste-image: WezTerm module ==="

module_test=$(_tmpdir)/paste-image-test.lua
cat >"$module_test" <<'EOF'
local module_path, routes_path, scratch = arg[1], arg[2], arg[3]

local now = 0
local timers = {}
local children = {}
local child_result = { true, "", "" }
local actions = {}
local wezterm = {
  action = {
    PasteFrom = function(source)
      return { kind = "paste", source = source }
    end,
  },
  action_callback = function(callback)
    return { callback = callback }
  end,
  run_child_process = function(argv)
    table.insert(children, argv)
    return child_result[1], child_result[2], child_result[3]
  end,
  time = {
    call_after = function(delay, callback)
      table.insert(timers, { at = now + delay, callback = callback })
    end,
  },
}

local function check(name, ok)
  if not ok then
    error(name, 0)
  end
end

-- Run due timers in time order, advancing the virtual clock.
local function run_until(limit)
  while true do
    local index
    for i, timer in ipairs(timers) do
      if timer.at <= limit and (not index or timer.at < timers[index].at) then
        index = i
      end
    end
    if not index then
      break
    end
    local timer = table.remove(timers, index)
    now = math.max(now, timer.at)
    timer.callback()
  end
  now = math.max(now, limit)
end

local owner = "tmux"
local routes = {
  terminal_owner = function()
    return owner
  end,
  pane_id = function(pane)
    return pane.id
  end,
  helper_command = function(name)
    return "/opt/termnav/bin/" .. name
  end,
}

local function new_pane(id)
  local pane = { id = id, sent = {} }
  function pane:send_text(text)
    table.insert(self.sent, text)
  end
  return pane
end

local window = {}
function window:perform_action(action, pane)
  table.insert(actions, { action = action, pane = pane, timers = #timers, children = #children })
end

local removed = {}
local paste_image = dofile(module_path)
local paster = paste_image.new(wezterm, {
  routes = routes,
  clock = function()
    return now
  end,
  remove = function(path)
    table.insert(removed, path)
    return os.remove(path)
  end,
})

local counter = 0
local function staged_file(content)
  counter = counter + 1
  local path = scratch .. "/staged-" .. counter .. ".b64"
  local file = assert(io.open(path, "wb"))
  file:write(content)
  file:close()
  return path
end

local function exists(path)
  local file = io.open(path, "rb")
  if file then
    file:close()
    return true
  end
  return false
end

local function joined(pane)
  return table.concat(pane.sent)
end

local function press(pane, path)
  child_result = { path ~= nil, path and (path .. "\n") or "", "" }
  local action = paster:paste_action()
  action.callback(window, pane)
end

check("module exposes the protocol names", paste_image.user_var == "TERMNAV_PASTE_IMAGE"
  and paste_image.trigger == "\27[777010u")

-- REQ-002: text paste happens first and alone outside tmux.
for _, other in ipairs({ "terminal", "nvim" }) do
  owner = other
  actions, timers, children = {}, {}, {}
  local pane = new_pane("p0")
  press(pane, staged_file("unused"))
  check(other .. ": pastes text", #actions == 1 and actions[1].action.kind == "paste"
    and actions[1].action.source == "Clipboard")
  check(other .. ": schedules nothing", #timers == 0 and #children == 0)
  run_until(60)
  check(other .. ": sends nothing", #pane.sent == 0)
end
owner = "tmux"

-- Staging runs from a scheduled callback, never on the key path.
actions, timers, children = {}, {}, {}
local pane = new_pane("p1")
local staged = "12:" .. string.rep("a", 64) .. ":iVBORw0KGgoAAAAA"
local path = staged_file(staged)
press(pane, path)
check("tmux: text paste runs before any probe", #actions == 1 and actions[1].timers == 0
  and actions[1].children == 0)
check("tmux: stage is deferred", #children == 0 and #timers == 1 and timers[1].at == now)
run_until(now)
check("tmux: runs termnav paste-image stage", #children == 1 and children[1][1] == "/opt/termnav/bin/termnav"
  and children[1][2] == "paste-image" and children[1][3] == "stage")
check("tmux: sends the trigger after staging", joined(pane) == "\27[777010u")

-- REQ-003: wrong pane, then a ready that starts nothing synchronously.
local function header_of(id, content)
  return id .. ":" .. content:match("^(%d+:[0-9a-f]+:)")
end
local function proof_of(content)
  return content:match("^%d+:([0-9a-f]+):"):sub(1, 16)
end
local function ack(target, id, offset, proof)
  local value = "ack:" .. id .. ":" .. offset .. (proof and (":" .. proof) or "")
  paster:user_var_changed(window, target, "TERMNAV_PASTE_IMAGE", value)
end

local other_pane = new_pane("p2")
check("handles its variable", paster:user_var_changed(window, other_pane, "TERMNAV_PASTE_IMAGE", "ready:0123456789abcdef"))
run_until(now)
check("other pane's ready sends nothing", #other_pane.sent == 0 and #pane.sent == 1)
check("ignores other variables", paster:user_var_changed(window, pane, "TERMNAV_OPEN_URL", "x") == false)
local id = "00112233aabbccdd"
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
check("ready sends nothing synchronously", #pane.sent == 1)
run_until(now + 1)
local header = header_of(id, staged)
check("only the header is typed before a proven acknowledgement", joined(pane) == "\27[777010u" .. header)
ack(pane, id, #header)
run_until(now)
check("unproven acknowledgement opens nothing", joined(pane) == "\27[777010u" .. header)
ack(pane, id, #header, "0123456789abcdef")
run_until(now)
check("wrong proof opens nothing", joined(pane) == "\27[777010u" .. header)
ack(pane, id, #header, proof_of(staged))
run_until(now)
check("proven acknowledgement sends the rest with terminator", joined(pane) == "\27[777010u" .. id .. ":" .. staged .. "!")
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:ffffffffffffffff")
run_until(now)
check("repeated ready sends nothing", joined(pane) == "\27[777010u" .. id .. ":" .. staged .. "!")
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "done:" .. id)
check("done deletes the staged file", not exists(path))

-- Flow control on a multi-window payload.
local body = {}
for i = 1, 1500 * 1024 / 64 do
  body[i] = string.rep(string.char(65 + i % 26), 64)
end
staged = "1100000:" .. string.rep("b", 64) .. ":" .. table.concat(body)
local proof = proof_of(staged)
path = staged_file(staged)
pane = new_pane("p3")
press(pane, path)
run_until(now)
pane.sent = {}
id = "aaaaaaaabbbbbbbb"
header = header_of(id, staged)
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
run_until(now + 1)
check("header alone before the first acknowledgement", joined(pane) == header)
ack(pane, id, 99999999, proof)
run_until(now)
check("acknowledgement beyond what was sent is ignored", joined(pane) == header)
ack(other_pane, id, #header, proof)
run_until(now)
check("acknowledgement from another pane is ignored", joined(pane) == header)
ack(pane, id, #header, proof)
local calls = #pane.sent
run_until(now)
check("proven acknowledgement opens a 512 KiB window", #joined(pane) == #header + 512 * 1024)
check("window is filled over several timer callbacks", #pane.sent - calls >= 16)
for _, chunk in ipairs(pane.sent) do
  check("chunks are bounded", #chunk <= 32 * 1024)
end
local offset = #header
while true do
  local total = #joined(pane)
  if total >= #id + 1 + #staged + 1 then
    break
  end
  offset = math.min(total, offset + 128 * 1024)
  ack(pane, id, offset, proof)
  run_until(now + 1)
end
check("whole stream is id, staged text, terminator", joined(pane) == id .. ":" .. staged .. "!")
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "done:" .. id)
check("done deletes the large staged file", not exists(path))

-- Cancel mid-stream ends the receiver's drain and cleans up.
path = staged_file(staged)
pane = new_pane("p4")
press(pane, path)
run_until(now)
pane.sent = {}
id = "cccccccc11111111"
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
run_until(now)
ack(pane, id, #header_of(id, staged), proof)
run_until(now)
local before = #joined(pane)
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "cancel:" .. id)
check("cancel mid-stream sends the terminator", pane.sent[#pane.sent] == "!" and #joined(pane) == before + 1)
check("cancel deletes the staged file", not exists(path))
run_until(now + 30)
check("cancel stops sending", #joined(pane) == before + 1)

-- A receiver rejecting a transfer under another id (a forged ready won the
-- race) still ends this pane's transfer; another pane's cancel does not.
path = staged_file(staged)
pane = new_pane("p4b")
press(pane, path)
run_until(now)
pane.sent = {}
id = "cccccccc22222222"
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
run_until(now)
paster:user_var_changed(window, other_pane, "TERMNAV_PASTE_IMAGE", "cancel:9999999999999999")
check("another pane's cancel is ignored", exists(path) and joined(pane) == header_of(id, staged))
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "cancel:9999999999999999")
check("foreign-id cancel from this pane sends the terminator", joined(pane) == header_of(id, staged) .. "!")
check("foreign-id cancel deletes the staged file", not exists(path))

-- No acknowledgement within 5 s abandons the transfer.
path = staged_file(staged)
pane = new_pane("p5")
press(pane, path)
run_until(now)
pane.sent = {}
id = "dddddddd22222222"
header = header_of(id, staged)
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
run_until(now + 4.9)
check("still waiting before 5 s", joined(pane) == header and exists(path))
run_until(now + 0.2)
check("abandons with a terminator after 5 s", joined(pane) == header .. "!")
check("abandonment deletes the staged file", not exists(path))

-- An arm expires after 10 s and deletes its file.
path = staged_file(staged)
pane = new_pane("p6")
press(pane, path)
run_until(now)
pane.sent = {}
run_until(now + 10)
check("expiry deletes the staged file", not exists(path))
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:eeeeeeee33333333")
run_until(now + 1)
check("expired arm sends nothing", #pane.sent == 0)

-- A failed stage (status 3) arms nothing.
pane = new_pane("p7")
press(pane, nil)
run_until(now)
check("declined stage sends no trigger", #pane.sent == 0)
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:eeeeeeee44444444")
run_until(now + 1)
check("declined stage answers no ready", #pane.sent == 0)

-- A second Ctrl-V replaces the first arm.
local first = staged_file(staged)
pane = new_pane("p8")
press(pane, first)
run_until(now)
local second = staged_file(staged)
press(pane, second)
run_until(now)
check("re-arming deletes the previous staged file", not exists(first) and exists(second))
run_until(now + 10)

-- Staged content outside the transfer alphabet is never typed.
path = staged_file("12:" .. string.rep("a", 64) .. ":AAAA\27[201~")
pane = new_pane("p9")
press(pane, path)
run_until(now)
pane.sent = {}
id = "ffffffff55555555"
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:" .. id)
run_until(now + 1)
ack(pane, id, #joined(pane), string.rep("a", 16))
run_until(now + 1)
check("control bytes are never sent", not joined(pane):find("\27", 1, true))
check("tampered file is deleted", not exists(path))
path = staged_file("12:not-a-digest:AAAA")
pane = new_pane("p10")
press(pane, path)
run_until(now)
pane.sent = {}
paster:user_var_changed(window, pane, "TERMNAV_PASTE_IMAGE", "ready:ffffffff66666666")
run_until(now + 1)
check("malformed staged header types only the terminator", joined(pane) == "!")
check("malformed staged file is deleted", not exists(path))

-- Without opts.routes the module shares link-routes from its own directory.
local loaded = paste_image.new(wezterm, {})
check("loads sibling link routes", type(loaded.paste_action) == "function")
print("ok")
EOF
lua_scratch=$(_tmpdir)
module_output=$(_run_lua "$module_test" "$module" "$routes" "$lua_scratch" 2>&1)
module_rc=$?
if [[ $module_rc == 127 ]]; then
  echo "  SKIP: paste-image module test requires lua or nvim"
else
  _assert_eq "paste-image module: gesture, handshake, flow control, cleanup" "ok" "$module_output"
fi

# The Lua and Rust endpoints cannot share code; pin the shared vocabulary.
protocol_source=$(cat "$root/src/paste_image/mod.rs")
_assert_contains "paste-image protocol: Rust user variable matches the module" \
  'pub const USER_VAR: &str = "TERMNAV_PASTE_IMAGE";' "$protocol_source"
_assert_contains "paste-image protocol: Rust trigger matches the module" \
  'pub const TRIGGER: &str = "\u{1b}[777010u";' "$protocol_source"

echo
echo "=== paste-image: receiver through private tmux ==="
if ! command -v tmux >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
  echo "  SKIP: receiver tests require tmux and python3"
else
  receiver_output=$(_with_timeout 5m python3 "$test_dir/paste-image.py" "$termnav" 2>&1)
  receiver_rc=$?
  printf '%s\n' "$receiver_output"
  _assert_exit "paste-image receiver: private tmux scenarios pass" 0 "$receiver_rc"
  _assert_not_contains "paste-image receiver: no failed scenario" "FAIL:" "$receiver_output"
fi

_test_summary
