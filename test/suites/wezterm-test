    "foo.cpp",
    "v1.2.3",
]

for text, expected in positives.items():
    actual = custom_matches(text)
    if actual != expected:
        raise SystemExit(f"{text!r}: expected {expected!r}, got {actual!r}")

for text in negatives:
    actual = custom_matches(text)
    if actual:
        raise SystemExit(f"{text!r}: expected no public match, got {actual!r}")

print("ok")
PY
