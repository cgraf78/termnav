local function read(path)
  local file = assert(io.open(path, "r"))
  local text = file:read("*a")
  file:close()
  return text
end

local function user_vars(path)
  local text = read(path)
  local body = assert(text:match("local%s+user_vars%s*=%s*{(.-)\n}"), path)
  local vars = {}
  for line in body:gmatch("[^\n]+") do
    local entry = line:gsub("^%s+", ""):gsub("%s+$", "")
    if entry ~= "" and not entry:match("^%-%-") then
      local key, value = entry:match('^([%w_]+)%s*=%s*"([^"]+)"%s*,?$')
      assert(key, path .. ": unsupported user_vars entry: " .. entry)
      vars[key] = value
    end
  end
  return vars
end

