local function pane(vars, cwd_uri, opts)
  opts = opts or {}
  local p = {
    get_user_vars = function()
      return vars or {}
    end,
    get_current_working_dir = function()
      return cwd_uri
    end,
  }
  if opts.foreground then
    p.get_foreground_process_name = function()
      return opts.foreground
    end
  end
  if opts.send_text then
    p.send_text = function(_, text)
      table.insert(sent_text, text)
    end
  end
  return p
end

local function window()
  return {
    toast_notification = function(_, title, message)
      table.insert(toasts, { title = title, message = message })
    end,
  }
end

local function last()
  return calls[#calls]
end

local function last_mode()
  return last()[2]
end

local function last_target()
  return last()[3]
end

local function last_cwd()
  return last()[4]
end

local function last_source()
  return last()[5]
end

local function last_context()
  return last()[6]
end

local function fixture_rows(path)
  local rows = {}
  local file = assert(io.open(path, "r"))
  for line in file:lines() do
    if line ~= "" and line:sub(1, 1) ~= "#" then
      local fields = {}
      local rest = line
      for _ = 1, 5 do
        local value, remaining = rest:match("^([^\t]*)\t(.*)$")
        table.insert(fields, value)
        rest = remaining
      end
      table.insert(fields, rest)
      if fields[6] == "-" then
        fields[6] = ""
      end
      table.insert(rows, fields)
    end
  end
  file:close()
  return rows
end

local function flush_timers()
