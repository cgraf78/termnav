    "vscode://file/home/example/project": ["vscode://file/home/example/project"],
    "postgres://user@localhost/db": ["postgres://user@localhost/db"],
    "localhost:5173?debug=1": ["localhost:5173?debug=1"],
    "127.0.0.1:8000/status": ["127.0.0.1:8000/status"],
    "host.docker.internal:8080": ["host.docker.internal:8080"],
    "github.com/example/project": ["github.com/example/project"],
    "www.example.com?x=1": ["www.example.com?x=1"],
    "git@github.com:example/project.git": ["git@github.com:example/project.git"],
    "git@gitlab.com:org/subgroup/project": ["git@gitlab.com:org/subgroup/project"],
    "CVE-2024-12345": ["CVE-2024-12345"],
    "cve-2024-12345": ["cve-2024-12345"],
    "RFC-9110": ["RFC-9110"],
    "RFC 9110": ["RFC 9110"],
}
