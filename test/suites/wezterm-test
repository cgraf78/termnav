socket_listener() {
  local socket="$1"
  local pid=""

  rm -f "$socket"
  if command -v nc >/dev/null 2>&1; then
    nc -lU "$socket" >/dev/null 2>&1 &
    pid=$!
    for _ in {1..50}; do
      [[ -S "$socket" ]] && {
        echo "$pid"
        return
      }
      sleep 0.02
    done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    rm -f "$socket"
  fi

  if command -v python3 >/dev/null 2>&1; then
    # Some WSL images ship an nc variant without Unix-domain listener support.
    # Python's stdlib socket module gives the helper tests a portable fake RPC
    # endpoint without adding another system package dependency.
    python3 - "$socket" <<'PY' >/dev/null 2>&1 &
import os
import signal
import socket
import sys

path = sys.argv[1]
try:
    os.unlink(path)
except FileNotFoundError:
    pass

server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(path)
server.listen(1)
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
while True:
    conn, _ = server.accept()
    conn.close()
PY
    pid=$!
    for _ in {1..50}; do
      [[ -S "$socket" ]] && {
        echo "$pid"
        return
      }
      sleep 0.02
    done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi

  echo ""
  return 1
}

