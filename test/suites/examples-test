#!/usr/bin/env bash
# examples-test - keep copyable Termnav integrations aligned with public APIs.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

WEZTERM_EXAMPLE="$TERMNAV_ROOT/examples/wezterm.lua"
NVIM_EXAMPLE="$TERMNAV_ROOT/examples/nvim.lua"
TMUX_EXAMPLE="$TERMNAV_ROOT/examples/tmux.conf"
DETECTOR_EXAMPLE="$TERMNAV_ROOT/examples/tmux-follow/extensions.d/example-ticket.sh"
TERMNAV_BINARY=${TERMNAV_TEST_BINARY:-$TERMNAV_ROOT/target/release/termnav}
TERMNAV_BINARY_DIR=$(cd -- "$(dirname -- "$TERMNAV_BINARY")" && pwd -P)

echo "=== termnav: checked-in examples ==="

_assert_file_exists "examples: WezTerm composition is tracked" "$WEZTERM_EXAMPLE"
_assert_file_exists "examples: Neovim composition is tracked" "$NVIM_EXAMPLE"
_assert_file_exists "examples: tmux bindings are tracked" "$TMUX_EXAMPLE"
_assert_file_exists "examples: token detector is tracked" "$DETECTOR_EXAMPLE"

_run_lua() {
  if command -v lua >/dev/null 2>&1; then
    lua "$@"
  elif command -v nvim >/dev/null 2>&1; then
    _run_nvim_lua "$@" 2>&1
  else
    return 127
  fi
}

if command -v lua >/dev/null 2>&1 || command -v nvim >/dev/null 2>&1; then
  _td=$(_tmpdir)
  _wezterm_test="$_td/wezterm-example-test.lua"
  cat >"$_wezterm_test" <<'LUA'
local root = assert(os.getenv("TERMNAV_ROOT"))
local registered = {}
local wezterm = {
  hostname = function() return "example-host" end,
  on = function(name, callback) registered[name] = callback end,
  run_child_process = function(arguments)
    assert(arguments[1] == "termnav path with 'quotes' $HOME $(false) `false`")
    assert(arguments[2] == "asset-path")
    return true, root .. "/" .. arguments[3] .. "\n", ""
  end,
}
local example = dofile(root .. "/examples/wezterm.lua")
local config = { hyperlink_rules = { { regex = "existing", format = "$0" } } }
local integration = example.apply({
  wezterm = wezterm,
  termnav_command = "termnav path with 'quotes' $HOME $(false) `false`",
  config = config,
})

assert(integration.config == config)
assert(integration.routes ~= nil)
assert(#config.hyperlink_rules > 1)
assert(config.hyperlink_rules[1].regex == "existing")
assert(type(registered["open-uri"]) == "function")
print("termnav WezTerm example passed")
LUA
  set +e
  output=$(TERMNAV_ROOT="$TERMNAV_ROOT" _run_lua "$_wezterm_test" 2>&1)
  rc=$?
  set -e
  _assert_exit "examples: WezTerm composition loads" 0 "$rc"
  _assert_contains "examples: WezTerm composition reports success" \
    "termnav WezTerm example passed" "$output"
else
  echo "  SKIP: WezTerm example requires Lua or Neovim"
fi

if command -v nvim >/dev/null 2>&1; then
  _td=${_td:-$(_tmpdir)}
  _nvim_test="$_td/nvim-example-test.lua"
  _weird_termnav="$_td/termnav command ' \$HOME \$(false) \`false\`"
  cat >"$_weird_termnav" <<'SH'
#!/bin/sh
if [ "$#" -ne 2 ] || [ "$1" != asset-path ] || \
    [ "$2" != lib/termnav/nvim/setup.lua ]; then
  exit 91
fi
printf '%s/%s\n' "${TERMNAV_ROOT:?}" "$2"
SH
  chmod +x "$_weird_termnav"
  cat >"$_nvim_test" <<'LUA'
local root = assert(os.getenv("TERMNAV_ROOT"))
local termnav_command = assert(os.getenv("TERMNAV_WEIRD_COMMAND"))

local opener = {
  setup = function() end,
  server = function() return "" end,
}
local wezterm_vars = { set = function() return true end }
local vscode_focus = {
  focus = function() end,
  blur = function() end,
  dispose = function() end,
}
-- The example test validates composition, not the installed command lookup.
-- Inject the same inert collaborator pattern used for other side-effectful
-- integrations. Dedicated navigation suites exercise the native one-shot
-- command without depending on a developer's live terminal topology.
local navigation = { setup = function() end }

local example = dofile(root .. "/examples/nvim.lua")
local context = example.setup({
  termnav_command = termnav_command,
  termnav_options = {
    opener = opener,
    navigation = navigation,
    wezterm_vars = wezterm_vars,
    vscode_focus = vscode_focus,
    publish_delay_ms = -1,
    group_name = "termnav_example_test",
  },
})

assert(type(context.publish) == "function")
assert(context.group_name == "termnav_example_test")
print("termnav Neovim example passed")
LUA
  # CentOS Stream ships Neovim 0.8, which predates `nvim -l`. Drive the Lua
  # fixture through the older public command API and choose an explicit exit
  # for both outcomes so an assertion cannot be hidden by the final quit.
  set +e
  output=$(TERMNAV_ROOT="$TERMNAV_ROOT" \
    TERMNAV_WEIRD_COMMAND="$_weird_termnav" \
    PATH="$TERMNAV_BINARY_DIR:$PATH" \
    _run_nvim_lua "$_nvim_test" 2>&1)
  rc=$?
  set -e
  _assert_exit "examples: Neovim composition loads" 0 "$rc"
  _assert_contains "examples: Neovim composition reports success" \
    "termnav Neovim example passed" "$output"
else
  echo "  SKIP: Neovim example requires Neovim"
fi

if command -v tmux >/dev/null 2>&1; then
  _td=${_td:-$(_tmpdir)}
  _socket="termnav-example-$$"
  _tmux_client_launcher=""
  # An attached client fires the example's focus hooks, and boundary keys run
  # Termnav. Stop the synthetic client and this private server on every exit
  # so a failed assertion cannot leave either behind.
  _stop_examples_tmux() {
    if [[ -n $_tmux_client_launcher ]]; then
      kill "$_tmux_client_launcher" 2>/dev/null || true
      wait "$_tmux_client_launcher" 2>/dev/null || true
      _tmux_client_launcher=""
    fi
    tmux -L "$_socket" kill-server 2>/dev/null || true
  }
  trap '_stop_examples_tmux; _cleanup' EXIT
  # Every hook and binding in the example resolves `termnav` through the
  # server's PATH. A logging stub first on that PATH keeps the focus hooks and
  # boundary routes away from any real terminal topology and records exactly
  # what each key asked Termnav to do. Pane selection and tab selection decline
  # with status 3, as they do at the outermost boundary, unless a case writes
  # another status to the status file.
  _stub_bin="$_td/stub-bin"
  _stub_log="$_td/termnav-stub.log"
  _stub_status="$_td/termnav-stub.status"
  mkdir -p "$_stub_bin"
  : >"$_stub_log"
  echo 3 >"$_stub_status"
  cat >"$_stub_bin/termnav" <<'SH'
#!/bin/sh
printf '%s\n' "$*" >>"$TERMNAV_EXAMPLE_STUB_LOG"
case "$1 $2" in
  "navigate pane-select" | "navigate tab-select")
    exit "$(cat "$TERMNAV_EXAMPLE_STUB_STATUS")"
    ;;
esac
exit 0
SH
  chmod +x "$_stub_bin/termnav"
  TERMNAV_EXAMPLE_STUB_LOG="$_stub_log" \
    TERMNAV_EXAMPLE_STUB_STATUS="$_stub_status" \
    PATH="$_stub_bin:$PATH" \
    tmux -L "$_socket" -f "$TMUX_EXAMPLE" new-session -d -s example
  _assert_exit "examples: tmux config loads" 0 "$?"
  _assert_eq "examples: tmux config enables mouse routing" "on" \
    "$(tmux -L "$_socket" show-options -gv mouse)"
  # Older tmux releases accept a key argument to list-keys but print no
  # matching row. Inspect the complete root table so the example contract is
  # portable while still proving both exact provider commands were installed.
  _tmux_keys=$(tmux -L "$_socket" list-keys -T root)
  _assert_contains "examples: tmux config wires tab switching" \
    "termnav navigate tab-select" "$_tmux_keys"
  _assert_contains "examples: tmux passes exact source identity" \
    "--source-socket" "$_tmux_keys"
  _assert_contains "examples: tmux shell-quotes its dollar-prefixed session ID" \
    '--source-session #{q:session_id}' "$_tmux_keys"
  _assert_not_contains "examples: boundary navigation preserves key order" \
    "run-shell -b" "$(grep 'termnav navigate' "$TMUX_EXAMPLE")"
  _assert_contains "examples: tmux config wires Ctrl-click" \
    "termnav tmux follow-click" "$_tmux_keys"
  _assert_contains "examples: tmux click identity includes its exact server socket" \
    '#{socket_path}' "$_tmux_keys"
  _assert_contains "examples: tmux click identity uses the event pane" \
    '#{mouse_pane}' "$_tmux_keys"
  # tmux 3.2 accepts these hooks but cannot filter `show-hooks` by one hook
  # name. Inspect the complete global table, as with the root key table above,
  # so the example stays testable on the oldest supported distro package.
  _tmux_hooks=$(tmux -L "$_socket" show-hooks -g)
  _tmux_focus_hooks=$(printf '%s\n' "$_tmux_hooks" |
    awk '$1 ~ /^client-focus-in(\[[^]]+\])?$/')
  _tmux_attach_hooks=$(printf '%s\n' "$_tmux_hooks" |
    awk '$1 ~ /^client-attached(\[[^]]+\])?$/')
  _tmux_focus_sync_hook=$(printf '%s\n' "$_tmux_hooks" |
    awk '$1 ~ /^after-select-pane(\[[^]]+\])?$/')
  # Notification hooks can expand #{client_*} for another client; only
  # #{hook_client} names the client that raised them. tmux 3.2 lacks it, so the
  # exact identity remains as a fallback there, behind the control-mode guard.
  _tmux_focus_client='#{?hook_client,--client-name #{q:hook_client},--client-pid #{client_pid} --client-tty #{q:client_tty}}'
  _tmux_focus_guard='#{||:#{hook_client},#{==:#{client_control_mode},0}}'
  if [[ -n $_tmux_focus_hooks ]]; then
    _assert_contains "examples: tmux config registers client focus" \
      "client-focus-in" "$_tmux_focus_hooks"
    _assert_contains "examples: tmux config publishes nested focus" \
      "termnav tmux focus watch" "$_tmux_focus_hooks"
    for _hook in client-attached client-focus-in client-focus-out client-detached client-session-changed; do
      _tmux_hook=$(printf '%s\n' "$_tmux_hooks" |
        awk -v hook="$_hook" 'index($1, hook "[110]") == 1')
      _assert_contains "examples: $_hook names its triggering client" \
        "--tmux-socket #{q:socket_path} $_tmux_focus_client" "$_tmux_hook"
      _assert_contains "examples: $_hook guards only the exact-identity fallback" \
        "$_tmux_focus_guard" "$_tmux_hook"
    done
  else
    # tmux 3.2 accepts the newer hook in a config but does not expose it in the
    # supported hook table. Preserve coverage through the attach hook instead
    # of claiming that terminal focus transitions exist on that release.
    _assert_contains "examples: old tmux registers client attachment" \
      "client-attached" "$_tmux_attach_hooks"
    _assert_contains "examples: old tmux publishes initial nested focus" \
      "termnav tmux focus watch" "$_tmux_attach_hooks"
    _assert_contains "examples: old tmux attachment falls back to its exact client" \
      "$_tmux_focus_client" "$_tmux_attach_hooks"
    _assert_contains "examples: old tmux attachment excludes control clients" \
      "$_tmux_focus_guard" "$_tmux_attach_hooks"
  fi
  _assert_contains "examples: tmux config registers pane focus repair" \
    "after-select-pane" "$_tmux_focus_sync_hook"
  _assert_contains "examples: stale pane dimming is repaired on selection" \
    'termnav tmux focus sync' "$_tmux_focus_sync_hook"
  _assert_contains "examples: ordinary pane selection remains process-free" \
    '#{!=:#{@termnav_client_unfocused},}' "$_tmux_focus_sync_hook"
  # after-select-pane runs with the invoking client, so the exact identity
  # is correct there and matches what older configurations pass.
  _assert_contains "examples: pane selection repair keeps the invoking client" \
    '--client-pid #{client_pid}' "$_tmux_focus_sync_hook"
  _assert_eq "examples: tmux focus publishes its inactive pane style" \
    'bg=default' \
    "$(tmux -L "$_socket" show-options -gqv @termnav_inactive_style)"

  # list-keys prints one line per binding. Check each direction's own line so
  # a key cannot borrow another key's edge, direction, or exit handling.
  _key_binding() {
    printf '%s\n' "$_tmux_keys" | awk -v key="$1" '$3 == "root" && $4 == key'
  }
  for _route in h:left:left:L j:bottom:down:D k:top:up:U l:right:right:R; do
    IFS=: read -r _letter _edge _direction _flag <<<"$_route"
    _binding=$(_key_binding "C-$_letter")
    _assert_contains "examples: Ctrl-$_letter passes through to panes that own it" \
      "send-keys C-$_letter" "$_binding"
    _assert_contains "examples: Ctrl-$_letter tests the $_edge edge" \
      "#{pane_at_$_edge}" "$_binding"
    _assert_contains "examples: Ctrl-$_letter routes its edge to the parent layer" \
      "termnav navigate pane-select $_direction --parent" "$_binding"
    _assert_contains "examples: Ctrl-$_letter moves between interior panes natively" \
      "select-pane -$_flag" "$_binding"
    _assert_contains "examples: Ctrl-$_letter treats a declined route as a no-op" \
      "-eq 3" "$_binding"
  done
  for _key in C-Tab C-BTab; do
    _assert_contains "examples: $_key treats a declined route as a no-op" \
      "-eq 3" "$(_key_binding "$_key")"
  done

  # The ownership predicate reads the pane's foreground command name: argv[0]
  # on Linux, the executable's file name on macOS. A copy of Bash satisfies
  # both. A script would report its interpreter, a symlink can report its
  # target, and BusyBox tools (Alpine) dispatch on argv[0] and would refuse to
  # run under an editor's name.
  _apps="$_td/apps"
  mkdir -p "$_apps"
  cp "$(command -v bash)" "$_apps/nvim"
  cp "$(command -v bash)" "$_apps/ssh"
  cp "$(command -v bash)" "$_apps/termnav"

  _new_pane() {
    local target=$1
    shift
    tmux -L "$_socket" new-window -d -t "$target" -P -F '#{pane_id}' "$@"
  }

  _require_pane_id() {
    if [[ -z $2 ]]; then
      _fail "examples: tmux created the $1 pane"
      exit 1
    fi
  }

  _wait_for_format() {
    local pane=$1 format=$2 expected=$3 actual=""
    for _attempt in $(seq 1 200); do
      actual=$(tmux -L "$_socket" display-message -p -t "$pane" "$format")
      [[ $actual == "$expected" ]] && break
      sleep 0.02
    done
    printf '%s\n' "$actual"
  }

  # Wait for a stand-in to start, and for any mouse-reporting request it
  # writes to reach tmux, before judging ownership.
  _assert_pane_ready() {
    local label=$1 pane=$2 command=$3 mouse=$4
    _assert_eq "examples: the $label pane runs $command" \
      "$command" "$(_wait_for_format "$pane" '#{pane_current_command}' "$command")"
    _assert_eq "examples: the $label pane has mouse reporting $mouse" \
      "$mouse" "$(_wait_for_format "$pane" '#{mouse_any_flag}' "$mouse")"
  }

  _owns_chord() {
    tmux -L "$_socket" display-message -p -t "$1" '#{E:@termnav_pane_owns_chord}'
  }

  tmux -L "$_socket" new-session -d -s owners sh
  _shell_pane=$(tmux -L "$_socket" display-message -p -t owners '#{pane_id}')
  _require_pane_id shell "$_shell_pane"
  _nvim_pane=$(_new_pane owners "$_apps/nvim" -c 'read -r _')
  _require_pane_id nvim "$_nvim_pane"
  _ssh_pane=$(_new_pane owners "$_apps/ssh" -c 'read -r _')
  _require_pane_id ssh "$_ssh_pane"
  # A remote or nested terminal app owns the chord only while it has asked
  # for mouse reporting, which is how the example tells an inner tmux or
  # editor that wants the keys from a plain remote shell.
  _mouse_ssh_pane=$(_new_pane owners "$_apps/ssh" -c \
    'printf "\033[?1000h"; read -r _')
  _require_pane_id "mouse-reporting ssh" "$_mouse_ssh_pane"
  # `termnav ssh` keeps OpenSSH as its child, so tmux sees `termnav` as the
  # foreground command of a pane connected through Termnav's SSH relay.
  _mouse_relay_pane=$(_new_pane owners "$_apps/termnav" -c \
    'printf "\033[?1000h"; read -r _')
  _require_pane_id "mouse-reporting termnav ssh" "$_mouse_relay_pane"
  _assert_pane_ready nvim "$_nvim_pane" nvim 0
  _assert_pane_ready ssh "$_ssh_pane" ssh 0
  _assert_pane_ready "mouse-reporting ssh" "$_mouse_ssh_pane" ssh 1
  _assert_pane_ready "mouse-reporting termnav ssh" "$_mouse_relay_pane" termnav 1

  _assert_eq "examples: a shell pane leaves Ctrl-h/j/k/l to tmux" \
    0 "$(_owns_chord "$_shell_pane")"
  _assert_eq "examples: a Neovim pane owns Ctrl-h/j/k/l" \
    1 "$(_owns_chord "$_nvim_pane")"
  _assert_eq "examples: SSH without mouse reporting leaves Ctrl-h/j/k/l to tmux" \
    0 "$(_owns_chord "$_ssh_pane")"
  _assert_eq "examples: SSH with mouse reporting owns Ctrl-h/j/k/l" \
    1 "$(_owns_chord "$_mouse_ssh_pane")"
  _assert_eq "examples: termnav ssh with mouse reporting owns Ctrl-h/j/k/l" \
    1 "$(_owns_chord "$_mouse_relay_pane")"

  # `send-keys -K` (tmux 3.4) injects a key through an attached client's key
  # tables, exercising the real binding rather than its text.
  _tmux_version=$(tmux -V)
  if [[ $_tmux_version =~ ([0-9]+)\.([0-9]+) ]] &&
    ((BASH_REMATCH[1] < 3 || (BASH_REMATCH[1] == 3 && BASH_REMATCH[2] < 4))); then
    echo "  SKIP: tmux key routing requires tmux 3.4 send-keys -K ($_tmux_version)"
  else
    _cat_input="$_td/nvim-input"
    tmux -L "$_socket" new-session -d -s keys sh
    _left_pane=$(tmux -L "$_socket" display-message -p -t keys '#{pane_id}')
    _require_pane_id left "$_left_pane"
    # shellcheck disable=SC2016 # The stand-in editor expands its own argument.
    _right_pane=$(tmux -L "$_socket" split-window -h -d -t "$_left_pane" \
      -P -F '#{pane_id}' "$_apps/nvim" -c \
      'IFS= read -r line; printf "%s\n" "$line" >"$1"; read -r _' nvim "$_cat_input")
    _require_pane_id right "$_right_pane"
    _assert_pane_ready "stand-in editor" "$_right_pane" nvim 0
    _keys_socket_path=$(tmux -L "$_socket" display-message -p -t keys '#{socket_path}')

    env -u TMUX -u TMUX_PANE TERM=xterm-256color \
      python3 "$TERMNAV_TEST_DIR/support/tmux-client.py" \
      -L "$_socket" attach-session -t keys >"$_td/tmux-client.log" 2>&1 &
    _tmux_client_launcher=$!
    _key_client=""
    for _attempt in $(seq 1 200); do
      _key_client=$(tmux -L "$_socket" list-clients -F '#{client_name}' 2>/dev/null |
        head -n 1)
      [[ -n $_key_client ]] && break
      sleep 0.02
    done
    if [[ -z $_key_client ]]; then
      sed -n '1,40p' "$_td/tmux-client.log" >&2 || true
      _fail "examples: synthetic tmux client attaches"
      exit 1
    fi

    _active_pane() {
      tmux -L "$_socket" display-message -p -t keys '#{pane_id}'
    }

    _wait_for_active() {
      _wait_for_format keys '#{pane_id}' "$1"
    }

    # tmux 3.8 makes `send-keys -K` wait for the binding and returns a failed
    # command's status to that client; older releases show the error in a view
    # over the pane. Capture the client's result instead of letting it end the
    # suite.
    _press() {
      _press_status=0
      _press_output=$(tmux -L "$_socket" send-keys -K -c "$_key_client" "$@" 2>&1) ||
        _press_status=$?
    }

    _routes_logged() {
      grep '^navigate ' "$_stub_log" || true
    }

    tmux -L "$_socket" select-pane -t "$_left_pane"
    _press C-l
    _assert_eq "examples: Ctrl-l in a shell pane selects the neighbor natively" \
      "$_right_pane" "$(_wait_for_active "$_right_pane")"
    _assert_eq "examples: interior pane selection does not run Termnav" \
      "" "$(_routes_logged)"

    # The Neovim pane is also at the right edge, so ownership must win over
    # boundary routing. The stand-in editor records the bytes it received
    # once Enter completes the line.
    _press C-l
    tmux -L "$_socket" send-keys -t "$_right_pane" Enter
    for _attempt in $(seq 1 200); do
      [[ -s $_cat_input ]] && break
      sleep 0.02
    done
    _assert_eq "examples: Ctrl-l reaches the Neovim pane's application" \
      "0c0a" "$(od -An -tx1 "$_cat_input" | tr -d ' \n')"
    _assert_eq "examples: Ctrl-l in a Neovim pane leaves tmux selection alone" \
      "$_right_pane" "$(_active_pane)"
    _assert_eq "examples: a Neovim pane at the edge does not run Termnav" \
      "" "$(_routes_logged)"

    tmux -L "$_socket" select-pane -t "$_left_pane"
    _press C-h
    _edge_press="$_press_status:$_press_output"
    # Boundary routing runs in the foreground, so the next key waits for
    # Termnav to finish. Once Ctrl-l has moved selection, the declined route
    # has completed and any tmux error for its status would be visible.
    _press C-l
    _assert_eq "examples: the key after a boundary route runs" \
      "$_right_pane" "$(_wait_for_active "$_right_pane")"
    _edge_route=$(_routes_logged)
    _assert_contains "examples: Ctrl-h at the left edge asks the parent layer" \
      "navigate pane-select left --parent" "$_edge_route"
    _assert_contains "examples: the edge route names this tmux server" \
      "--source-socket $_keys_socket_path" "$_edge_route"
    _assert_contains "examples: the edge route names the source pane" \
      "--source-pane $_left_pane " "$_edge_route"
    _assert_eq "examples: a declined edge route reports nothing to the key's client" \
      "0:" "$_edge_press"
    _assert_eq "examples: a declined edge route shows no tmux error" \
      0 "$(tmux -L "$_socket" display-message -p -t "$_left_pane" '#{pane_in_mode}')"

    : >"$_stub_log"
    tmux -L "$_socket" select-pane -t "$_left_pane"
    _press C-Tab
    _tab_press="$_press_status:$_press_output"
    _press C-l
    _assert_eq "examples: the key after a tab route runs" \
      "$_right_pane" "$(_wait_for_active "$_right_pane")"
    _assert_contains "examples: Ctrl-Tab in a one-window layer asks the parent layer" \
      "navigate tab-select next --parent" "$(_routes_logged)"
    _assert_eq "examples: a declined tab route reports nothing to the key's client" \
      "0:" "$_tab_press"
    _assert_eq "examples: a declined tab route shows no tmux error" \
      0 "$(tmux -L "$_socket" display-message -p -t "$_left_pane" '#{pane_in_mode}')"

    # Only the decline status is silenced; a real failure must still surface.
    # No follow-up key here: the error view would take it in emacs mode-keys.
    echo 5 >"$_stub_status"
    tmux -L "$_socket" select-pane -t "$_left_pane"
    _press C-h
    if [[ $_press_status -eq 5 ]] ||
      [[ $(_wait_for_format "$_left_pane" '#{pane_in_mode}' 1) == 1 ]]; then
      _pass "examples: a failed edge route still reports its status"
    else
      _fail "examples: a failed edge route still reports its status (client status $_press_status, output '$_press_output', no error view)"
    fi
  fi
  _stop_examples_tmux
  trap _cleanup EXIT
else
  echo "  SKIP: tmux config example requires tmux"
fi

# Run the extension through the native click router rather than sourcing it.
# That proves registration, precedence, and URL dispatch all match production.
_td=${_td:-$(_tmpdir)}
_mock_bin="$_td/mock-bin"
_browser_tty="$_td/browser-tty"
mkdir -p "$_mock_bin"
: >"$_browser_tty"
# The clicking client is a WezTerm attachment whose tty is a plain file.
cat >"$_mock_bin/tmux" <<'SH'
#!/usr/bin/env bash
if [[ " $* " == *" list-clients "* ]]; then
  printf '0\tWezTerm 20240203-110809-5046fc22\t%s\txterm-256color\t0\n' \
    "$TERMNAV_EXAMPLE_BROWSER_TTY"
  exit 0
fi
exit 1
SH
chmod +x "$_mock_bin/tmux"

TMUX="/tmp/termnav-example,1,0" \
  TERMNAV_EXAMPLE_BROWSER_TTY="$_browser_tty" \
  TERMNAV_TMUX_FOLLOW_EXTENSION_DIR="${DETECTOR_EXAMPLE%/*}" \
  PATH="$_mock_bin:$PATH" \
  "$TERMNAV_BINARY" \
  tmux follow-click "" "TICKET-42" "" 0 "/tmp" "$_browser_tty"

python3 - "$_browser_tty" <<'PY'
import base64
import re
import sys
from pathlib import Path

payload = Path(sys.argv[1]).read_bytes()
match = re.search(rb"SetUserVar=TERMNAV_OPEN_URL=([A-Za-z0-9+/=]+)", payload)
assert match, payload
assert base64.b64decode(match.group(1)) == b"https://issues.example.com/TICKET-42"
PY
_assert_exit "examples: custom detector registers and routes its token" 0 "$?"

# A detector is optional user policy running on the click hot path. Treat it as
# an untrusted availability boundary: a script that never stops writing must be
# killed and reaped by Termnav rather than wedging the tmux mouse binding.
_bounded_detector_dir="$_td/bounded-detectors"
mkdir -p "$_bounded_detector_dir"
cat >"$_bounded_detector_dir/loop.sh" <<'SH'
tmux_follow_register_token_detector termnav_test_unbounded_detector
termnav_test_unbounded_detector() {
  while :; do printf '0123456789abcdef'; done
}
SH

python3 - "$TERMNAV_BINARY" "$_bounded_detector_dir" <<'PY'
import os
import signal
import subprocess
import sys

env = os.environ.copy()
env["TERMNAV_TMUX_FOLLOW_EXTENSION_DIR"] = sys.argv[2]
process = subprocess.Popen(
    [sys.argv[1], "tmux", "follow-click", "", "CUSTOM-1", "", "0", "/tmp", ""],
    env=env,
    start_new_session=True,
)
try:
    code = process.wait(timeout=2)
except subprocess.TimeoutExpired:
    os.killpg(process.pid, signal.SIGKILL)
    process.wait()
    raise SystemExit("click detector exceeded its bounded execution contract")
if code != 0:
    raise SystemExit(f"bounded click detector returned {code}")
PY
_assert_exit "examples: unbounded detector output is terminated and reaped" 0 "$?"

_test_summary
