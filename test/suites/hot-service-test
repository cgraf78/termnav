  _pass "hot service: periodic maintenance removes abandoned relay sockets"
else
  _fail "hot service: periodic maintenance removes abandoned relay sockets"
fi
XDG_RUNTIME_DIR="$sweep_runtime" TMPDIR="$sweep_tmp" "$relay" stop || true

set +e
TERMNAV_TEST_ROOT="$root" \
  TERMNAV_TEST_SOCKET="$socket_test_root/slow-sweep.sock" \
  TERMNAV_TEST_HOT_IDLE_SECONDS=2 TERMNAV_TEST_HOT_SWEEP_SECONDS=60 \
  python3 - <<'PY'
import os
import socket
import sys
import threading
import time
from pathlib import Path

root = Path(os.environ["TERMNAV_TEST_ROOT"])
sys.path.insert(0, str(root / "lib" / "termnav"))
from hot_service import PROVIDER_ROOT, serve_hot

socket_path = Path(os.environ["TERMNAV_TEST_SOCKET"])
sweep_started = threading.Event()
sweep_release = threading.Event()


def sweep() -> int:
    sweep_started.set()
    if not sweep_release.wait(2):
        raise RuntimeError("slow sweep was not released")
    return 0


def send(_scope: str, _direction: str, **_kwargs) -> int:
    return 3


def commit(*_args, **_kwargs) -> int:
    return 0


server = threading.Thread(
    target=serve_hot,
    args=(str(socket_path), send, commit, sweep),
    daemon=True,
)
server.start()
if not sweep_started.wait(2):
    raise SystemExit("maintenance sweep did not start")


def request(action: str) -> bytes:
    fields = (
        "termnav-hot-v1",
        PROVIDER_ROOT,
        "",
        os.environ.get("PATH", ""),
        os.environ.get("HOME", ""),
        os.environ.get("XDG_STATE_HOME", ""),
        "",
        "",
        "",
        action,
    )
    body = "\0".join(fields).encode() + b"\0"
    header = (
        b"POST /v1 HTTP/1.1\r\n"
        b"Host: localhost\r\n"
        + f"Content-Length: {len(body)}\r\n\r\n".encode()
    )
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(0.5)
        client.connect(str(socket_path))
        client.sendall(header + body)
        reply = b""
        while True:
            chunk = client.recv(4096)
            if not chunk:
                break
            reply += chunk
        return reply


if not request("warm").endswith(b"\r\n\r\n0"):
    raise SystemExit("slow maintenance blocked request admission")
sweep_release.set()
if not request("stop").endswith(b"\r\n\r\n0"):
    raise SystemExit("slow-sweep service did not stop")
server.join(2)
if server.is_alive():
    raise SystemExit("slow-sweep service did not exit")
PY
slow_sweep_rc=$?
set -e
_assert_exit "hot service: slow maintenance never blocks request admission" \
  0 "$slow_sweep_rc"

