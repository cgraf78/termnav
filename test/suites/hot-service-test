import os
import socket
import sys
from pathlib import Path
from unittest import mock

sys.path.insert(0, str(Path(os.environ["TERMNAV_TEST_ROOT"]) / "lib" / "termnav"))
from hot_service import _socket_identity, _unlink_socket

path = Path(os.environ["TERMNAV_TEST_IDENTITY_DIR"]) / "replacement.sock"
first = socket.socket(socket.AF_UNIX)
first.bind(str(path))
identity = _socket_identity(path)
first.close()
path.unlink()
replacement = socket.socket(socket.AF_UNIX)
try:
    replacement.bind(str(path))
    replacement.listen()
    # Overlay filesystems and several Unix kernels may immediately reuse the
    # old pathname's inode. Force that valid result so this regression is
    # deterministic even on filesystems that happened to allocate a new one.
    with mock.patch("hot_service._socket_identity", return_value=identity):
        _unlink_socket(path, identity)
    if not path.exists():
        raise SystemExit("an old owner removed its replacement")
finally:
    replacement.close()
    path.unlink(missing_ok=True)
