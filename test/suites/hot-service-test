cat >"$stale_bin/python3" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$TERMNAV_TEST_FALLBACK_LOG"
exit 37
SH
chmod 0755 "$stale_bin/python3"
touch -t 200001010000 "$drain_socket"
set +e
BASH_ENV="$stale_bash_env" PATH="$stale_bin:$PATH" \
  TERMNAV_PYTHON="$stale_bin/python3" \
  TERMNAV_TEST_FALLBACK_LOG="$stale_fallback_log" \
  XDG_RUNTIME_DIR="$drain_runtime" "$relay" send pane left
stale_busy_rc=$?
set -e
_assert_exit "hot service: busy stale dispatcher uses the current fallback" \
  37 "$stale_busy_rc"
_assert_contains "hot service: busy stale fallback receives the gesture" \
  "lib/termnav/relay.py send pane left" "$(cat "$stale_fallback_log")"

for action in stop warm; do
  set +e
  TERMNAV_TEST_SOCKET="$drain_socket" TERMNAV_TEST_ROOT="$root" \
    TERMNAV_TEST_ACTION="$action" python3 - <<'PY'
import os
import socket

fields = (
    "termnav-hot-v1",
    os.environ["TERMNAV_TEST_ROOT"],
    "",
    os.environ.get("PATH", ""),
    os.environ.get("HOME", ""),
    os.environ.get("XDG_STATE_HOME", ""),
    os.environ.get("TERMNAV_VSCODE_CURL", ""),
    os.environ.get("TERMNAV_VSCODE_FALLBACK_BACKEND", ""),
    os.environ.get("VSCODE_MCP_PORT", ""),
    os.environ["TERMNAV_TEST_ACTION"],
)
body = "\0".join(fields).encode() + b"\0"
header = (
    b"POST /v1 HTTP/1.1\r\n"
    b"Host: localhost\r\n"
    + f"Content-Length: {len(body)}\r\n\r\n".encode()
)
with socket.socket(socket.AF_UNIX) as client:
    client.settimeout(2)
    client.connect(os.environ["TERMNAV_TEST_SOCKET"])
    client.sendall(header + body)
    reply = b""
    while True:
        chunk = client.recv(4096)
        if not chunk:
            break
        reply += chunk
if not reply.endswith(b"\r\n\r\n0"):
    raise SystemExit(f"unexpected {os.environ['TERMNAV_TEST_ACTION']} reply: {reply!r}")
PY
  drain_followup_rc=$?
  set -e
  _assert_exit "hot service: stopping service accepts active-route $action request" \
    0 "$drain_followup_rc"
done
if [[ -S $drain_socket ]]; then
  _pass "hot service: stop retains the socket while an active route drains"
else
  _fail "hot service: stop retains the socket while an active route drains"
fi
: >"$drain_release"
set +e
wait "$drain_pid"
drain_rc=$?
set -e
_assert_exit "hot service: active route completes during graceful stop" \
  0 "$drain_rc"
if wait_for_path absent "$drain_socket"; then
  _pass "hot service: graceful stop removes the drained service socket"
else
  _fail "hot service: graceful stop removes the drained service socket"
fi

concurrent_runtime=$socket_test_root/k
concurrent_socket=$(socket_for_runtime "$concurrent_runtime")
warm_pids=()
for _ in 1 2 3 4 5 6 7 8; do
  XDG_RUNTIME_DIR="$concurrent_runtime" "$relay" warm &
  warm_pids+=("$!")
done
for warm_pid in "${warm_pids[@]}"; do
  wait "$warm_pid"
done
if wait_for_path present "$concurrent_socket"; then
  _pass "hot service: concurrent shell activation converges on a dispatcher"
else
  _fail "hot service: concurrent shell activation converges on a dispatcher"
fi
set +e
env -u TERMNAV_PARENT_RELAY XDG_RUNTIME_DIR="$concurrent_runtime" \
  "$relay" send pane left
concurrent_rc=$?
set -e
_assert_exit "hot service: concurrent startup leaves a usable dispatcher" \
  3 "$concurrent_rc"

request_dir=$(_tmpdir)/requests
mkdir -p "$request_dir"
concurrent_failures=0
for ((round = 1; round <= 5; round++)); do
  request_pids=()
  for ((request = 1; request <= 16; request++)); do
    (
      set +e
      env -u TERMNAV_PARENT_RELAY XDG_RUNTIME_DIR="$concurrent_runtime" \
        "$relay" send pane left
      printf '%s\n' "$?" >"$request_dir/$round-$request"
    ) &
    request_pids+=("$!")
  done
  for request_pid in "${request_pids[@]}"; do
    wait "$request_pid"
  done
  for ((request = 1; request <= 16; request++)); do
    [[ $(cat "$request_dir/$round-$request") == 3 ]] ||
      concurrent_failures=$((concurrent_failures + 1))
  done
done
_assert_eq "hot service: concurrent clients retain independent results" \
  0 "$concurrent_failures"
XDG_RUNTIME_DIR="$concurrent_runtime" "$relay" stop

_test_summary
