#!/usr/bin/env bash
# remote-test — repo-owned unit tests for remote host detection.
#
# These cover nvim-open/remote.sh's transport-host parsing, which decides
# where a remote file link should open. The tricky case is an interactive
# pane: tmux reports pane_current_command as the live transport (`ssh`), but
# pane_start_command is the login shell that created the pane. Host detection
# must read the live process tree in that case, not misparse the shell argv.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

lib_dir="$TERMNAV_ROOT/lib/termnav/nvim-open"
# shellcheck source=../../lib/termnav/remote-command.sh
. "${lib_dir%/nvim-open}/remote-command.sh"
# shellcheck source=../../lib/termnav/nvim-open/common.sh
. "$lib_dir/common.sh"
# shellcheck source=../../lib/termnav/nvim-open/remote.sh
. "$lib_dir/remote.sh"

echo "=== state directory resolution ==="

state_home="$(_tmpdir)/home"
xdg_state_home="$(_tmpdir)/state"
_assert_eq "state directory: defaults below HOME" \
  "$state_home/.local/state/nvim-tmux-open" \
  "$(
    unset XDG_STATE_HOME
    HOME="$state_home" nvim_open_state_dir
  )"
_assert_eq "state directory: honors XDG_STATE_HOME" \
  "$xdg_state_home/nvim-tmux-open" \
  "$(XDG_STATE_HOME="$xdg_state_home" nvim_open_state_dir)"
_assert_eq "state directory: rejects relative XDG_STATE_HOME" \
  "$state_home/.local/state/nvim-tmux-open" \
  "$(HOME="$state_home" XDG_STATE_HOME=relative/state nvim_open_state_dir)"
XDG_STATE_HOME="$xdg_state_home"$'\n'
unset HOME
nvim_open_resolve_state_dir
_assert_eq "state directory: preserves XDG trailing newline bytes" \
  "$XDG_STATE_HOME/nvim-tmux-open" "$REPLY"
nvim_open_log "newline-xdg-state-test"
_assert_file_exists "log file: preserves XDG trailing newline bytes" \
  "$XDG_STATE_HOME/wezterm-nvim-open.log"
unset XDG_STATE_HOME
REPLY="stale"
if nvim_open_resolve_state_dir; then
  _fail "state directory: fails closed without XDG_STATE_HOME or HOME"
else
  _pass "state directory: fails closed without XDG_STATE_HOME or HOME"
fi
_assert_eq "state directory: missing roots clear stale resolver output" "" "$REPLY"
HOME="$state_home"
XDG_STATE_HOME="$xdg_state_home" nvim_open_log "xdg-state-test"
_assert_file_exists "log file: honors XDG_STATE_HOME" \
  "$xdg_state_home/wezterm-nvim-open.log"

echo "=== positional transport-host parsing ==="

# A pane launched directly into the transport: start_command is the ssh argv,
# so positional parsing is authoritative.
_assert_eq "positional: direct ssh start command yields the host" \
  "dev1" "$(nvim_open_remote_host_from_positional_command ssh "ssh dev1")"

# Flags without values must be skipped so the first positional word wins.
_assert_eq "positional: skips ssh option flags before the host" \
  "dev1" "$(nvim_open_remote_host_from_positional_command ssh "ssh -t dev1 tmux attach")"

# user@host and HostName= transport spellings normalize to the bare host.
_assert_eq "positional: normalizes user@host transport spelling" \
  "dev1" "$(nvim_open_remote_host_from_positional_command ssh "ssh chris@dev1")"

# The regression: a login-shell start command is NOT an ssh invocation, so it
# cannot name a host. It must fail (rc != 0) rather than returning "exec",
# otherwise the caller never consults the process tree for the real `ssh host`.
if host=$(nvim_open_remote_host_from_positional_command ssh "exec /usr/bin/zsh -l"); then
  _fail "positional: login-shell start command must not parse as a host (got '$host')"
else
  _pass "positional: login-shell start command fails instead of returning a shell word"
fi

echo "=== process-tree fallback ==="

process_snapshot='999 1 999 999 ssh ssh unrelated.example
201 100 201 210 ssh ssh background.example
211 210 210 210 sleep sleep 30
210 100 210 210 /usr/bin/ssh ssh dev1
100 1 100 210 zsh -zsh'
_assert_eq "process snapshot: selects the foreground descendant transport" \
  "ssh dev1" \
  "$(printf '%s\n' "$process_snapshot" | nvim_open_pane_process_from_snapshot 100 ssh)"

shuffled_snapshot='210 100 210 210 /usr/bin/ssh ssh dev1
100 1 100 210 zsh -zsh
201 100 201 210 ssh ssh background.example
999 1 999 999 ssh ssh unrelated.example'
_assert_eq "process snapshot: selection does not depend on ps row order" \
  "ssh dev1" \
  "$(printf '%s\n' "$shuffled_snapshot" | nvim_open_pane_process_from_snapshot 100 ssh)"

if process=$(
  printf '%s\n' '300 301 300 300 ssh ssh cycle.example' \
    '301 300 300 300 zsh zsh' |
    nvim_open_pane_process_from_snapshot 100 ssh
); then
  if [[ -n "$process" ]]; then
    _fail "process snapshot: cyclic unrelated ancestry must fail closed (got '$process')"
  else
    _pass "process snapshot: cyclic unrelated ancestry fails closed"
  fi
else
  _pass "process snapshot: cyclic unrelated ancestry fails closed"
fi

# Simulate the interactive-pane reality: start_command is the login shell, but
# the live process tree holds the typed `ssh dev1`. Stub the process-tree
# reader so the test is deterministic and does not depend on host `ps` output.
# shellcheck disable=SC2329  # invoked indirectly by the sourced remote.sh
nvim_open_pane_process_command() {
  printf 'ssh dev1\n'
}

_assert_eq "host_from_command: falls back to the live ssh in the process tree" \
  "dev1" "$(nvim_open_remote_host_from_command ssh "exec /usr/bin/zsh -l" 12345)"

if nvim_open_remote_pane_matches ssh "exec /usr/bin/zsh -l" 12345 "dev1"; then
  _pass "pane_matches: interactive ssh pane matches its connected host"
else
  _fail "pane_matches: interactive ssh pane should match its connected host"
fi

if nvim_open_remote_pane_matches ssh "exec /usr/bin/zsh -l" 12345 "dev2"; then
  _fail "pane_matches: ssh pane must not match an unrelated host"
else
  _pass "pane_matches: ssh pane does not match an unrelated host"
fi

# When the process tree has no transport (a bare shell pane), there is no host
# to report and the command lookup fails closed.
# shellcheck disable=SC2329  # invoked indirectly by the sourced remote.sh
nvim_open_pane_process_command() {
  return 1
}

if host=$(nvim_open_remote_host_from_command ssh "exec /usr/bin/zsh -l" 12345); then
  _fail "host_from_command: bare shell pane must not yield a host (got '$host')"
else
  _pass "host_from_command: bare shell pane reports no host"
fi

echo "=== remote command resolution ==="

remote_bin="$(_tmpdir)/custom-bin"
remote_log="$(_tmpdir)/remote-opener.log"
mkdir -p "$remote_bin"
cat >"$remote_bin/nvim-tmux-open" <<'EOF'
#!/bin/sh
printf '<%s>\n' "$@" >"$TERMNAV_REMOTE_TEST_LOG"
EOF
chmod +x "$remote_bin/nvim-tmux-open"
remote_command=$(termnav_remote_nvim_command tmux-link "/tmp/a b's.txt:4")
TERMNAV_REMOTE_TEST_LOG="$remote_log" PATH="$remote_bin:/usr/bin:/bin" \
  /bin/sh -c "$remote_command"
_assert_eq "remote command: respects a custom install already on PATH" \
  "$(printf '<tmux-link>\n</tmp/a b'\''s.txt:4>')" "$(cat "$remote_log")"

missing_home="$(_tmpdir)"
HOME="$missing_home" PATH="/usr/bin:/bin" /bin/sh -c "$remote_command" >/dev/null 2>&1
remote_missing_rc=$?
_assert_exit "remote command: missing opener exits 127" 127 "$remote_missing_rc"

echo "=== nvim_open_tmux_send: no-RPC :edit fallback ==="

# The socketless fallback types an :edit into a running nvim. It must (1) set
# both line AND column and (2) fnameescape the target so filename metachars
# (* ? [ {) and spaces don't glob or misparse — regressions were a dropped
# column and a bare `:e +LINE <file>` that mishandled globs.
_send_bin=$(_mock_bin)
_send_log="$(_tmpdir)/tmux-send.log"
cat >"$_send_bin/tmux" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$_send_log"
EOF
chmod +x "$_send_bin/tmux"
: >"$_send_log"
PATH="$_send_bin:$PATH" nvim_open_tmux_send "%1" 'weird [name]*.md' 12 34 /tmp/proj
_send_out=$(cat "$_send_log")
_assert_contains "tmux-send: fnameescapes the edit target" \
  'fnameescape("/tmp/proj/weird [name]*.md")' "$_send_out"
_assert_contains "tmux-send: sets both line and column" \
  'call cursor(12,34)' "$_send_out"
_assert_not_contains "tmux-send: no bare globbing ':e +line' form" \
  ':e +12' "$_send_out"

# Missing/non-numeric line and column fall back to 1, never breaking the command.
: >"$_send_log"
PATH="$_send_bin:$PATH" nvim_open_tmux_send "%1" '/abs/file.md' '' '' ''
_send_out=$(cat "$_send_log")
_assert_contains "tmux-send: defaults missing line/col to 1" \
  'call cursor(1,1)' "$_send_out"

_test_summary
