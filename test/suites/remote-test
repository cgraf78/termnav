#!/usr/bin/env bash
# remote-test — repo-owned unit tests for remote host detection.
#
# These cover nvim-open/remote.sh's transport-host parsing, which decides
# where a remote file link should open. The tricky case is an interactive
# pane: tmux reports pane_current_command as the live transport (`ssh`), but
# pane_start_command is the login shell that created the pane. Host detection
# must read the live process tree in that case, not misparse the shell argv.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

lib_dir="$TERMNAV_ROOT/lib/termnav/nvim-open"
# shellcheck source=../../lib/termnav/nvim-open/common.sh
. "$lib_dir/common.sh"
# shellcheck source=../../lib/termnav/nvim-open/remote.sh
. "$lib_dir/remote.sh"

echo "=== positional transport-host parsing ==="

# A pane launched directly into the transport: start_command is the ssh argv,
# so positional parsing is authoritative.
_assert_eq "positional: direct ssh start command yields the host" \
  "dev1" "$(nvim_open_remote_host_from_positional_command ssh "ssh dev1")"

# Flags without values must be skipped so the first positional word wins.
_assert_eq "positional: skips ssh option flags before the host" \
  "dev1" "$(nvim_open_remote_host_from_positional_command ssh "ssh -t dev1 tmux attach")"

# user@host and HostName= transport spellings normalize to the bare host.
_assert_eq "positional: normalizes user@host transport spelling" \
  "dev1" "$(nvim_open_remote_host_from_positional_command ssh "ssh chris@dev1")"

# The regression: a login-shell start command is NOT an ssh invocation, so it
# cannot name a host. It must fail (rc != 0) rather than returning "exec",
# otherwise the caller never consults the process tree for the real `ssh host`.
if host=$(nvim_open_remote_host_from_positional_command ssh "exec /usr/bin/zsh -l"); then
  _fail "positional: login-shell start command must not parse as a host (got '$host')"
else
  _pass "positional: login-shell start command fails instead of returning a shell word"
fi

echo "=== process-tree fallback ==="

# Simulate the interactive-pane reality: start_command is the login shell, but
# the live process tree holds the typed `ssh dev1`. Stub the process-tree
# reader so the test is deterministic and does not depend on host `ps` output.
# shellcheck disable=SC2329  # invoked indirectly by the sourced remote.sh
nvim_open_pane_process_command() {
  printf 'ssh dev1\n'
}

_assert_eq "host_from_command: falls back to the live ssh in the process tree" \
  "dev1" "$(nvim_open_remote_host_from_command ssh "exec /usr/bin/zsh -l" 12345)"

if nvim_open_remote_pane_matches ssh "exec /usr/bin/zsh -l" 12345 "dev1"; then
  _pass "pane_matches: interactive ssh pane matches its connected host"
else
  _fail "pane_matches: interactive ssh pane should match its connected host"
fi

if nvim_open_remote_pane_matches ssh "exec /usr/bin/zsh -l" 12345 "dev2"; then
  _fail "pane_matches: ssh pane must not match an unrelated host"
else
  _pass "pane_matches: ssh pane does not match an unrelated host"
fi

# When the process tree has no transport (a bare shell pane), there is no host
# to report and the command lookup fails closed.
# shellcheck disable=SC2329  # invoked indirectly by the sourced remote.sh
nvim_open_pane_process_command() {
  return 1
}

if host=$(nvim_open_remote_host_from_command ssh "exec /usr/bin/zsh -l" 12345); then
  _fail "host_from_command: bare shell pane must not yield a host (got '$host')"
else
  _pass "host_from_command: bare shell pane reports no host"
fi

_test_summary
