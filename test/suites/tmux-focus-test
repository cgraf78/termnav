#!/usr/bin/env bash
# tmux-focus-test - real tmux coverage for hierarchical leaf-focus ownership.

set -euo pipefail
export NO_COLOR=1

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"
# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"

echo "=== tmux leaf-focus ownership ==="
adapter_dir=$(_tmpdir)
focus_adapter=$adapter_dir/termnav-tmux-focus
relay_adapter=$adapter_dir/termnav-relay
termnav=${TERMNAV_TEST_BINARY:-$root/target/release/termnav}
_termnav_command_adapter "$focus_adapter" "$termnav" tmux focus
_termnav_command_adapter "$relay_adapter" "$termnav" relay
set +e
output=$(python3 "$test_dir/support/tmux-focus.py" \
  --focus "$focus_adapter" \
  --relay "$relay_adapter" 2>&1)
rc=$?
set -e
printf '%s\n' "$output"
_assert_exit "tmux focus: real tmux integration passes" 0 "$rc"
_assert_contains "tmux focus: a bounded claim expires" \
  "test_claim_expires_without_a_release" "$output"
_assert_contains "tmux focus: a claim applies and restores pane styling" \
  "test_claim_applies_parent_style_and_release_restores_inheritance" "$output"
_assert_contains "tmux focus: deployments without style policy remain compatible" \
  "test_claim_without_inactive_style_keeps_existing_behavior" "$output"
_assert_contains "tmux focus: invalid styles preserve core focus ownership" \
  "test_invalid_inactive_style_preserves_the_core_focus_claim" "$output"
_assert_contains "tmux focus: invalid styles restore pane-local overrides" \
  "test_invalid_inactive_style_restores_an_existing_override" "$output"
_assert_contains "tmux focus: malformed restore markers preserve pane styling" \
  "test_malformed_restore_marker_preserves_the_current_pane_style" "$output"
_assert_contains "tmux focus: bad saved styles cannot trap expired claims" \
  "test_invalid_saved_style_cannot_trap_an_expired_claim" "$output"
_assert_contains "tmux focus: concurrent replacement restores the original style" \
  "test_concurrent_replacement_restores_the_original_pane_style" "$output"
_assert_contains "tmux focus: a preexisting pane style is restored" \
  "test_release_restores_an_existing_pane_active_style" "$output"
_assert_contains "tmux focus: a renewed claim keeps its lease" \
  "test_renewal_extends_the_same_claim" "$output"
_assert_contains "tmux focus: stale cleanup cannot clear a replacement" \
  "test_stale_release_cannot_clear_a_replacement" "$output"
_assert_contains "tmux focus: SSH relay claims only the immediate parent pane" \
  "test_relay_claim_is_scoped_to_its_immediate_parent_pane" "$output"
_assert_contains "tmux focus: tmuxless hops forward to the nearest parent" \
  "test_tmuxless_relay_forwards_to_the_nearest_parent_scope" "$output"
_assert_contains "tmux focus: a top-level relay declines focus ownership" \
  "test_focus_without_a_parent_scope_is_declined" "$output"
_assert_contains "tmux focus: malformed relay updates cannot mutate tmux" \
  "test_invalid_focus_messages_fail_without_mutating_tmux" "$output"
_assert_contains "tmux focus: heartbeats do not block navigation admission" \
  "test_focus_heartbeat_does_not_block_navigation_admission" "$output"
_assert_contains "tmux focus: a nested client owns only its exact parent pane" \
  "test_local_nested_client_claims_and_releases_its_exact_parent_pane" "$output"
_assert_contains "tmux focus: direct client focus repaints its own leaf" \
  "test_direct_client_focus_changes_repaint_its_active_leaf" "$output"
_assert_contains "tmux focus: selection repairs stale pane dimming" \
  "test_selecting_a_stale_dimmed_pane_repairs_its_style" "$output"
_assert_contains "tmux focus: arbitrary depth retains one highlighted leaf" \
  "test_three_levels_keep_exactly_one_highlighted_leaf" "$output"
_assert_contains "tmux focus: shared inner sessions keep attachments independent" \
  "test_shared_inner_session_keeps_outer_attachments_independent" "$output"
_assert_contains "tmux focus: killed publishers expire and recover" \
  "test_publisher_crash_expires_then_next_focus_recovers" "$output"
_assert_contains "tmux focus: delayed focus-out cannot kill a refocused publisher" \
  "test_delayed_focus_out_cannot_stop_a_refocused_client" "$output"
_assert_contains "tmux focus: renewals do not fan out helper processes" \
  "test_renewals_keep_one_expirer_and_direct_clients_keep_no_watcher" "$output"

_test_summary
