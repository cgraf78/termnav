#!/usr/bin/env bash
# tmux-test — native tmux integration without historical executable facades.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

termnav=${TERMNAV_TEST_BINARY:-$TERMNAV_ROOT/target/release/termnav}

echo "=== termnav shell API ==="

shell_api_output=$(
  TERMNAV_ROOT="$TERMNAV_ROOT" bash --noprofile --norc -c '
    source "$TERMNAV_ROOT/share/termnav/shell.sh"
    declare -F _termnav_wezterm_publish_link_context >/dev/null && echo publish
    declare -F _termnav_wezterm_precmd >/dev/null && echo precmd
  '
)
_assert_contains "shell api: exposes WezTerm context publisher" \
  "publish" "$shell_api_output"
_assert_contains "shell api: exposes prompt hook callback" \
  "precmd" "$shell_api_output"

echo "=== native nvim tmux opener ==="

tmp=$(_tmpdir)
mock_bin="$tmp/bin"
mkdir -p "$mock_bin"
cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
case "$1" in
  list-panes)
    printf '%%1\tbash\n%%2\tnvim\n'
    ;;
  send-keys)
    printf '%s\n' "$*" >>"${TERMNAV_TMUX_TEST_LOG:?}"
    ;;
  *)
    exit 1
    ;;
esac
MOCK
chmod +x "$mock_bin/tmux"

log="$tmp/tmux.log"
TMUX="/tmp/termnav-test.sock,1,0" \
  TMUX_PANE=%1 \
  PATH="$mock_bin:$PATH" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  "$termnav" nvim open cli 'a/src/app.lua:12' /repo
_assert_exit "native opener: current-window pane opens" 0 "$?"
_assert_contains "native opener: targets the nvim pane" \
  'send-keys -t %2 -l' "$(cat "$log")"
_assert_contains "native opener: preserves CLI-like file arguments verbatim" \
  'fnameescape("/repo/a/src/app.lua:12")' "$(cat "$log")"
_assert_contains "native opener: leaves cursor parsing to an existing target" \
  'cursor(1,1)' "$(cat "$log")"

cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
case "$1" in
  list-panes) printf '%%1\tbash\n' ;;
  display-popup) printf '%s\n' "${@: -1}" >>"${TERMNAV_TMUX_TEST_LOG:?}" ;;
  *) exit 1 ;;
esac
MOCK
chmod +x "$mock_bin/tmux"

log="$tmp/missing.log"
TMUX="/tmp/termnav-test.sock,1,0" \
  TMUX_PANE=%1 \
  PATH="$mock_bin:/usr/bin:/bin" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  "$termnav" nvim open tmux-link /home/alex/.zshrc '' remote remote.example \
  >/dev/null 2>&1
_assert_exit "native opener: missing remote session is user-facing success" 0 "$?"
_assert_contains "native opener: remote diagnostic names the host" \
  'No nvim session found for remote.example: /home/alex/.zshrc' "$(cat "$log")"

_test_summary
