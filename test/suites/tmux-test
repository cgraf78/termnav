TMUX_FOLLOW_LOG="$tmp/loopback-line-nvim.log" \
  TMUX="/tmp/tmux-test,1,0" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "" "" "serving 127.0.0.1:8000/status now" 8 "/repo" "$browser_tty"
