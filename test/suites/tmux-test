_assert_follow_browser_word \
  "websocket-scheme" "wss://example.com/socket" \
  "wss://example.com/socket"
_assert_follow_browser_word \
  "vscode-scheme" "vscode://file/home/example/project" \
  "vscode://file/home/example/project"
_assert_follow_browser_word \
  "postgres-scheme" "postgres://user@localhost/db" \
  "postgres://user@localhost/db"
_assert_follow_browser_word \
  "localhost-query" "localhost:5173?debug=1" \
  "http://localhost:5173?debug=1"
_assert_follow_browser_line \
  "private-ip" "open 192.168.1.20:8080/status now" 5 \
  "http://192.168.1.20:8080/status"
_assert_follow_browser_word \
  "docker-host" "host.docker.internal:8080" \
  "http://host.docker.internal:8080"
_assert_follow_browser_word \
  "github-ssh-remote" "git@github.com:example/project.git" \
