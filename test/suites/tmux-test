: >"$browser_tty"
TMUX_FOLLOW_LOG="$tmp/uppercase-url-word-nvim.log" \
  TMUX="/tmp/tmux-test,1,0" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "" "HTTPS://example.com/from-word" "" 0 "/repo" "$browser_tty"
_assert_eq "tmux follow helper does not route uppercase URL words to nvim" \
