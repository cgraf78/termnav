_assert_contains "tmux follow helper asks WezTerm to open URL line fallback" \
  "SetUserVar=term_open_url=" "$(cat "$browser_tty")"

: >"$browser_tty"
TMUX_FOLLOW_LOG="$tmp/uppercase-url-line-nvim.log" \
  TMUX="/tmp/tmux-test,1,0" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "" "" "see HTTPS://example.com/from-line for details" 5 "/repo" "$browser_tty"
