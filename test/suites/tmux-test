  "https://www.rfc-editor.org/rfc/rfc9110"

extension_dir="$tmp/tmux-follow-extensions"
mkdir -p "$extension_dir"
cat >"$extension_dir/90-test.sh" <<'EOF'
# shellcheck shell=bash

tmux_follow_test_token() {
  local token="$1"

  if [[ "$token" == "EXT123" ]]; then
    target="https://example.test/EXT123"
    target_kind="url"
    return 0
  fi

  return 1
}

tmux_follow_register_token_detector tmux_follow_test_token
EOF
: >"$browser_tty"
TMUX_FOLLOW_LOG="$tmp/extension-url-nvim.log" \
  TERMNAV_TMUX_FOLLOW_EXTENSION_DIR="$extension_dir" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "" "EXT123" "" 0 "/repo" "$browser_tty"
_assert_eq "tmux follow helper extensions do not route URL tokens to nvim" \
  "" "$(cat "$tmp/extension-url-nvim.log" 2>/dev/null || true)"
_assert_contains "tmux follow helper extensions can open URL tokens" \
  "SetUserVar=term_open_url=" "$(cat "$browser_tty")"

xdg_home="$tmp/xdg"
mkdir -p "$xdg_home/termnav/tmux-follow/extensions.d"
cat >"$xdg_home/termnav/tmux-follow/extensions.d/90-test.sh" <<'EOF'
