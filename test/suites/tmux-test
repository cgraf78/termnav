cat >"$mock_bin/tmux" <<'EOF'
#!/usr/bin/env bash
if [[ "$1" == "capture-pane" ]]; then
  joined=0
  for arg in "$@"; do
    [[ "$arg" == "-J" ]] && joined=1
  done
  case "${TMUX_CAPTURE_FIXTURE:-}" in
    two-line-path)
      if [[ "$joined" -eq 1 ]]; then
        printf 'prefix /very/long/path/file.cpp:123:45 suffix\n'
      else
        printf 'prefix /very/long/\npath/file.cpp:123:45 suffix\n'
      fi
      exit 0
      ;;
    three-line-path)
      if [[ "$joined" -eq 1 ]]; then
        printf 'see src/generated/deep/tree/file.rs:77 now\n'
      else
        printf 'see src/generated/\ndeep/tree/\nfile.rs:77 now\n'
      fi
      exit 0
      ;;
    quoted-space-path)
      if [[ "$joined" -eq 1 ]]; then
        printf "open './project dir/src/file with spaces.cpp:12' please\n"
      else
        printf "open './project dir/src/\nfile with spaces.cpp:12' please\n"
      fi
      exit 0
      ;;
    wrapped-shell-path)
      if [[ "$joined" -eq 1 ]]; then
        printf "==> Done! Run 'source ~/.bashrc' or 'source ~/.zshrc' to activate.\n"
      else
        printf "==> Done! Run 'source ~/.b\nashrc' or 'source ~/.zshrc' to activate.\n"
      fi
      exit 0
      ;;
    wrapped-url)
      if [[ "$joined" -eq 1 ]]; then
        printf 'see https://example.com/very/long/path?q=1 now\n'
      else
        printf 'see https://example.com/very/\nlong/path?q=1 now\n'
      fi
      exit 0
      ;;
  esac
fi
exit 1
EOF
