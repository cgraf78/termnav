#!/usr/bin/env bash
# tmux-test — checks tmux config syntax, key bindings, and terminal features.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

tmux_follow_helper="$TERMNAV_ROOT/bin/tmux-follow-click"

echo "=== termnav shell API ==="

shell_api_output=$(
  TERMNAV_ROOT="$TERMNAV_ROOT" bash --noprofile --norc -c '
    source "$TERMNAV_ROOT/share/termnav/shell.sh"
    declare -F _termnav_wezterm_publish_link_context >/dev/null && echo publish
    declare -F _termnav_wezterm_precmd >/dev/null && echo precmd
  '
)
_assert_contains "shell api: exposes WezTerm context publisher" \
  "publish" "$shell_api_output"
_assert_contains "shell api: exposes prompt hook callback" \
  "precmd" "$shell_api_output"

echo "=== tmux Ctrl-click helper ==="

tmp=$(_tmpdir)
mock_bin="$tmp/bin"
mkdir -p "$mock_bin"
cat >"$mock_bin/nvim-tmux-open" <<'EOF'
#!/usr/bin/env bash
for arg in "$@"; do
  printf '<%s>\n' "$arg"
done >>"$TMUX_FOLLOW_LOG"
EOF
chmod +x "$mock_bin/nvim-tmux-open"

shared_route_fixture="$TERMNAV_TEST_DIR/fixtures/nvim-link-routes.tsv"
_assert_contains "tmux follow helper has shared route contract fixture" \
  "remote-file" "$(cat "$shared_route_fixture" 2>/dev/null || true)"

while IFS=$'\t' read -r case_name uri target cwd source context; do
  [[ -n "$case_name" && "$case_name" != \#* ]] || continue
  [[ "$context" == "-" ]] && context=""
  log_file="$tmp/shared-$case_name.log"
  if [[ -n "$context" ]]; then
    expected="$(printf '<tmux-link>\n<%s>\n<%s>\n<%s>\n<%s>' "$target" "$cwd" "$source" "$context")"
  else
    expected="$(printf '<tmux-link>\n<%s>\n<%s>\n<%s>' "$target" "$cwd" "$source")"
  fi
  TMUX_FOLLOW_LOG="$log_file" \
    PATH="$mock_bin:$PATH" \
    "$tmux_follow_helper" "$uri" "" "" 0 "$cwd"
  _assert_eq "tmux follow helper shared route: $case_name" "$expected" "$(cat "$log_file")"
done <"$shared_route_fixture"

TMUX_FOLLOW_LOG="$tmp/file-uri.log" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "file://localhost/tmp/a%20b.txt:4:5" "" "" 0 "/repo"
expected="$(printf '<tmux-link>\n<%s>\n<%s>\n<%s>' "/tmp/a b.txt:4:5" "/repo" "terminal")"
_assert_eq "tmux follow helper decodes file hyperlinks" "$expected" "$(cat "$tmp/file-uri.log")"

TMUX_FOLLOW_LOG="$tmp/remote-file-uri.log" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "file://remote.example/tmp/a%20b.txt:4:5" "" "" 0 "/repo"
expected="$(printf '<tmux-link>\n<%s>\n<%s>\n<%s>\n<%s>' "/tmp/a b.txt:4:5" "/repo" "remote" "remote.example")"
_assert_eq "tmux follow helper preserves remote file hyperlink hosts" "$expected" "$(cat "$tmp/remote-file-uri.log")"

TMUX_FOLLOW_LOG="$tmp/remote-alias-file-uri.log" \
  TERMNAV_REMOTE_LINK_HOST="dev1" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "file://dev1/tmp/a%20b.txt:4:5" "" "" 0 "/repo"
expected="$(printf '<tmux-link>\n<%s>\n<%s>\n<%s>' "/tmp/a b.txt:4:5" "/repo" "terminal")"
_assert_eq "tmux follow helper treats published remote alias as local" "$expected" "$(cat "$tmp/remote-alias-file-uri.log")"

TMUX_FOLLOW_LOG="$tmp/nvim-open-uri.log" \
  PATH="$mock_bin:$PATH" \
  "$tmux_follow_helper" "nvim-open://src/main.lua:12" "" "" 0 "/repo"
expected="$(printf '<tmux-link>\n<%s>\n<%s>\n<%s>' "src/main.lua:12" "/repo" "terminal")"
_assert_eq "tmux follow helper accepts nvim-open hyperlinks" "$expected" "$(cat "$tmp/nvim-open-uri.log")"

browser_tty="$tmp/browser-tty.out"
mock_tmux="$mock_bin/tmux"
cat >"$mock_tmux" <<EOF
#!/usr/bin/env bash
if [[ "\$1 \$2 \$3" == "display-message -p #{client_tty}" ]]; then
  printf '%s\n' '$browser_tty'
  exit 0
fi
exit 1
EOF
chmod +x "$mock_tmux"
_follow_opened_url() {
  local encoded decoded

  encoded=$(tr -d '\033\007' <"$browser_tty" |
    sed -n 's/.*SetUserVar=term_open_url=\([A-Za-z0-9+\/=]*\).*/\1/p' |
    tail -1)
  [ -n "$encoded" ] || return 0
  if decoded=$(printf '%s' "$encoded" | base64 -d 2>/dev/null); then
    printf '%s\n' "$decoded"
    return 0
  fi
  if decoded=$(printf '%s' "$encoded" | base64 -D 2>/dev/null); then
    printf '%s\n' "$decoded"
  fi
}
_assert_follow_browser_word() {
  local label="$1" token="$2" expected_url="$3"

  : >"$browser_tty"
  TMUX_FOLLOW_LOG="$tmp/$label-word-nvim.log" \
    TMUX="/tmp/tmux-test,1,0" \
    PATH="$mock_bin:$PATH" \
    "$tmux_follow_helper" "" "$token" "" 0 "/repo" "$browser_tty"
  _assert_eq "tmux follow helper does not route $label words to nvim" \
    "" "$(cat "$tmp/$label-word-nvim.log" 2>/dev/null || true)"
  _assert_eq "tmux follow helper opens $label words as browser URLs" \
    "$expected_url" "$(_follow_opened_url)"
}
_assert_follow_browser_line() {
  local label="$1" line="$2" x="$3" expected_url="$4"

  : >"$browser_tty"
  TMUX_FOLLOW_LOG="$tmp/$label-line-nvim.log" \
    TMUX="/tmp/tmux-test,1,0" \
    PATH="$mock_bin:$PATH" \
    "$tmux_follow_helper" "" "" "$line" "$x" "/repo" "$browser_tty"
  _assert_eq "tmux follow helper does not route $label line fallback to nvim" \
    "" "$(cat "$tmp/$label-line-nvim.log" 2>/dev/null || true)"
  _assert_eq "tmux follow helper opens $label line fallback as browser URLs" \
    "$expected_url" "$(_follow_opened_url)"
}
