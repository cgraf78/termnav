#!/usr/bin/env bash
# tmux-test — native tmux integration without historical executable facades.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

termnav=${TERMNAV_TEST_BINARY:-$TERMNAV_ROOT/target/release/termnav}

echo "=== termnav shell API ==="

shell_api_output=$(
  TERMNAV_ROOT="$TERMNAV_ROOT" bash --noprofile --norc -c '
    source "$TERMNAV_ROOT/share/termnav/shell.sh"
    declare -F _termnav_wezterm_publish_link_context >/dev/null && echo publish
    declare -F _termnav_wezterm_precmd >/dev/null && echo precmd
  '
)
_assert_contains "shell api: exposes WezTerm context publisher" \
  "publish" "$shell_api_output"
_assert_contains "shell api: exposes prompt hook callback" \
  "precmd" "$shell_api_output"

echo "=== native nvim tmux opener ==="

tmp=$(_tmpdir)
mock_bin="$tmp/bin"
mkdir -p "$mock_bin"
cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
case "$1" in
  list-panes)
    printf '%%1\tbash\n%%2\tnvim\n'
    ;;
  send-keys)
    printf '%s\n' "$*" >>"${TERMNAV_TMUX_TEST_LOG:?}"
    ;;
  *)
    exit 1
    ;;
esac
MOCK
chmod +x "$mock_bin/tmux"

log="$tmp/tmux.log"
TMUX="/tmp/termnav-test.sock,1,0" \
  TMUX_PANE=%1 \
  PATH="$mock_bin:$PATH" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  "$termnav" nvim open cli 'a/src/app.lua:12' /repo
_assert_exit "native opener: current-window pane opens" 0 "$?"
_assert_contains "native opener: targets the nvim pane" \
  'send-keys -t %2 -l' "$(cat "$log")"
_assert_contains "native opener: preserves CLI-like file arguments verbatim" \
  'fnameescape("/repo/a/src/app.lua:12")' "$(cat "$log")"
_assert_contains "native opener: leaves cursor parsing to an existing target" \
  'cursor(1,1)' "$(cat "$log")"

cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${TERMNAV_TMUX_TEST_LOG:?}"
case "$1" in
  list-panes) printf '%%1\tbash\n' ;;
  display-popup) printf '%s\n' "${@: -1}" >>"${TERMNAV_TMUX_TEST_LOG:?}" ;;
  *) exit 1 ;;
esac
MOCK
chmod +x "$mock_bin/tmux"

log="$tmp/missing.log"
TMUX="/tmp/termnav-test.sock,1,0" \
  TMUX_PANE=%1 \
  PATH="$mock_bin:/usr/bin:/bin" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  "$termnav" nvim open tmux-link /home/alex/.zshrc '' remote remote.example \
  >/dev/null 2>&1
_assert_exit "native opener: missing remote session is user-facing success" 0 "$?"
_assert_contains "native opener: remote diagnostic names the host" \
  'No nvim session found for remote.example: /home/alex/.zshrc' "$(cat "$log")"

remote_helper="$tmp/remote-open-helper"
remote_helper_log="$tmp/remote-open-helper.log"
cat >"$remote_helper" <<'MOCK'
#!/bin/sh
printf '<%s>\n' "$@" >"${TERMNAV_REMOTE_OPEN_TEST_LOG:?}"
MOCK
chmod +x "$remote_helper"

# A configured transport is the explicit fallback when this installation has
# no usable OpenSSH binary. Keep PATH free of ssh entirely: this regression is
# about the local transport being definitively unavailable, not a remote mux
# failure after an SSH request may already have started.
no_ssh_bin="$tmp/no-ssh-bin"
mkdir -p "$no_ssh_bin"
: >"$remote_helper_log"
PATH="$no_ssh_bin" \
  TERMNAV_SSH_CONTROL_HOSTS=remote.example \
  TERMNAV_REMOTE_OPEN_HELPER="$remote_helper" \
  TERMNAV_REMOTE_OPEN_TEST_LOG="$remote_helper_log" \
  "$termnav" nvim open link /home/alex/.zshrc '' remote remote.example \
  tmux /tmp/termnav-test.sock %9
_assert_exit "native opener: unavailable OpenSSH falls back to configured transport" 0 "$?"
_assert_eq "native opener: unavailable OpenSSH preserves exact route identity" \
  $'<tmux>\n</tmp/termnav-test.sock>\n<%9>\n<remote.example>\n</home/alex/.zshrc>' \
  "$(cat "$remote_helper_log")"

: >"$remote_helper_log"
PATH="$no_ssh_bin" \
  TERMNAV_SSH_CONTROL_HOSTS=remote.example \
  TERMNAV_REMOTE_OPEN_HELPER="$remote_helper" \
  TERMNAV_REMOTE_OPEN_TEST_LOG="$remote_helper_log" \
  "$termnav" nvim open link /home/alex/.zshrc '' remote remote.example \
  wezterm '' 17
_assert_exit "native opener: ambiguous WezTerm route fails closed" 1 "$?"
_assert_eq "native opener: ambiguous WezTerm route never invokes helper" \
  "" "$(cat "$remote_helper_log")"

: >"$log"
TMUX="/tmp/termnav-test.sock,1,0" \
  TMUX_PANE=%1 \
  PATH="$mock_bin:/usr/bin:/bin" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  TERMNAV_REMOTE_OPEN_HELPER="$remote_helper" \
  TERMNAV_REMOTE_OPEN_TEST_LOG="$remote_helper_log" \
  "$termnav" tmux follow-click --stdin <<'EOF'
file://remote.example/home/alex/.zshrc


0
/home/alex
/dev/pts/9
%9
0
0
0
/tmp/termnav-test.sock
EOF
_assert_exit "native opener: configured remote route succeeds" 0 "$?"
# File URIs keep filename provenance; old transport helpers receive explicit
# coordinates so numeric colon suffixes cannot become location syntax.
_assert_eq "native opener: configured route receives host target and exact clicked pane" \
  $'<tmux>\n</tmp/termnav-test.sock>\n<%9>\n<remote.example>\n</home/alex/.zshrc:1:0>' \
  "$(cat "$remote_helper_log")"
_assert_not_contains "native opener: configured route never scans or types into another pane" \
  'list-panes' "$(cat "$log")"
_assert_not_contains "native opener: configured route never injects tmux prefix keys" \
  'send-keys' "$(cat "$log")"

# A click carries its exact server socket. Capture must use it even when this
# process inherited a stale TMUX value from an outer or earlier session.
cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${TERMNAV_TMUX_TEST_LOG:?}"
if [[ $1 == -S && $2 == "$TERMNAV_CLICK_SOCKET" && $3 == capture-pane ]]; then
  printf 'https://zellij.dev/features/\n'
  exit 0
fi
exit 1
MOCK
cat >"$tmp/browser" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$1" >"${TERMNAV_BROWSER_TEST_LOG:?}"
MOCK
chmod +x "$mock_bin/tmux" "$tmp/browser"
log="$tmp/capture.log"
browser_log="$tmp/browser.log"
: >"$log"
TMUX="/tmp/stale-termnav-test.sock,1,0" \
  PATH="$mock_bin:/usr/bin:/bin" \
  BROWSER="$tmp/browser" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  TERMNAV_CLICK_SOCKET="$tmp/click.sock" \
  TERMNAV_BROWSER_TEST_LOG="$browser_log" \
  "$termnav" tmux follow-click --stdin <<EOF



8
/tmp

%9
0
12
186
$tmp/click.sock
EOF
_assert_exit "native click: exact socket capture succeeds" 0 "$?"
_assert_eq "native click: captured URL reaches browser fallback" \
  'https://zellij.dev/features/' "$(cat "$browser_log" 2>/dev/null)"
_assert_contains "native click: capture targets clicked server" \
  "-S $tmp/click.sock capture-pane" "$(cat "$log")"

# A stale outer tmux server must not claim a file URI's remote host as local.
# The clicked server publishes a different link host, so the exact socket is
# authoritative for host classification as well as pane capture.
cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${TERMNAV_TMUX_TEST_LOG:?}"
if [[ $1 == -S && $2 == "$TERMNAV_CLICK_SOCKET" && $3 == show-environment ]]; then
  printf 'TERMNAV_REMOTE_LINK_HOST=other.example\n'
  exit 0
fi
if [[ $1 == show-environment ]]; then
  printf 'TERMNAV_REMOTE_LINK_HOST=remote.example\n'
  exit 0
fi
exit 1
MOCK
chmod +x "$mock_bin/tmux"
cat >"$mock_bin/ssh" <<'MOCK'
#!/usr/bin/env bash
exit 1
MOCK
chmod +x "$mock_bin/ssh"
log="$tmp/link-host.log"
: >"$log"
: >"$remote_helper_log"
TMUX="/tmp/stale-termnav-test.sock,1,0" \
  PATH="$mock_bin:$PATH" \
  TERMNAV_TMUX_TEST_LOG="$log" \
  TERMNAV_CLICK_SOCKET="$tmp/click.sock" \
  TERMNAV_SSH_CONTROL_HOSTS=remote.example \
  TERMNAV_REMOTE_OPEN_HELPER="$remote_helper" \
  TERMNAV_REMOTE_OPEN_TEST_LOG="$remote_helper_log" \
  env -u TERMNAV_REMOTE_LINK_HOST "$termnav" tmux follow-click --stdin <<EOF
file://remote.example/home/alex/.zshrc


0
/home/alex

%9
0
0
0
$tmp/click.sock
EOF
_assert_exit "native click: remote URI classification succeeds" 0 "$?"
_assert_eq "native click: stale outer host stays remote" \
  $'<tmux>\n<'"$tmp/click.sock"$'>\n<%9>\n<remote.example>\n</home/alex/.zshrc:1:0>' \
  "$(cat "$remote_helper_log")"
_assert_contains "native click: link host comes from clicked server" \
  "-S $tmp/click.sock show-environment" "$(cat "$log")"

# A stalled tmux server cannot hold a file-link gesture indefinitely. The
# outer deadline also reaps the pre-fix process group during the red test.
cat >"$mock_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
if [[ " $* " == *" show-environment "* ]]; then
  exec sleep 30
fi
exit 1
MOCK
chmod +x "$mock_bin/tmux"
timeout_result=$(
  TMUX="/tmp/stale-termnav-test.sock,1,0" \
    PATH="$mock_bin:$PATH" \
    TERMNAV_SSH_CONTROL_HOSTS=remote.example \
    TERMNAV_REMOTE_OPEN_HELPER="$remote_helper" \
    TERMNAV_REMOTE_OPEN_TEST_LOG="$remote_helper_log" \
    env -u TERMNAV_REMOTE_LINK_HOST python3 - "$termnav" "$tmp/click.sock" <<'PY'
import os
import signal
import subprocess
import sys

payload = f"file://remote.example/home/alex/.zshrc\n\n\n0\n/home/alex\n\n%9\n0\n0\n0\n{sys.argv[2]}\n"
process = subprocess.Popen(
    [sys.argv[1], "tmux", "follow-click", "--stdin"],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    start_new_session=True,
    env=os.environ,
)
try:
    _, stderr = process.communicate(payload.encode(), timeout=3)
except subprocess.TimeoutExpired:
    os.killpg(process.pid, signal.SIGKILL)
    process.communicate()
    raise SystemExit("file-link click exceeded three seconds")
if process.returncode != 0:
    raise SystemExit(f"file-link click failed: {stderr.decode(errors='replace')}")
print("bounded")
PY
)
_assert_eq "native click: stalled link-host lookup is bounded" \
  bounded "$timeout_result"

cat >"$mock_bin/ssh" <<'MOCK'
#!/usr/bin/env bash
if [[ "${1:-}" == -G ]]; then
  printf 'controlpath /tmp/termnav-existing-master\n'
  exit 0
fi
printf '%s\n' "$$" >"${TERMNAV_TIMEOUT_CHILD_PID:?}"
exec sleep 30
MOCK
cat >"$mock_bin/nvim" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$$" >"${TERMNAV_TIMEOUT_CHILD_PID:?}"
exec sleep 30
MOCK
cat >"$tmp/hanging-remote-open-helper" <<'MOCK'
#!/usr/bin/env bash
sleep 30 &
printf '%s %s\n' "$$" "$!" >"${TERMNAV_TIMEOUT_CHILD_PID:?}"
wait
MOCK
chmod +x "$mock_bin/ssh" "$mock_bin/nvim" "$tmp/hanging-remote-open-helper"

# These are real process-lifecycle checks rather than mocked call assertions.
# The outer deadline only prevents a pre-fix test run from wedging forever;
# Termnav must return first and must leave no helper PID alive.
python3 - "$termnav" "$mock_bin" "$tmp" <<'PY'
import os
import signal
import socket
import subprocess
import sys
import time

termnav, mock_bin, root = sys.argv[1:]

def run_bounded(arguments, pid_file, extra_env):
    env = os.environ.copy()
    env.update(extra_env)
    env["PATH"] = mock_bin + ":/usr/bin:/bin"
    env["TERMNAV_TIMEOUT_CHILD_PID"] = pid_file
    started = time.monotonic()
    process = subprocess.Popen([termnav, *arguments], env=env, start_new_session=True)
    try:
        code = process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
        raise SystemExit(f"unbounded child execution: {' '.join(arguments)}")
    if time.monotonic() - started >= 4:
        raise SystemExit(f"child deadline was not enforced: {' '.join(arguments)}")
    if code == 0:
        raise SystemExit(f"timed-out child unexpectedly succeeded: {' '.join(arguments)}")
    with open(pid_file, encoding="utf-8") as stream:
        child_pids = [int(value) for value in stream.read().split()]

    def process_running(pid):
        # kill(pid, 0) also succeeds for a zombie. Container PID 1 processes
        # do not consistently reap orphaned fixture grandchildren promptly, so
        # treating that already-dead state as running makes the lifecycle test
        # depend on the CI image rather than Termnav's process-group cleanup.
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8") as stream:
                stat = stream.read()
            state = stat[stat.rfind(")") + 2 :].split(maxsplit=1)[0]
            return state != "Z"
        except (FileNotFoundError, OSError, IndexError):
            pass
        try:
            result = subprocess.run(
                ["ps", "-o", "stat=", "-p", str(pid)],
                check=False,
                capture_output=True,
                text=True,
                timeout=1,
            )
            state = result.stdout.strip()
            return result.returncode == 0 and bool(state) and not state.startswith("Z")
        except (OSError, subprocess.TimeoutExpired):
            try:
                os.kill(pid, 0)
                return True
            except ProcessLookupError:
                return False

    deadline = time.monotonic() + 1
    while True:
        running = [child_pid for child_pid in child_pids if process_running(child_pid)]
        if not running:
            return
        if time.monotonic() >= deadline:
            raise SystemExit(f"timed-out child processes remain running: {running}")
        time.sleep(0.01)

run_bounded(
    ["nvim", "ssh-open", "remote.example", "/tmp/file.lua:1"],
    root + "/ssh-child.pid",
    {"TERMNAV_SSH_CONTROL_HOSTS": "remote.example"},
)

run_bounded(
    [
        "nvim", "open", "link", "/tmp/file.lua:1", "", "remote",
        "remote.example", "wezterm", "/tmp/wezterm-exact.sock", "17",
    ],
    root + "/remote-helper-child.pid",
    {"TERMNAV_REMOTE_OPEN_HELPER": root + "/hanging-remote-open-helper"},
)

socket_path = root + "/nvim.sock"
server = socket.socket(socket.AF_UNIX)
server.bind(socket_path)
try:
    run_bounded(
        ["nvim", "open", "link", "/tmp/file.lua:1", "", "nvim", socket_path],
        root + "/nvim-child.pid",
        {},
    )
finally:
    server.close()
PY
_assert_exit "native opener: SSH and nvim process groups are bounded and stopped" 0 "$?"

_test_summary
