#!/usr/bin/env bash
# wezterm-integration-test — checks for WezTerm protocol integration details.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"
adapter_dir=$(_tmpdir)
termnav=${TERMNAV_TEST_BINARY:-$TERMNAV_ROOT/target/release/termnav}
helper=${TERMNAV_NVIM_OPEN_HELPER:-$adapter_dir/nvim-tmux-open}
eza_linker=${TERMNAV_EZA_LINKER:-$adapter_dir/eza-nvim-links}
tmux_context=${TERMNAV_TMUX_CONTEXT:-$adapter_dir/termnav-tmux-context}
_termnav_command_adapter "$helper" "$termnav" nvim open
_termnav_command_adapter "$eza_linker" "$termnav" eza
_termnav_command_adapter "$tmux_context" "$termnav" tmux context
public_link_rules="$TERMNAV_ROOT/lib/termnav/wezterm/public-link-rules.lua"
nvim_setup="$TERMNAV_ROOT/lib/termnav/nvim/setup.lua"
wezterm_routes="$TERMNAV_ROOT/lib/termnav/wezterm/link-routes.lua"

_run_lua() {
  if command -v lua >/dev/null 2>&1; then
    lua "$@"
    return
  fi
  if command -v nvim >/dev/null 2>&1; then
    # Neovim's -l mode writes Lua print() output to stderr, unlike standalone
    # lua. Capture both streams in callers for stable assertions.
    nvim --headless -u NONE -n -l "$@" 2>&1
    return
  fi
  return 127
}

_nvim_test_pane_key() {
  local pane=$1 tmux_value=${TMUX:-} tmux_fields tmux_socket tmux_pid key
  local chunk first=1

  tmux_fields=${tmux_value%,*}
  if [[ $tmux_fields == "$tmux_value" || $tmux_fields != *,* ]]; then
    tmux_socket=$tmux_value
    tmux_pid=
  else
    tmux_socket=${tmux_fields%,*}
    tmux_pid=${tmux_fields##*,}
  fi
  key=$(printf '%s\0%s\0%s' "$tmux_socket" "$tmux_pid" "$pane" |
    LC_ALL=C od -An -tx1 -v | tr -d ' \n') || return 1
  while [[ -n $key ]]; do
    chunk=${key:0:120}
    key=${key:120}
    if [[ $first == 1 ]]; then
      printf 'v1-%s' "$chunk"
      first=0
    else
      printf '/%s' "$chunk"
    fi
  done
  printf '\n'
}

echo "=== unified executable entry points ==="

mock_bin=$(_tmpdir)/mock-bin
mkdir -p "$mock_bin"
cat >"$mock_bin/eza" <<'EOF'
#!/usr/bin/env bash
if [[ "${EZA_MOCK_LEGACY:-0}" = 1 && "$*" == "--hyperlink=always --version" ]]; then
  exit 3
fi
printf 'eza'
for arg in "$@"; do
  printf ' <%s>' "$arg"
done
printf '\n'
EOF
chmod +x "$mock_bin/eza"
set +e
symlink_usage=$("$termnav" nvim open 2>&1)
symlink_rc=$?
_assert_exit "nvim open: validates its mode" 2 "$symlink_rc"
_assert_contains "nvim open: usage comes from the unified binary" \
  "usage: termnav nvim" "$symlink_usage"

symlink_eza=$(PATH="$mock_bin:$PATH" "$termnav" eza --all)
_assert_eq "eza: unified command renders hyperlink output" \
  "eza <--hyperlink=always> <--all>" "$symlink_eza"

legacy_eza=$(
  EZA_MOCK_LEGACY=1 \
    PATH="$mock_bin:$PATH" \
    "$termnav" eza /tmp/listed
)
_assert_eq "eza: falls back for legacy eza" \
  "eza <--hyperlink> </tmp/listed>" "$legacy_eza"

link_host=$(TERMNAV_REMOTE_LINK_HOST=remote.example "$termnav" link-host)
_assert_eq "termnav link-host resolves explicit remote context" \
  "remote.example" "$link_host"

set +e
symlink_tmux_context_usage=$("$termnav" tmux context --help 2>&1)
symlink_tmux_context_rc=$?
_assert_exit "tmux context: help exits successfully" 0 \
  "$symlink_tmux_context_rc"
_assert_contains "tmux context: help comes from the unified binary" \
  "usage: termnav tmux context" "$symlink_tmux_context_usage"

echo
echo "=== WezTerm metadata user-var helpers ==="

tab_tty=$(_tmpdir)/tab-tty
: >"$tab_tty"

"$tmux_context" --tty "$tab_tty" --client-termname xterm-256color \
  --control-mode 0
direct_tmux_context=$(cat "$tab_tty")
_assert_eq "termnav-tmux-context direct: publishes tmux ownership" \
  $'\033]1337;SetUserVar=TERMNAV_TMUX=dHJ1ZQ==\007' "$direct_tmux_context"

: >"$tab_tty"
"$tmux_context" --tty "$tab_tty" --client-termname tmux-256color \
  --control-mode 0
nested_tmux_context=$(cat "$tab_tty")
_assert_eq "termnav-tmux-context nested: escapes one parent tmux" \
  $'\033Ptmux;\033\033]1337;SetUserVar=TERMNAV_TMUX=dHJ1ZQ==\007\033\\' \
  "$nested_tmux_context"

: >"$tab_tty"
"$tmux_context" --tty "$tab_tty" --client-termname screen-256color \
  --control-mode 0
legacy_tmux_context=$(cat "$tab_tty")
_assert_eq "termnav-tmux-context nested: accepts tmux screen terminfo" \
  "$nested_tmux_context" "$legacy_tmux_context"

: >"$tab_tty"
"$tmux_context" --tty "$tab_tty" --client-termname xterm-256color \
  --control-mode 1
_assert_eq "termnav-tmux-context: skips tmux control-mode clients" \
  "" "$(cat "$tab_tty")"

"$tmux_context" --control-mode 1
_assert_exit "termnav-tmux-context: control mode needs no terminal metadata" 0 "$?"

missing_tmux_context_tty_rc=0
"$tmux_context" --client-termname xterm-256color >/dev/null 2>&1 ||
  missing_tmux_context_tty_rc=$?
_assert_exit "termnav-tmux-context: requires the target client tty" 2 \
  "$missing_tmux_context_tty_rc"

missing_tmux_context_term_rc=0
"$tmux_context" --tty "$tab_tty" >/dev/null 2>&1 ||
  missing_tmux_context_term_rc=$?
_assert_exit "termnav-tmux-context: requires the client terminal name" 2 \
  "$missing_tmux_context_term_rc"

invalid_tmux_control_mode_rc=0
"$tmux_context" --tty "$tab_tty" --client-termname xterm-256color \
  --control-mode invalid >/dev/null 2>&1 || invalid_tmux_control_mode_rc=$?
_assert_exit "termnav-tmux-context: rejects invalid control mode" 2 \
  "$invalid_tmux_control_mode_rc"

shell_vars="$TERMNAV_ROOT/lib/termnav/shell/wezterm-vars.sh"
shell_tmux_mock=$(_tmpdir)/mock-bin
shell_tmux_log=$(_tmpdir)/tmux-queries.log
mkdir -p "$shell_tmux_mock"
cat >"$shell_tmux_mock/tmux" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${TERMNAV_TMUX_QUERY_LOG:-/dev/null}"
if [[ "$*" == "show-environment -g TERMNAV_REMOTE_LINK_HOST" ]]; then
  if [[ -n "${TMUX_MOCK_REMOTE_LINK_HOST:-}" ]]; then
    printf 'TERMNAV_REMOTE_LINK_HOST=%s\n' "$TMUX_MOCK_REMOTE_LINK_HOST"
    exit 0
  fi
  exit 1
fi
if [[ "${1:-}" == "display-message" && "$*" == *'; show-environment -g TERMNAV_REMOTE_LINK_HOST' ]]; then
  if [[ "${TMUX_MOCK_DISPLAY_FAIL:-0}" == 1 ]]; then
    exit 1
  fi
  if [[ "${TMUX_MOCK_DISPLAY_EMPTY:-0}" == 1 ]]; then
    exit 0
  fi
  printf 't%s\n' "${TMUX_MOCK_TERMNAME:-tmux-256color}"
  if [[ -n "${TMUX_MOCK_REMOTE_LINK_HOST:-}" ]]; then
    printf 'TERMNAV_REMOTE_LINK_HOST=%s\n' "$TMUX_MOCK_REMOTE_LINK_HOST"
    exit 0
  fi
  exit 1
fi
if [[ "${TMUX_MOCK_DISPLAY_FAIL:-0}" == 1 ]]; then
  exit 1
fi
if [[ "${TMUX_MOCK_DISPLAY_EMPTY:-0}" == 1 ]]; then
  exit 0
fi
printf '%s\n' "${TMUX_MOCK_TERMNAME:-tmux-256color}"
EOF
chmod +x "$shell_tmux_mock/tmux"
cat >"$shell_tmux_mock/hostname" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${TERMNAV_HOSTNAME_QUERY_LOG:-/dev/null}"
printf '%s\n' "${TERMNAV_HOSTNAME_MOCK_VALUE:-remote.example}"
EOF
chmod +x "$shell_tmux_mock/hostname"
shell_auto_nested=$(
  TMUX=/tmp/tmux-test,1,0 PATH="$shell_tmux_mock:$PATH" bash -c \
    ". '$shell_vars'; termnav_wezterm_user_var_sequence DOT_SWITCH_TAB next auto"
)
shell_auto_count=$(printf '%s' "$shell_auto_nested" | python3 -c 'import sys; data=sys.stdin.buffer.read(); print(data.count(b"\x1bPtmux;"))')
_assert_eq "shell wezterm vars: auto double-wraps nested tmux clients" \
  "2" "$shell_auto_count"

: >"$shell_tmux_log"
TMUX=/tmp/tmux-one,1,0 \
  TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
  PATH="$shell_tmux_mock:$PATH" \
  SHELL_VARS="$shell_vars" \
  bash --noprofile --norc -c '
    source "$SHELL_VARS"
    termnav_wezterm_user_var_sequence TEST first auto >/dev/null
    termnav_wezterm_user_var_sequence TEST second auto >/dev/null
    TMUX=/tmp/tmux-two,1,0
    termnav_wezterm_user_var_sequence TEST third auto >/dev/null
    source "$SHELL_VARS"
    termnav_wezterm_user_var_sequence TEST fourth auto >/dev/null
  '
shell_tmux_query_count=$(wc -l <"$shell_tmux_log" | tr -d ' ')
_assert_eq "shell wezterm vars: caches client query within TTL and invalidates on context changes" \
  "3" "$shell_tmux_query_count"

: >"$shell_tmux_log"
shell_tmux_refresh=$(
  TMUX=/tmp/tmux-client-refresh,1,0 \
    TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
    PATH="$shell_tmux_mock:$PATH" \
    SHELL_VARS="$shell_vars" \
    bash --noprofile --norc -c '
      SECONDS=100
      source "$SHELL_VARS"
      if termnav_wezterm_tmux_client_is_nested; then echo initial=nested; fi
      export TMUX_MOCK_TERMNAME=xterm-256color
      SECONDS=104
      if termnav_wezterm_tmux_client_is_nested; then echo warm=nested; fi
      SECONDS=106
      if termnav_wezterm_tmux_client_is_nested; then
        echo expired=nested
      else
        echo expired=direct
      fi
    '
)
_assert_contains "shell wezterm vars: warm nested-client result stays cached" \
  "warm=nested" "$shell_tmux_refresh"
_assert_contains "shell wezterm vars: expired cache observes the attached client" \
  "expired=direct" "$shell_tmux_refresh"
_assert_eq "shell wezterm vars: client cache expiry performs one refresh query" \
  "2" "$(wc -l <"$shell_tmux_log" | tr -d ' ')"

for test_shell in bash zsh; do
  case "$test_shell" in
    bash) test_shell_command=(bash --noprofile --norc) ;;
    zsh) test_shell_command=(zsh -f) ;;
  esac

  test_clock_cases=(missing)
  if [[ "$test_shell" == bash ]]; then
    test_clock_cases+=(nonnumeric)
  fi
  for test_clock_case in "${test_clock_cases[@]}"; do
    : >"$shell_tmux_log"
    # shellcheck disable=SC2016 # Variables expand in the selected child shell.
    shell_clockless_refresh=$(
      TMUX=/tmp/tmux-clockless,1,0 \
        TERMNAV_CLOCK_CASE="$test_clock_case" \
        TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
        PATH="$shell_tmux_mock:$PATH" \
        SHELL_VARS="$shell_vars" \
        "${test_shell_command[@]}" -c '
          unset SECONDS
          if [[ "$TERMNAV_CLOCK_CASE" == nonnumeric ]]; then
            SECONDS=invalid
          fi
          source "$SHELL_VARS"
          if termnav_wezterm_tmux_client_is_nested; then echo initial=nested; fi
          export TMUX_MOCK_TERMNAME=xterm-256color
          if termnav_wezterm_tmux_client_is_nested; then
            echo refreshed=nested
          else
            echo refreshed=direct
          fi
        '
    )
    _assert_contains "shell wezterm vars: $test_shell $test_clock_case clock leaves client observations uncached" \
      "refreshed=direct" "$shell_clockless_refresh"
    _assert_eq "shell wezterm vars: $test_shell $test_clock_case clock repeats the client query" \
      "2" "$(wc -l <"$shell_tmux_log" | tr -d ' ')"
  done
done

: >"$shell_tmux_log"
TMUX=/tmp/tmux-recovery,1,0 \
  TMUX_MOCK_DISPLAY_FAIL=1 \
  TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
  PATH="$shell_tmux_mock:$PATH" \
  SHELL_VARS="$shell_vars" \
  bash --noprofile --norc -c '
    source "$SHELL_VARS"
    termnav_wezterm_user_var_sequence TEST failed auto >/dev/null
    unset TMUX_MOCK_DISPLAY_FAIL
    termnav_wezterm_user_var_sequence TEST recovered auto >/dev/null
  '
shell_tmux_recovery_count=$(wc -l <"$shell_tmux_log" | tr -d ' ')
_assert_eq "shell wezterm vars: failed nested-client query remains retryable" \
  "2" "$shell_tmux_recovery_count"

: >"$shell_tmux_log"
TMUX=/tmp/tmux-empty-recovery,1,0 \
  TMUX_MOCK_DISPLAY_EMPTY=1 \
  TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
  PATH="$shell_tmux_mock:$PATH" \
  SHELL_VARS="$shell_vars" \
  bash --noprofile --norc -c '
    source "$SHELL_VARS"
    termnav_wezterm_user_var_sequence TEST empty auto >/dev/null
    unset TMUX_MOCK_DISPLAY_EMPTY
    termnav_wezterm_user_var_sequence TEST recovered auto >/dev/null
  '
shell_tmux_empty_recovery_count=$(wc -l <"$shell_tmux_log" | tr -d ' ')
_assert_eq "shell wezterm vars: empty nested-client query remains retryable" \
  "2" "$shell_tmux_empty_recovery_count"

: >"$shell_tmux_log"
TMUX=/tmp/tmux-publish-recovery,1,0 \
  TMUX_MOCK_DISPLAY_FAIL=1 \
  TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
  PATH="$shell_tmux_mock:$PATH" \
  SHELL_INTEGRATION="$TERMNAV_ROOT/share/termnav/shell.sh" \
  bash --noprofile --norc -c '
    source "$SHELL_INTEGRATION" >/dev/null
    _termnav_wezterm_sent_NVIM_LINK_CWD=0
    _termnav_wezterm_tmux_client_cache_set=0
    : >"$TERMNAV_TMUX_QUERY_LOG"
    _termnav_wezterm_set_user_var NVIM_LINK_CWD /repo >/dev/null
    unset TMUX_MOCK_DISPLAY_FAIL
    _termnav_wezterm_set_user_var NVIM_LINK_CWD /repo >/dev/null
  '
_assert_eq "shell integration: failed publication does not commit the value cache" \
  "2" "$(wc -l <"$shell_tmux_log" | tr -d ' ')"

encoder_mock=$(_tmpdir)/encoder-bin
encoder_log=$(_tmpdir)/encoder.log
mkdir -p "$encoder_mock"
for encoder in base64 tr; do
  cat >"$encoder_mock/$encoder" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${0##*/}" >>"$TERMNAV_ENCODER_LOG"
EOF
  chmod +x "$encoder_mock/$encoder"
done
: >"$encoder_log"
TERMNAV_ENCODER_LOG="$encoder_log" \
  PATH="$encoder_mock:$PATH" \
  SHELL_VARS="$shell_vars" \
  bash --noprofile --norc -c '
    source "$SHELL_VARS"
    termnav_wezterm_base64 ""
  ' >/dev/null
_assert_eq "shell wezterm vars: empty values skip encoder subprocesses" \
  "" "$(cat "$encoder_log")"

shell_integration="$TERMNAV_ROOT/share/termnav/shell.sh"
for test_shell in bash zsh; do
  case "$test_shell" in
    bash) test_shell_command=(bash --noprofile --norc) ;;
    zsh) test_shell_command=(zsh -f) ;;
  esac

  : >"$shell_tmux_log"
  # shellcheck disable=SC2016 # Variables expand in the selected child shell.
  startup_publish_output=$(
    TMUX=/tmp/tmux-startup,1,0 \
      TMUX_MOCK_REMOTE_LINK_HOST=remote.example \
      TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
      PATH="$shell_tmux_mock:$PATH" \
      SHELL_INTEGRATION="$shell_integration" \
      "${test_shell_command[@]}" -c '
        SECONDS=100
        source "$SHELL_INTEGRATION" >/dev/null
        printf "loaded=%s\n" "${TERMNAV_SHELL_LOADED:-}"
        printf "queries=%s\n" "$(wc -l <"$TERMNAV_TMUX_QUERY_LOG" | tr -d " ")"
        printf "host=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"
      '
  )
  _assert_contains "shell integration: $test_shell loads the real provider" \
    "loaded=1" "$startup_publish_output"
  _assert_contains "shell integration: $test_shell startup shares one tmux context query" \
    "queries=1" "$startup_publish_output"
  _assert_contains "shell integration: $test_shell shared startup query publishes global remote host" \
    "host=remote.example" "$startup_publish_output"
  _assert_contains "shell integration: $test_shell shared startup query reads global tmux environment" \
    "show-environment -g TERMNAV_REMOTE_LINK_HOST" "$(cat "$shell_tmux_log")"

  for query_result in failure empty; do
    : >"$shell_tmux_log"
    case "$query_result" in
      failure) query_fail=1 query_empty=0 ;;
      empty) query_fail=0 query_empty=1 ;;
    esac
    # shellcheck disable=SC2016 # Variables expand in the selected child shell.
    startup_recovery_output=$(
      TMUX=/tmp/tmux-startup-recovery,1,0 \
        TMUX_MOCK_DISPLAY_FAIL="$query_fail" \
        TMUX_MOCK_DISPLAY_EMPTY="$query_empty" \
        TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
        PATH="$shell_tmux_mock:$PATH" \
        SHELL_INTEGRATION="$shell_integration" \
        "${test_shell_command[@]}" -c '
          SECONDS=100
          source "$SHELL_INTEGRATION" >/dev/null
          printf "initial=%s\n" "$(wc -l <"$TERMNAV_TMUX_QUERY_LOG" | tr -d " ")"

          unset TMUX_MOCK_DISPLAY_FAIL TMUX_MOCK_DISPLAY_EMPTY
          export TMUX_MOCK_REMOTE_LINK_HOST=remote.example
          SECONDS=106
          _termnav_wezterm_publish_link_context >/dev/null
          printf "recovered=%s\n" "$(wc -l <"$TERMNAV_TMUX_QUERY_LOG" | tr -d " ")"
          printf "host=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"
        '
    )
    _assert_contains "shell integration: $test_shell startup $query_result uses one tmux query" \
      "initial=1" "$startup_recovery_output"
    _assert_contains "shell integration: $test_shell startup $query_result retries on expiry" \
      "recovered=2" "$startup_recovery_output"
    _assert_contains "shell integration: $test_shell startup $query_result recovers remote host" \
      "host=remote.example" "$startup_recovery_output"
  done

  : >"$shell_tmux_log"
  # shellcheck disable=SC2016 # Variables expand in the selected child shell.
  warm_publish_output=$(
    TMUX=/tmp/tmux-warm,1,0 \
      TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
      PATH="$shell_tmux_mock:$PATH" \
      SHELL_INTEGRATION="$shell_integration" \
      "${test_shell_command[@]}" -c '
        SECONDS=100
        source "$SHELL_INTEGRATION" >/dev/null
        : >"$TERMNAV_TMUX_QUERY_LOG"

        _termnav_wezterm_preexec true >/dev/null
        _termnav_wezterm_precmd >/dev/null
        _termnav_wezterm_preexec true >/dev/null
        _termnav_wezterm_precmd >/dev/null
        printf "warm=%s\n" "$(wc -l <"$TERMNAV_TMUX_QUERY_LOG" | tr -d " ")"

        export TMUX_MOCK_REMOTE_LINK_HOST=remote.example
        SECONDS=106
        _termnav_wezterm_publish_link_context >/dev/null
        printf "expired=%s\n" "$(wc -l <"$TERMNAV_TMUX_QUERY_LOG" | tr -d " ")"
        printf "host=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"
      '
  )
  _assert_contains "shell integration: $test_shell warm publish cycle performs no tmux query" \
    "warm=0" "$warm_publish_output"
  _assert_contains "shell integration: $test_shell expired client and host caches share one refresh query" \
    "expired=1" "$warm_publish_output"
  _assert_contains "shell integration: $test_shell expired host cache observes updated tmux value" \
    "host=remote.example" "$warm_publish_output"
done

# The scope names the exact WezTerm mux instance for optional remote-open
# helpers. Reassert it at every local prompt because a nested/remote child can
# publish pane-scoped variables without sharing this shell's in-memory cache.
wezterm_scope_output=$(
  TERM_PROGRAM=WezTerm \
    WEZTERM_UNIX_SOCKET=/tmp/wezterm-exact.sock \
    SHELL_INTEGRATION="$shell_integration" \
    bash --noprofile --norc -c '
      source "$SHELL_INTEGRATION" >/dev/null
      termnav_wezterm_user_var_sequence() {
        printf "%s=%s\n" "$1" "$2"
      }
      _termnav_wezterm_publish_link_context
      unset TERMNAV_WEZTERM_SCOPE WEZTERM_UNIX_SOCKET
      _termnav_wezterm_publish_link_context
      WEZTERM_UNIX_SOCKET=/tmp/wezterm-exact.sock
      _termnav_wezterm_publish_link_context
    '
)
_assert_eq "shell integration: exact WezTerm scope is reasserted but never cleared remotely" \
  $'TERMNAV_WEZTERM_SCOPE=/tmp/wezterm-exact.sock\nTERMNAV_WEZTERM_SCOPE=/tmp/wezterm-exact.sock' \
  "$(printf '%s\n' "$wezterm_scope_output" | grep '^TERMNAV_WEZTERM_SCOPE=')"

remote_refresh_output=$(
  TMUX=/tmp/tmux-remote-a,1,0 \
    TMUX_MOCK_REMOTE_LINK_HOST=remote-a.example \
    TERMNAV_TMUX_QUERY_LOG="$shell_tmux_log" \
    PATH="$shell_tmux_mock:$PATH" \
    SHELL_INTEGRATION="$shell_integration" \
    bash --noprofile --norc -c '
      SECONDS=100
      source "$SHELL_INTEGRATION" >/dev/null
      printf "initial=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"

      export TMUX_MOCK_REMOTE_LINK_HOST=remote-b.example
      SECONDS=104
      _termnav_wezterm_publish_link_context >/dev/null
      printf "warm=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"

      SECONDS=106
      _termnav_wezterm_publish_link_context >/dev/null
      printf "expired=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"

      TMUX=/tmp/tmux-remote-b,1,0
      export TMUX_MOCK_REMOTE_LINK_HOST=remote-c.example
      _termnav_wezterm_publish_link_context >/dev/null
      printf "tmux-change=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"

      export TMUX_MOCK_REMOTE_LINK_HOST=remote-d.example
      source "$SHELL_INTEGRATION" >/dev/null
      printf "resource=%s\n" "${TERMNAV_REMOTE_LINK_HOST:-}"
    '
)
_assert_contains "shell integration: publishes the initially discovered host" \
  "initial=remote-a.example" "$remote_refresh_output"
_assert_contains "shell integration: reuses a discovered host within the TTL" \
  "warm=remote-a.example" "$remote_refresh_output"
_assert_contains "shell integration: refreshes a discovered host after the TTL" \
  "expired=remote-b.example" "$remote_refresh_output"
