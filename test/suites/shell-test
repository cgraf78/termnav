#!/usr/bin/env bash
# shell-test — checks reusable interactive-shell routing policy.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

file_links_lib="$TERMNAV_ROOT/lib/termnav/shell/file-links.sh"

echo "=== terminal file-link mode ==="

_assert_file_exists "file-link mode: sourceable provider exists" "$file_links_lib"
if [[ -f "$file_links_lib" ]]; then
  # shellcheck source=/dev/null # The provider path is derived from this checkout.
  . "$file_links_lib"
fi
if ! declare -F termnav_file_links_need_plain_output >/dev/null 2>&1; then
  _fail "file-link mode: public classifier exists"
  _test_summary
fi

probe_root=$(_tmpdir)
probe_bin="$probe_root/bin"
probe_proc="$probe_root/proc"
mkdir -p "$probe_bin" "$probe_proc"

# These probes run below `env -i` so the classification cases cannot inherit
# terminal markers from the developer's shell. On Termux, that isolation also
# removes the LD_PRELOAD path shim which normally maps `/usr/bin/env` into the
# app prefix. Give each fixture the absolute interpreter that is already
# running this suite so the test exercises Termnav rather than the path shim.
printf '#!%s\n' "$BASH" >"$probe_bin/tmux"
cat >>"$probe_bin/tmux" <<'SH'
if [[ -n "${TERMNAV_TEST_TMUX_LOG:-}" ]]; then
  printf '%s\n' "$*" >>"$TERMNAV_TEST_TMUX_LOG"
fi
if [[ "$1" == display-message && "$2" == -p && "$3" == '#{client_pid}' ]]; then
  printf '%s\n' "${TERMNAV_TEST_CLIENT_PID:-}"
  exit 0
fi
exit 1
SH

printf '#!%s\n' "$BASH" >"$probe_bin/ps"
cat >>"$probe_bin/ps" <<'SH'
if [[ "$*" == "eww -p ${TERMNAV_TEST_CLIENT_PID:-}" && -n "${TERMNAV_TEST_PS_ENV:-}" ]]; then
  printf '%s\n' "$TERMNAV_TEST_PS_ENV"
  exit 0
fi
exit 1
SH
chmod +x "$probe_bin/tmux" "$probe_bin/ps"

vscode_client_pid=424242
wsl_client_pid=424243
wsl_wezterm_client_pid=424244
plain_client_pid=424245
mkdir -p \
  "$probe_proc/$vscode_client_pid" \
  "$probe_proc/$wsl_client_pid" \
  "$probe_proc/$wsl_wezterm_client_pid" \
  "$probe_proc/$plain_client_pid"
printf 'TERM_PROGRAM=vscode\0VSCODE_IPC_HOOK_CLI=/tmp/vscode.sock\0TERMNAV_SECRET_SENTINEL=must-not-trace\0' \
  >"$probe_proc/$vscode_client_pid/environ"
printf 'TERM=xterm-256color\0WSL_DISTRO_NAME=archlinux\0WSL_INTEROP=/run/WSL/1_interop\0' \
  >"$probe_proc/$wsl_client_pid/environ"
printf 'WEZTERM_PANE=7\0WSL_DISTRO_NAME=archlinux\0WSL_INTEROP=/run/WSL/1_interop\0' \
  >"$probe_proc/$wsl_wezterm_client_pid/environ"
printf 'TERMNAV_FILE_LINKS_PLAIN=1\0' \
  >"$probe_proc/$plain_client_pid/environ"

_probe_file_link_mode() {
  # shellcheck disable=SC2016 # The child shell loads and invokes the provider.
  env -i "$@" \
    FILE_LINKS_LIB="$file_links_lib" \
    PATH="$probe_bin:${BASH%/*}:/usr/bin:/bin" \
    "$BASH" --noprofile --norc -c '
      source "$FILE_LINKS_LIB"
      if termnav_file_links_need_plain_output; then
        printf "plain\n"
      else
        printf "rich\n"
      fi
    '
}

_assert_eq "file-link mode: WezTerm keeps routed OSC-8 links" "rich" \
  "$(_probe_file_link_mode TERM_PROGRAM=WezTerm)"
_assert_eq "file-link mode: WezTerm wins over stale VS Code markers" "rich" \
  "$(_probe_file_link_mode TERM_PROGRAM=WezTerm VSCODE_IPC_HOOK_CLI=/tmp/stale.sock)"
_assert_eq "file-link mode: VS Code uses plain paths" "plain" \
  "$(_probe_file_link_mode TERM_PROGRAM=vscode)"
_assert_eq "file-link mode: VS Code Remote uses plain paths" "plain" \
  "$(_probe_file_link_mode TERM_PROGRAM=vscode SSH_CONNECTION='client 123 host 22')"
_assert_eq "file-link mode: generic plain marker uses plain paths" "plain" \
  "$(_probe_file_link_mode TERMNAV_FILE_LINKS_PLAIN=1)"
_assert_eq "file-link mode: WezTerm wins over a stale generic plain marker" "rich" \
  "$(_probe_file_link_mode TERM_PROGRAM=WezTerm TERMNAV_FILE_LINKS_PLAIN=1)"
_assert_eq "file-link mode: unmarked WSL uses plain paths" "plain" \
  "$(_probe_file_link_mode TERM=xterm-256color WSL_DISTRO_NAME=archlinux WSL_INTEROP=/run/WSL/1_interop)"
_assert_eq "file-link mode: WSL WezTerm keeps routed OSC-8 links" "rich" \
  "$(_probe_file_link_mode TERM_PROGRAM=WezTerm WSL_DISTRO_NAME=archlinux WSL_INTEROP=/run/WSL/1_interop)"
_assert_eq "file-link mode: a WezTerm pane marker keeps routed OSC-8 links" "rich" \
  "$(_probe_file_link_mode WEZTERM_PANE=7 WSL_DISTRO_NAME=archlinux WSL_INTEROP=/run/WSL/1_interop)"
_assert_eq "file-link mode: tmux ignores stale pane environment" "rich" \
  "$(_probe_file_link_mode TERM_PROGRAM=vscode TMUX=/tmp/stale-tmux,1,0)"
_assert_eq "file-link mode: tmux reads a VS Code client from procfs" "plain" \
  "$(_probe_file_link_mode \
    TERM_PROGRAM=WezTerm \
    TMUX=/tmp/real-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc")"
_assert_eq "file-link mode: tmux reads a VS Code client through ps" "plain" \
  "$(_probe_file_link_mode \
    TERM_PROGRAM=WezTerm \
    TMUX=/tmp/real-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_root/missing-proc" \
    TERMNAV_TEST_PS_ENV='TERM_PROGRAM=vscode VSCODE_IPC_HOOK_CLI=/tmp/vscode.sock')"
_assert_eq "file-link mode: tmux reads an unmarked WSL client" "plain" \
  "$(_probe_file_link_mode \
    TERM_PROGRAM=tmux \
    TMUX=/tmp/wsl-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$wsl_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc")"
_assert_eq "file-link mode: tmux reads a generic plain client marker" "plain" \
  "$(_probe_file_link_mode \
    TERM_PROGRAM=WezTerm \
    TMUX=/tmp/plain-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$plain_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc")"
_assert_eq "file-link mode: tmux keeps routed links for a WSL WezTerm client" "rich" \
  "$(_probe_file_link_mode \
    TERM_PROGRAM=tmux \
    TMUX=/tmp/wsl-wezterm-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$wsl_wezterm_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc")"

_probe_file_link_trace() {
  # The child enables xtrace only after receiving its isolated environment, so
  # a sentinel can appear solely if provider internals retain unrecognized
  # attached-client variables in shell state.
  # shellcheck disable=SC2016
  env -i "$@" \
    FILE_LINKS_LIB="$file_links_lib" \
    PATH="$probe_bin:${BASH%/*}:/usr/bin:/bin" \
    "$BASH" --noprofile --norc -c '
      source "$FILE_LINKS_LIB"
      set -x
      termnav_file_links_need_plain_output
    ' 2>&1
}

proc_trace=$(_probe_file_link_trace \
  TMUX=/tmp/proc-trace-tmux,1,0 \
  TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
  TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc")
_assert_not_contains "file-link mode: procfs client secrets stay out of xtrace" \
  "TERMNAV_SECRET_SENTINEL" "$proc_trace"

ps_trace=$(_probe_file_link_trace \
  TMUX=/tmp/ps-trace-tmux,1,0 \
  TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
  TERMNAV_FILE_LINKS_PROC_ROOT="$probe_root/missing-proc" \
  TERMNAV_TEST_PS_ENV='TERM_PROGRAM=vscode TERMNAV_SECRET_SENTINEL=must-not-trace')
_assert_not_contains "file-link mode: ps client secrets stay out of xtrace" \
  "TERMNAV_SECRET_SENTINEL" "$ps_trace"

tmux_query_log="$probe_root/tmux-queries.log"
: >"$tmux_query_log"
cache_output=$(
  # shellcheck disable=SC2016 # The child shell controls its own SECONDS value.
  env -i \
    FILE_LINKS_LIB="$file_links_lib" \
    PATH="$probe_bin:${BASH%/*}:/usr/bin:/bin" \
    TMUX=/tmp/cache-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc" \
    TERMNAV_TEST_TMUX_LOG="$tmux_query_log" \
    "$BASH" --noprofile --norc -c '
      source "$FILE_LINKS_LIB"
      SECONDS=40
      termnav_file_links_need_plain_output
      termnav_file_links_need_plain_output
      SECONDS=41
      termnav_file_links_need_plain_output
      wc -l <"$TERMNAV_TEST_TMUX_LOG" | tr -d " "
    '
)
_assert_eq "file-link mode: caches tmux client inspection for one shell second" \
  "2" "$cache_output"

restored_clock_log="$probe_root/restored-clock-queries.log"
: >"$restored_clock_log"
restored_clock_output=$(
  # shellcheck disable=SC2016 # The child shell controls its own SECONDS value.
  env -i \
    FILE_LINKS_LIB="$file_links_lib" \
    PATH="$probe_bin:${BASH%/*}:/usr/bin:/bin" \
    TMUX=/tmp/restored-clock-tmux,1,0 \
    TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
    TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc" \
    TERMNAV_TEST_TMUX_LOG="$restored_clock_log" \
    TERMNAV_TEST_RICH_CLIENT_PID="$wsl_wezterm_client_pid" \
    "$BASH" --noprofile --norc -c '
      source "$FILE_LINKS_LIB"
      SECONDS=40
      termnav_file_links_need_plain_output
      first_status=$?
      unset SECONDS
      TERMNAV_TEST_CLIENT_PID="$TERMNAV_TEST_RICH_CLIENT_PID"
      termnav_file_links_need_plain_output
      invalid_clock_status=$?
      SECONDS=40
      termnav_file_links_need_plain_output
      restored_clock_status=$?
      query_count=$(wc -l <"$TERMNAV_TEST_TMUX_LOG" | tr -d " ")
      printf "%s %s %s %s\n" \
        "$first_status" "$invalid_clock_status" "$restored_clock_status" "$query_count"
    '
)
_assert_eq "file-link mode: recreated static clock cannot resurrect stale cache" \
  "0 1 1 3" "$restored_clock_output"

for clock_shell in bash zsh; do
  if [[ "$clock_shell" == bash ]]; then
    clock_shell_path="$BASH"
    clock_shell_args=(--noprofile --norc)
  elif ! clock_shell_path=$(command -v zsh 2>/dev/null); then
    echo "  - skipping file-link cache clock cases in zsh (zsh unavailable)"
    continue
  else
    clock_shell_args=(-f)
  fi

  clock_modes=(unset)
  # zsh retains SECONDS as an integer special parameter after unset and coerces
  # a nonnumeric assignment back to zero. Bash permits a plain string, so only
  # Bash can exercise that distinct invalid-clock shape.
  if [[ "$clock_shell" == bash ]]; then
    clock_modes+=(nonnumeric)
  fi
  for clock_mode in "${clock_modes[@]}"; do
    clock_log="$probe_root/${clock_shell}-${clock_mode}-queries.log"
    : >"$clock_log"
    clock_queries=$(
      # shellcheck disable=SC2016 # The selected child shell owns its clock.
      env -i \
        CLOCK_MODE="$clock_mode" \
        FILE_LINKS_LIB="$file_links_lib" \
        PATH="$probe_bin:${BASH%/*}:/usr/bin:/bin" \
        TMUX=/tmp/no-clock-tmux,1,0 \
        TERMNAV_TEST_CLIENT_PID="$vscode_client_pid" \
        TERMNAV_FILE_LINKS_PROC_ROOT="$probe_proc" \
        TERMNAV_TEST_TMUX_LOG="$clock_log" \
        "$clock_shell_path" "${clock_shell_args[@]}" -c '
          source "$FILE_LINKS_LIB"
          unset SECONDS
          if [[ "$CLOCK_MODE" == nonnumeric ]]; then
            SECONDS=not-a-clock
          fi
          termnav_file_links_need_plain_output
          termnav_file_links_need_plain_output
          wc -l <"$TERMNAV_TEST_TMUX_LOG" | tr -d " "
        '
    )
    _assert_eq "file-link mode: $clock_shell $clock_mode clock stays uncached" \
      "2" "$clock_queries"
  done
done

echo
echo "=== SSH routing boundaries ==="

shell_integration="$TERMNAV_ROOT/share/termnav/shell.sh"
ssh_shim="$TERMNAV_ROOT/share/termnav/shims/ssh"
ssh_probe=$(_tmpdir)
ssh_probe_bin="$ssh_probe/bin"
mkdir -p "$ssh_probe_bin"

if command -v zsh >/dev/null 2>&1; then
  path_log="$ssh_probe/zsh-chpwd-paths"
  zsh_path=/usr/bin:/bin
  # shellcheck disable=SC2016 # The child zsh expands the fixture variables.
  env -i \
    HOME="$HOME" \
    PATH="$zsh_path" \
    PATH_LOG="$path_log" \
    SHELL_INTEGRATION="$shell_integration" \
    zsh -f -c '
      capture_chpwd_path() {
        print -r -- "$PATH" >>"$PATH_LOG"
      }
      chpwd_functions=(capture_chpwd_path)
      source "$SHELL_INTEGRATION"
    '
  _assert_eq "shell loader: zsh directory hooks retain PATH" \
    "$zsh_path" "$(<"$path_log")"
else
  echo "  - skipping shell loader PATH case in zsh (zsh unavailable)"
fi

# Repository synchronization can update this shim before Shdeps reaches its
# later tool-install phase. During that bounded cutover window, SSH must remain
# usable so the same update can finish installing the new Termnav binary.
ssh_fallback_bin="$ssh_probe/fallback-bin"
ssh_fallback_log="$ssh_probe/fallback.log"
mkdir -p "$ssh_fallback_bin"
printf '#!%s\n' "$BASH" >"$ssh_fallback_bin/ssh"
cat >>"$ssh_fallback_bin/ssh" <<'SH'
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_COMMAND_LOG"
exit 88
SH
chmod +x "$ssh_fallback_bin/ssh"
TERMNAV_TEST_COMMAND_LOG="$ssh_fallback_log" \
  PATH="${ssh_shim%/ssh}:$ssh_fallback_bin:${BASH%/*}:/usr/bin:/bin" \
  _with_timeout 5s "$ssh_shim" -V \
  >/dev/null 2>&1
ssh_fallback_status=$?
_assert_exit "ssh shim: missing termnav uses the system utility path" \
  0 "$ssh_fallback_status"
_assert_eq "ssh shim: bootstrap never selects a PATH shim" \
  '' "$(cat "$ssh_fallback_log" 2>/dev/null)"

# A checkout and an installed release can both contribute a copy of this shim
# during an update. Re-entering either copy must stop immediately: the native
# supervisor waits for its SSH child, so an unbounded shim -> termnav -> shim
# cycle grows one waiting process per turn instead of merely spinning one PID.
ssh_recursive_bin="$ssh_probe/recursive-bin"
ssh_recursive_shim="$ssh_probe/recursive/share/termnav/shims"
ssh_recursive_count="$ssh_probe/recursive-count"
ssh_recursive_real="$ssh_probe/recursive-real"
ssh_recursive_log="$ssh_probe/recursive-real.log"
mkdir -p "$ssh_recursive_bin" "$ssh_recursive_shim" "$ssh_recursive_real"
cp "$ssh_shim" "$ssh_recursive_shim/ssh"
cat >"$ssh_recursive_bin/termnav" <<'SH'
#!/usr/bin/env bash
count=$(cat "$TERMNAV_TEST_RECURSION_COUNT" 2>/dev/null || printf 0)
count=$((count + 1))
printf '%s\n' "$count" >"$TERMNAV_TEST_RECURSION_COUNT"
# Bound the broken implementation without relying on the host process limit.
((count < 3)) || exit 99
shift
exec ssh "$@"
SH
printf '#!%s\n' "$BASH" >"$ssh_recursive_real/ssh"
cat >>"$ssh_recursive_real/ssh" <<'SH'
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_COMMAND_LOG"
SH
chmod +x "$ssh_recursive_bin/termnav" "$ssh_recursive_real/ssh"
TERMNAV_TEST_RECURSION_COUNT="$ssh_recursive_count" \
  TERMNAV_TEST_COMMAND_LOG="$ssh_recursive_log" \
  PATH="$ssh_recursive_bin:$ssh_recursive_shim:$ssh_recursive_real:${BASH%/*}:/usr/bin:/bin" \
  _with_timeout 5s "$ssh_recursive_shim/ssh" recursion.example true \
  >/dev/null 2>&1
ssh_recursive_status=$?
_assert_exit "ssh shim: new shim works through an older binary" 0 \
  "$ssh_recursive_status"
_assert_eq "ssh shim: mixed-version handoff invokes termnav only once" 1 \
  "$(cat "$ssh_recursive_count" 2>/dev/null)"
_assert_eq "ssh shim: mixed-version handoff reaches real SSH" \
  $'<recursion.example>\n<true>' "$(cat "$ssh_recursive_log" 2>/dev/null)"

TERMNAV_SSH_SHIM_ACTIVE=1 \
  _with_timeout 5s "$ssh_recursive_shim/ssh" recursion.example true \
  >/dev/null 2>&1
_assert_exit "ssh shim: recursive re-entry fails closed" 126 "$?"

# The shim tells the native supervisor exactly which PATH entry invoked it.
# This cannot be inferred from the release binary: a source checkout has a
# different path from both the build-time source tree and installed release.
ssh_invoking_shim="$ssh_probe/checkout/share/termnav/shims"
ssh_installed_shim="$ssh_probe/release/share/termnav/shims"
ssh_integration_count="$ssh_probe/integration-count"
ssh_real_bin="$ssh_probe/real-bin"
ssh_real_log="$ssh_probe/real.log"
mkdir -p "$ssh_invoking_shim" "$ssh_installed_shim" "$ssh_real_bin"
cp "$ssh_shim" "$ssh_invoking_shim/ssh"
cp "$ssh_shim" "$ssh_installed_shim/ssh"
# Keep this regression safe even if a future resolver change reintroduces the
# process chain. Each fixture shim gets a test-only fuse before the production
# body; the fourth entry fails instead of relying on a timeout to contain it.
for fixture_shim in "$ssh_invoking_shim/ssh" "$ssh_installed_shim/ssh"; do
  # shellcheck disable=SC2016 # Inserted variables expand in the fixture process.
  sed -i.bak '2i\
count=$(cat "$TERMNAV_TEST_INTEGRATION_COUNT" 2>/dev/null || printf 0)\
count=$((count + 1))\
printf "%s\\n" "$count" >"$TERMNAV_TEST_INTEGRATION_COUNT"\
[ "$count" -lt 4 ] || exit 99
' "$fixture_shim"
  rm -f "$fixture_shim.bak"
done
printf '#!%s\n' "$BASH" >"$ssh_real_bin/ssh"
cat >>"$ssh_real_bin/ssh" <<'SH'
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_COMMAND_LOG"
printf 'active=%s\n' "${TERMNAV_SSH_SHIM_ACTIVE-}" >>"$TERMNAV_TEST_COMMAND_LOG"
printf 'dir=%s\n' "${TERMNAV_SSH_SHIM_DIR-}" >>"$TERMNAV_TEST_COMMAND_LOG"
printf 'path=%s\n' "$PATH" >>"$TERMNAV_TEST_COMMAND_LOG"
SH
chmod +x "$ssh_invoking_shim/ssh" "$ssh_real_bin/ssh"
TERMNAV_TEST_INTEGRATION_COUNT="$ssh_integration_count" \
  TERMNAV_TEST_COMMAND_LOG="$ssh_real_log" \
  PATH="${TERMNAV_TEST_BINARY%/termnav}:$ssh_invoking_shim:$ssh_installed_shim:$ssh_real_bin:${BASH%/*}:/usr/bin:/bin" \
  _with_timeout 5s "$ssh_invoking_shim/ssh" -V \
  >/dev/null 2>&1
ssh_invoking_status=$?
_assert_exit "ssh resolver: invoking shim directory is never selected" 0 \
  "$ssh_invoking_status"
_assert_eq "ssh resolver: invoking shim delegates to the next real SSH" \
  $'<-V>\nactive=\ndir=\npath='"${TERMNAV_TEST_BINARY%/termnav}:$ssh_invoking_shim:$ssh_installed_shim:$ssh_real_bin:${BASH%/*}:/usr/bin:/bin" \
  "$(cat "$ssh_real_log" 2>/dev/null)"
_assert_eq "ssh resolver: two-shim integration invokes one shim" 1 \
  "$(cat "$ssh_integration_count" 2>/dev/null)"

ssh_copied_shim="$ssh_probe/copied-shim"
ssh_copied_shim_two="$ssh_probe/copied-shim-two"
ssh_copied_count="$ssh_probe/copied-count"
mkdir -p "$ssh_copied_shim" "$ssh_copied_shim_two"
cp "$ssh_shim" "$ssh_copied_shim/ssh"
cp "$ssh_shim" "$ssh_copied_shim_two/ssh"
# A count fuse keeps this real-binary regression safe if both the directory
# and file-marker defenses are accidentally removed in a future change.
for fixture_shim in "$ssh_copied_shim/ssh" "$ssh_copied_shim_two/ssh"; do
  # shellcheck disable=SC2016 # Inserted variables expand in the fixture process.
  sed -i.bak '3i\
count=$(cat "$TERMNAV_TEST_COPIED_COUNT" 2>/dev/null || printf 0)\
count=$((count + 1))\
printf "%s\\n" "$count" >"$TERMNAV_TEST_COPIED_COUNT"\
[ "$count" -lt 4 ] || exit 99
' "$fixture_shim"
  rm -f "$fixture_shim.bak"
done
rm -f "$ssh_real_log"
TERMNAV_TEST_COPIED_COUNT="$ssh_copied_count" \
  TERMNAV_TEST_COMMAND_LOG="$ssh_real_log" \
  PATH="$ssh_copied_shim:$ssh_copied_shim_two:$ssh_real_bin:${BASH%/*}:/usr/bin:/bin" \
  _with_timeout 5s "$TERMNAV_TEST_BINARY" ssh -V \
  >/dev/null 2>&1
ssh_copied_status=$?
_assert_exit "ssh resolver: relocated marked shim is never selected" 0 \
  "$ssh_copied_status"
_assert_eq "ssh resolver: relocated shim reaches the real SSH" \
  $'<-V>\nactive=\ndir=\npath='"$ssh_copied_shim:$ssh_copied_shim_two:$ssh_real_bin:${BASH%/*}:/usr/bin:/bin" \
  "$(cat "$ssh_real_log" 2>/dev/null)"
_assert_eq "ssh resolver: relocated shims are never invoked" '' \
  "$(cat "$ssh_copied_count" 2>/dev/null)"

cat >"$ssh_probe_bin/termnav" <<'SH'
#!/usr/bin/env bash
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_COMMAND_LOG"
SH
cat >"$ssh_probe_bin/ssh" <<'SH'
#!/usr/bin/env bash
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_COMMAND_LOG"
SH
chmod +x "$ssh_probe_bin/termnav" "$ssh_probe_bin/ssh"

_assert_file_exists "ssh shim: provider-owned executable exists" "$ssh_shim"
_assert_eq "ssh shim: provider-owned command is executable" true \
  "$([[ -x "$ssh_shim" ]] && printf true || printf false)"

ssh_test_shells=(bash zsh)
if [[ -x /bin/bash && "$BASH" != /bin/bash ]]; then
  ssh_test_shells+=(bash-3.2)
fi
for test_shell in "${ssh_test_shells[@]}"; do
  if [[ "$test_shell" == zsh ]] && ! command -v zsh >/dev/null 2>&1; then
    echo "  - skipping inherited SSH interposition in zsh (zsh unavailable)"
    continue
  fi
  if [[ "$test_shell" == bash ]]; then
    test_shell_path="$BASH"
    test_shell_args=(--noprofile --norc)
  elif [[ "$test_shell" == bash-3.2 ]]; then
    test_shell_path=/bin/bash
    test_shell_args=(--noprofile --norc)
  else
    test_shell_path=$(command -v zsh)
    test_shell_args=(-f)
  fi

  ssh_priority_output=$(
    # shellcheck disable=SC2016 # The selected child shell expands the fixture.
    env -i \
      HOME="$HOME" \
      PATH="/usr/bin:${ssh_shim%/ssh}:/bin:$ssh_probe/old/share/termnav/shims:${ssh_shim%/ssh}:$ssh_probe_bin:" \
      SHELL_INTEGRATION="$shell_integration" \
      "$test_shell_path" "${test_shell_args[@]}" -c '
        source "$SHELL_INTEGRATION"
        printf "ssh=%s\n" "$(command -v ssh)"
        printf "path=%s\n" "$PATH"
      '
  )
  _assert_contains "ssh routing: $test_shell resolves the shell function" \
    "ssh=ssh" "$ssh_priority_output"
  _assert_contains "ssh routing: $test_shell removes inherited shim entries" \
    "path=/usr/bin:/bin:$ssh_probe_bin:" \
    "$ssh_priority_output"

  ssh_only_output=$(
    # shellcheck disable=SC2016 # The selected child shell expands the fixture.
    env -i \
      HOME="$HOME" \
      PATH="${ssh_shim%/ssh}:${ssh_shim%/ssh}" \
      SHELL_INTEGRATION="$shell_integration" \
      "$test_shell_path" "${test_shell_args[@]}" -c '
        source "$SHELL_INTEGRATION"
        source "$SHELL_INTEGRATION"
        printf "path=%s\n" "$PATH"
        if typeset -f _termnav_shell_remove_ssh_shim >/dev/null 2>&1; then
          printf "helper=present\n"
        else
          printf "helper=absent\n"
        fi
      '
  )
  _assert_eq "ssh routing: $test_shell removes an all-shim PATH" \
    $'path=\nhelper=absent' "$ssh_only_output"

  ssh_empty_path_output=$(
    # shellcheck disable=SC2016 # The selected child shell expands the fixture.
    env -i \
      HOME="$HOME" \
      PATH="${BASH%/*}:/usr/bin:/bin" \
      SHELL_INTEGRATION="$shell_integration" \
      SHIM_DIR="${ssh_shim%/ssh}" \
      "$test_shell_path" "${test_shell_args[@]}" -c '
        unset PATH
        source "$SHELL_INTEGRATION"
        printf "unset=%s\n" "$PATH"
        PATH=
        source "$SHELL_INTEGRATION"
        printf "empty=%s\n" "$PATH"
        PATH=":$SHIM_DIR::/usr/bin:$SHIM_DIR:"
        source "$SHELL_INTEGRATION"
        printf "components=%s\n" "$PATH"
      '
  )
  _assert_eq "ssh routing: $test_shell preserves unrelated empty PATH components" \
    $'unset=\nempty=\ncomponents=::/usr/bin:' \
    "$ssh_empty_path_output"

  ssh_tty_log="$ssh_probe/$test_shell-tty-command.log"
  ssh_plain_log="$ssh_probe/$test_shell-plain-command.log"
  ssh_stderr_log="$ssh_probe/$test_shell-stderr.log"
  : >"$ssh_tty_log"
  : >"$ssh_plain_log"
  : >"$ssh_stderr_log"
  # The selected child shell owns all expansions inside this fixture. Keeping
  # it literal verifies both Bash and zsh rather than the test runner's shell.
  # Termux implements conventional /usr/bin shebang paths through termux-exec;
  # preserve only its LD_PRELOAD hook across env isolation so the fixture has
  # the same executable semantics as a real Termux login shell.
  # Keep all three fixture descriptors non-terminal. This suite owns only the
  # shell boundary and argument forwarding, so fake commands record the exact
  # calls without also starting the independently-tested relay supervisor.
  # shellcheck disable=SC2016
  ssh_probe_output=$(
    _with_timeout 20s env -i \
      HOME="$HOME" \
      LD_PRELOAD="${LD_PRELOAD:-}" \
      PATH="$ssh_probe_bin:/usr/bin:/bin" \
      REPO_TEST=1 \
      CHILD_BASH="$BASH" \
      SHELL_INTEGRATION="$shell_integration" \
      SSH_PLAIN_LOG="$ssh_plain_log" \
      SSH_TTY_LOG="$ssh_tty_log" \
      "$test_shell_path" "${test_shell_args[@]}" -c '
        source "$SHELL_INTEGRATION"
        source "$SHELL_INTEGRATION"
        printf "ssh=%s\n" "$(command -v ssh)"
        count=$(printf "%s\n" "$PATH" | awk -v RS=: \
          -v shim="${SHELL_INTEGRATION%/shell.sh}/shims" \
          "\$0 == shim { count++ } END { print count + 0 }")
        printf "shim-count=%s\n" "$count"
        if typeset -f ssh >/dev/null 2>&1; then
          printf "function=present\n"
        else
          printf "function=absent\n"
        fi
        TERMNAV_TEST_COMMAND_LOG="$SSH_TTY_LOG" \
          ssh -t shell.example printf hello
        TERMNAV_TEST_COMMAND_LOG="$SSH_PLAIN_LOG" \
          "$CHILD_BASH" --noprofile --norc -c \
          '"'"'exec ssh child.example printf hello </dev/null'"'"'
      ' \
      </dev/null 2>"$ssh_stderr_log"
  )
  ssh_probe_rc=$?
  _assert_eq "ssh shim: $test_shell fixture exits within its bound" \
    "0" "$ssh_probe_rc"
  _assert_contains "ssh routing: $test_shell resolves a shell-local function" \
    "ssh=ssh" "$ssh_probe_output"
  _assert_contains "ssh routing: $test_shell leaves no inherited shim" \
    "shim-count=0" "$ssh_probe_output"
  _assert_contains "ssh routing: $test_shell defines the ssh function" \
    "function=present" "$ssh_probe_output"
  _assert_eq "ssh routing: $test_shell function delegates the exact tty command" \
    $'<ssh>\n<-t>\n<shell.example>\n<printf>\n<hello>' "$(cat "$ssh_tty_log")"
  _assert_eq "ssh routing: $test_shell child bypasses Termnav" \
    $'<child.example>\n<printf>\n<hello>' "$(cat "$ssh_plain_log")"
done

echo
echo "=== shell tmux context publication ==="

shell_tmux_bin=$(_tmpdir)
cat >"$shell_tmux_bin/tmux" <<'SH'
#!/usr/bin/env bash
case "$*" in
  "display-message -p t#{client_termname} ; show-environment -g TERMNAV_REMOTE_LINK_HOST")
    printf 'txterm-256color\n'
    ;;
  *)
    printf 'xterm-256color\n'
    ;;
esac
SH
chmod +x "$shell_tmux_bin/tmux"

tmux_publication=$(
  TERM_PROGRAM=WezTerm \
    TMUX=/tmp/termnav-tmux,1,0 \
    PATH="$shell_tmux_bin:$PATH" \
    bash --noprofile --norc -c 'source "$1"' _ "$shell_integration"
)
_assert_contains "tmux context: shell publishes provider-owned true state" \
  'SetUserVar=TERMNAV_TMUX=dHJ1ZQ==' "$tmux_publication"

plain_publication=$(
  TERM_PROGRAM=WezTerm \
    TMUX='' \
    bash --noprofile --norc -c 'source "$1"' _ "$shell_integration"
)
_assert_contains "tmux context: shell publishes provider-owned empty state" \
  'SetUserVar=TERMNAV_TMUX=' "$plain_publication"

nvim_publication=$(
  TERM_PROGRAM=WezTerm \
    NVIM=/tmp/nvim.sock \
    bash --noprofile --norc -c 'source "$1"' _ "$shell_integration"
)
_assert_not_contains "tmux context: embedded Neovim terminals publish no shell state" \
  'SetUserVar=TERMNAV_TMUX=' "$nvim_publication"

prompt_publication=$(
  TERM_PROGRAM=WezTerm \
    TMUX=/tmp/termnav-tmux,1,0 \
    PATH="$shell_tmux_bin:$PATH" \
    bash --noprofile --norc -c '
      source "$1"
      _termnav_wezterm_precmd
      _termnav_wezterm_precmd
    ' _ "$shell_integration"
)
prompt_tmux_count=$(awk 'BEGIN { RS="SetUserVar=TERMNAV_TMUX=" } END { print NR - 1 }' <<<"$prompt_publication")
_assert_eq "tmux context: every returned prompt reasserts its shell state" \
  "3" "$prompt_tmux_count"

_test_summary
