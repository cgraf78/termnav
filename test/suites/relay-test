#!/usr/bin/env bash
# relay-test - hop-by-hop navigation transport and SSH integration.

set -euo pipefail
export NO_COLOR=1

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"
# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"

relay="$root/bin/termnav-relay"
tmp=$(_tmpdir)
log="$tmp/route.log"
socket="$tmp/parent.sock"

echo "=== relay protocol ==="
TERMNAV_RELAY_TEST_LOG="$log" "$relay" serve --socket "$socket" &
server_pid=$!
for _ in {1..50}; do
  [[ -S "$socket" ]] && break
  sleep 0.02
done
TERMNAV_PARENT_RELAY="$socket" "$relay" send pane left
TERMNAV_PARENT_RELAY="$socket" "$relay" send pane down
TERMNAV_PARENT_RELAY="$socket" "$relay" send window next
TERMNAV_PARENT_RELAY="$socket" "$relay" send window previous
TERMNAV_PARENT_RELAY="$socket" "$relay" send move left
TERMNAV_PARENT_RELAY="$socket" "$relay" send move right
socket_mode="$(stat -c %a "$socket" 2>/dev/null || stat -f %Lp "$socket")"
kill "$server_pid"
wait "$server_pid" 2>/dev/null || true
_assert_eq "relay: accepts every navigation operation" \
  $'pane left\npane down\nwindow next\nwindow previous\nmove left\nmove right' "$(cat "$log")"
_assert_eq "relay: owner-only socket permissions" 600 "$socket_mode"
_assert_eq "relay: removes its local socket on shutdown" false "$([[ -e "$socket" ]] && echo true || echo false)"

set +e
bad_output=$(TERMNAV_PARENT_RELAY="$socket" "$relay" send pane diagonal 2>&1)
bad_rc=$?
missing_output=$(env -u TERMNAV_PARENT_RELAY "$relay" send pane left 2>&1)
missing_rc=$?
set -e
_assert_exit "relay: rejects invalid directions" 2 "$bad_rc"
_assert_contains "relay: invalid direction is actionable" "invalid pane direction" "$bad_output"
_assert_exit "relay: absent parent fails silently" 1 "$missing_rc"
_assert_eq "relay: absent parent emits nothing" "" "$missing_output"

echo
echo "=== depth-independent forwarding ==="
outer_socket="$tmp/outer.sock"
inner_socket="$tmp/inner.sock"
chain_log="$tmp/chain.log"
env -u TMUX -u TMUX_PANE TERMNAV_RELAY_TEST_LOG="$chain_log" \
  "$relay" serve --socket "$outer_socket" &
outer_pid=$!
for _ in {1..50}; do
  [[ -S "$outer_socket" ]] && break
  sleep 0.02
done
env -u TMUX -u TMUX_PANE TERMNAV_PARENT_RELAY="$outer_socket" \
  "$relay" serve --socket "$inner_socket" &
inner_pid=$!
for _ in {1..50}; do
  [[ -S "$inner_socket" ]] && break
  sleep 0.02
done
TERMNAV_PARENT_RELAY="$inner_socket" "$relay" send window previous
TERMNAV_PARENT_RELAY="$inner_socket" "$relay" send pane right
TERMNAV_PARENT_RELAY="$inner_socket" "$relay" send move left
kill "$inner_pid" "$outer_pid"
wait "$inner_pid" "$outer_pid" 2>/dev/null || true
_assert_eq "relay: two arbitrary hops preserve forward and reverse operations" \
  $'window previous\npane right\nmove left' "$(cat "$chain_log")"

malformed_socket="$tmp/malformed.sock"
malformed_log="$tmp/malformed.log"
TERMNAV_RELAY_TEST_LOG="$malformed_log" "$relay" serve --socket "$malformed_socket" &
malformed_pid=$!
for _ in {1..50}; do
  [[ -S "$malformed_socket" ]] && break
  sleep 0.02
done
python3 - "$malformed_socket" <<'PY'
import socket
import sys
for payload in (b"not-json\n", b'{"v":2,"scope":"pane","direction":"left"}\n', b"x" * 257):
    with socket.socket(socket.AF_UNIX) as client:
        client.connect(sys.argv[1])
        client.sendall(payload)
PY
TERMNAV_PARENT_RELAY="$malformed_socket" "$relay" send pane up
kill "$malformed_pid"
wait "$malformed_pid" 2>/dev/null || true
_assert_eq "relay: malformed and oversized messages cannot trigger routing" \
  "pane up" "$(cat "$malformed_log")"

concurrent_socket="$tmp/concurrent.sock"
concurrent_log="$tmp/concurrent.log"
TERMNAV_RELAY_TEST_LOG="$concurrent_log" "$relay" serve --socket "$concurrent_socket" &
concurrent_pid=$!
for _ in {1..50}; do
  [[ -S "$concurrent_socket" ]] && break
  sleep 0.02
done
python3 - "$concurrent_socket" <<'PY'
import json
import socket
import sys

stalled = socket.socket(socket.AF_UNIX)
stalled.connect(sys.argv[1])
stalled.sendall(b"{")

fragmented = socket.socket(socket.AF_UNIX)
fragmented.connect(sys.argv[1])
payload = json.dumps({"v": 1, "scope": "pane", "direction": "left"}, separators=(",", ":")).encode() + b"\n"
for byte in payload:
    fragmented.send(bytes([byte]))
assert fragmented.recv(1) == b"1"
fragmented.close()
stalled.close()
PY
# With BUSY nonblocking try-lock, 12 parallel would get busy errors; run serially with gap
for _ in {1..12}; do
  TERMNAV_PARENT_RELAY="$concurrent_socket" "$relay" send window next
  sleep 0.02
done
_assert_eq "relay: stalled and concurrent clients cannot block valid fragmented requests" \
  13 "$(wc -l <"$concurrent_log" | tr -d ' ')"
set +e
TERMNAV_PARENT_RELAY="$concurrent_socket" "$relay" send pane left \
  --client-pid "$$" --client-tty /dev/definitely-not-this-tty >/dev/null 2>&1
tty_mismatch_rc=$?
set -e
_assert_exit "relay: a PID with the wrong client TTY fails closed" 1 "$tty_mismatch_rc"
kill "$concurrent_pid"
wait "$concurrent_pid" 2>/dev/null || true

negative_socket="$tmp/negative.sock"
env -u TMUX -u TMUX_PANE -u TERMNAV_PARENT_RELAY \
  "$relay" serve --socket "$negative_socket" &
negative_pid=$!
for _ in {1..50}; do
  [[ -S "$negative_socket" ]] && break
  sleep 0.02
done
set +e
TERMNAV_PARENT_RELAY="$negative_socket" "$relay" send pane left >/dev/null 2>&1
negative_rc=$?
set -e
_assert_exit "relay: an unhandled request propagates a negative acknowledgement" 3 "$negative_rc"
kill "$negative_pid"
wait "$negative_pid" 2>/dev/null || true

echo
echo "=== real tmux window movement ==="
tmux_socket_name="termnav-relay-test-$$"
tmux -L "$tmux_socket_name" -f /dev/null new-session -d -s target -n first
tmux_socket_path=$(tmux -L "$tmux_socket_name" display-message -p '#{socket_path}')
tmux -L "$tmux_socket_name" new-window -d -t target:3 -n middle
tmux -L "$tmux_socket_name" new-window -d -t target:7 -n last
tmux -L "$tmux_socket_name" new-session -d -s unrelated -n other-first
tmux -L "$tmux_socket_name" new-window -d -t unrelated:9 -n other-last
tmux -L "$tmux_socket_name" new-session -d -s linked -n linked-first
tmux -L "$tmux_socket_name" link-window -d -s target:3 -t linked:5
middle_pane=$(tmux -L "$tmux_socket_name" display-message -p -t target:3 '#{pane_id}')
first_pane=$(tmux -L "$tmux_socket_name" display-message -p -t target:0 '#{pane_id}')
last_pane=$(tmux -L "$tmux_socket_name" display-message -p -t target:7 '#{pane_id}')
target_session=$(tmux -L "$tmux_socket_name" display-message -p -t target '#{session_id}')
move_socket="$tmp/move.sock"
TERMNAV_RELAY_DIRECT=1 TMUX="$tmux_socket_path,0,0" TMUX_PANE="$middle_pane" TERMNAV_TMUX_SESSION="$target_session" \
  "$relay" serve --socket "$move_socket" &
move_pid=$!
for _ in {1..50}; do
  [[ -S "$move_socket" ]] && break
  sleep 0.02
done
TERMNAV_PARENT_RELAY="$move_socket" "$relay" send move left
_assert_eq "relay move: left targets the captured pane's gapped-index session" \
  $'middle\nfirst\nlast' "$(tmux -L "$tmux_socket_name" list-windows -t target -F '#{window_name}')"
_assert_eq "relay move: leaves another session on the same server untouched" \
  $'other-first\nother-last' "$(tmux -L "$tmux_socket_name" list-windows -t unrelated -F '#{window_name}')"
_assert_eq "relay move: leaves another session's link to the source untouched" \
  $'linked-first\nmiddle' "$(tmux -L "$tmux_socket_name" list-windows -t linked -F '#{window_name}')"
TERMNAV_PARENT_RELAY="$move_socket" "$relay" send move right
_assert_eq "relay move: right symmetrically restores a non-boundary window" \
  $'first\nmiddle\nlast' "$(tmux -L "$tmux_socket_name" list-windows -t target -F '#{window_name}')"
kill "$move_pid"
wait "$move_pid" 2>/dev/null || true

for boundary_pane in "$first_pane" "$last_pane"; do
  boundary_socket="$tmp/boundary-${boundary_pane#%}.sock"
  TERMNAV_RELAY_DIRECT=1 TMUX="$tmux_socket_path,0,0" TMUX_PANE="$boundary_pane" TERMNAV_TMUX_SESSION="$target_session" \
    "$relay" serve --socket "$boundary_socket" &
  boundary_pid=$!
  for _ in {1..50}; do
    [[ -S "$boundary_socket" ]] && break
    sleep 0.02
  done
  boundary_direction=left
  [[ "$boundary_pane" == "$last_pane" ]] && boundary_direction=right
  TERMNAV_PARENT_RELAY="$boundary_socket" "$relay" send move "$boundary_direction"
  kill "$boundary_pid"
  wait "$boundary_pid" 2>/dev/null || true
done
_assert_eq "relay move: gapped first and last boundaries are no-ops" \
  $'first\nmiddle\nlast' "$(tmux -L "$tmux_socket_name" list-windows -t target -F '#{window_name}')"

ambiguous_log="$tmp/ambiguous.log"
ambiguous_parent_socket="$tmp/ambiguous-parent.sock"
ambiguous_socket="$tmp/ambiguous.sock"
TERMNAV_RELAY_TEST_LOG="$ambiguous_log" \
  "$relay" serve --socket "$ambiguous_parent_socket" &
ambiguous_parent_pid=$!
for _ in {1..50}; do
  [[ -S "$ambiguous_parent_socket" ]] && break
  sleep 0.02
done
TMUX="$tmux_socket_path,0,0" TMUX_PANE="$middle_pane" \
  TERMNAV_PARENT_RELAY="$ambiguous_parent_socket" \
  "$relay" serve --socket "$ambiguous_socket" &
ambiguous_pid=$!
for _ in {1..50}; do
  [[ -S "$ambiguous_socket" ]] && break
  sleep 0.02
done
TERMNAV_PARENT_RELAY="$ambiguous_socket" "$relay" send move left
_assert_eq "relay move: missing client session fails closed and forwards" \
  "move left" "$(cat "$ambiguous_log")"
_assert_eq "relay move: missing client session cannot mutate a linked pane" \
  $'first\nmiddle\nlast' "$(tmux -L "$tmux_socket_name" list-windows -t target -F '#{window_name}')"
kill "$ambiguous_pid" "$ambiguous_parent_pid"
wait "$ambiguous_pid" "$ambiguous_parent_pid" 2>/dev/null || true
tmux -L "$tmux_socket_name" kill-server

echo
echo "=== stale socket cleanup ==="
portable_tmp=$(python3 -c 'import tempfile; print(tempfile.gettempdir())')
stale_socket="$portable_tmp/termnav-relay-test-stale-$$.sock"
active_socket="$portable_tmp/termnav-relay-test-active-$$.sock"
unrelated_file="$portable_tmp/termnav-relay-test-file-$$.sock"
symlink_path="$portable_tmp/termnav-relay-test-link-$$.sock"
python3 - "$stale_socket" <<'PY'
import os
import socket
import sys
server = socket.socket(socket.AF_UNIX)
server.bind(sys.argv[1])
server.close()
old = 1
os.utime(sys.argv[1], (old, old))
PY
: >"$unrelated_file"
ln -s "$unrelated_file" "$symlink_path"
TERMNAV_RELAY_TEST_LOG="$tmp/sweep.log" "$relay" serve --socket "$active_socket" &
active_pid=$!
for _ in {1..50}; do
  [[ -S "$active_socket" ]] && break
  sleep 0.02
done
python3 - "$active_socket" <<'PY'
import os
import sys
os.utime(sys.argv[1], (1, 1))
PY
"$relay" sweep
_assert_eq "relay sweep: removes an old dead owner socket" false "$([[ -e "$stale_socket" ]] && echo true || echo false)"
_assert_eq "relay sweep: preserves an old active socket" true "$([[ -S "$active_socket" ]] && echo true || echo false)"
_assert_eq "relay sweep: preserves unrelated regular files" true "$([[ -f "$unrelated_file" ]] && echo true || echo false)"
_assert_eq "relay sweep: preserves symlinks" true "$([[ -L "$symlink_path" ]] && echo true || echo false)"
kill "$active_pid"
wait "$active_pid" 2>/dev/null || true
rm -f "$unrelated_file" "$symlink_path"

echo
echo "=== arbitrary-host SSH integration ==="
fake_bin="$tmp/bin"
mkdir -p "$fake_bin"
cat >"$fake_bin/ssh-real" <<'EOF'
#!/usr/bin/env bash
printf '<%s>\n' "$@" >"$TERMNAV_TEST_SSH_LOG"
exit "${TERMNAV_TEST_SSH_RC:-0}"
EOF
chmod +x "$fake_bin/ssh-real"

for destination in arbitrary.example alice@host-with-alias '[2001:db8::7]'; do
  ssh_log="$tmp/ssh-${destination//[^a-zA-Z0-9]/_}.log"
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default' \
    TERMNAV_TEST_STDIN_TTY=1 TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay" ssh -p 2222 "$destination"
  ssh_args=$(cat "$ssh_log")
  _assert_contains "ssh relay: preserves arbitrary destination $destination" "<$destination>" "$ssh_args"
  _assert_contains "ssh relay: uses the original SSH process for forwarding" "<RemoteForward=" "$ssh_args"
  _assert_contains "ssh relay: passes only narrow relay metadata" "<SetEnv=TERMNAV_PARENT_RELAY=" "$ssh_args"
  _assert_not_contains "ssh relay: never replaces the configured remote command" "<termnav-relay shell" "$ssh_args"
done

ssh_log="$tmp/explicit.log"
TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay" ssh other.example printf hello
_assert_eq "ssh relay: explicit commands remain byte-for-byte ordinary SSH" \
  $'<other.example>\n<printf>\n<hello>' "$(cat "$ssh_log")"

for mode in '-N mode.example' '-Nf background.example' '-TN no-session.example' '-G config.example' '-O check control.example' '-W target:22 jump.example' '-T no-tty.example' '-f background-only.example'; do
  ssh_log="$tmp/mode-${mode//[^a-zA-Z0-9]/_}.log"
  # shellcheck disable=SC2086 # each fixture intentionally expands to argv.
  TERMNAV_TEST_STDIN_TTY=1 TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay" ssh $mode
  _assert_not_contains "ssh relay: control mode $mode is never enhanced" "RemoteForward=" "$(cat "$ssh_log")"
done

ssh_log="$tmp/redirected.log"
TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay" ssh redirected.example </dev/null
_assert_not_contains "ssh relay: redirected stdin remains an ordinary session" "RemoteForward=" "$(cat "$ssh_log")"

ssh_log="$tmp/forced-tty.log"
TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay" ssh -t forced.example </dev/null
_assert_contains "ssh relay: explicit tty enables a redirected interactive login" "RemoteForward=" "$(cat "$ssh_log")"

ssh_log="$tmp/attached-option.log"
TERMNAV_TEST_STDIN_TTY=1 \
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty force\nsessiontype default' \
  TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay" ssh -oRequestTTY=force attached-option.example
_assert_contains "ssh relay: attached option values are not mistaken for flag clusters" \
  "RemoteForward=" "$(cat "$ssh_log")"

control_ssh="$fake_bin/ssh-control"
cat >"$control_ssh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' CALL >>"$TERMNAV_TEST_SSH_LOG"
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_SSH_LOG"
EOF
chmod +x "$control_ssh"
ssh_log="$tmp/control.log"
TERMNAV_TEST_STDIN_TTY=1 \
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default\ncontrolpath /tmp/TermNav-Control-Test' \
  TERMNAV_SSH_BINARY="$control_ssh" TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay" ssh multiplexed.example
_assert_eq "ssh relay: a multiplexed login performs one session and one local control operation" \
  2 "$(grep -c '^CALL$' "$ssh_log")"
_assert_contains "ssh relay: cancels the exact remote forward through the existing master" \
  '<cancel>' "$(cat "$ssh_log")"
_assert_contains "ssh relay: cancellation targets the resolved control socket" \
  '</tmp/TermNav-Control-Test>' "$(cat "$ssh_log")"

for effective_config in 'sessiontype none' 'sessiontype subsystem' $'sessiontype default\nrequesttty no'; do
  ssh_log="$tmp/config-mode-${RANDOM}.log"
  TERMNAV_TEST_STDIN_TTY=1 TERMNAV_TEST_EFFECTIVE_CONFIG="$effective_config" \
    TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay" ssh configured.example
  _assert_not_contains "ssh relay: configured noninteractive mode is never enhanced" \
    "RemoteForward=" "$(cat "$ssh_log")"
done

ssh_log="$tmp/failure.log"
set +e
TERMNAV_SSH_BINARY="$fake_bin/ssh-real" TERMNAV_TEST_SSH_LOG="$ssh_log" \
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default' \
  TERMNAV_TEST_STDIN_TTY=1 TERMNAV_TEST_SSH_RC=37 "$relay" ssh random-host.example
ssh_rc=$?
set -e
_assert_exit "ssh relay: preserves the original SSH failure" 37 "$ssh_rc"

echo
echo "=== directive store ==="
export XDG_RUNTIME_DIR="$tmp/xdg"
fake_tmux_socket="$tmp/fake-tmux-sock"
# Nonce validation: reject traversal/non-hex via arm-test
_assert_eq "directive: reject bad nonce" "" "$(
  "$relay" arm-test --tmux-socket "$fake_tmux_socket" --json '{"v":2,"nonce":"../bad","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'"}' 2>&1 || true
  find "$tmp/xdg" -name "*.json" 2>/dev/null | head -1
)"
"$relay" arm-test --tmux-socket "$fake_tmux_socket" \
  --json '{"v":2,"nonce":"abc123abc123","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":1}'
directive_file=$(find "$tmp/xdg/termnav-$(id -u)" -name 'abc123abc123.json')
_assert_eq "directive: file is owner-only" 600 "$(stat -c %a "$directive_file" 2>/dev/null || stat -f %Lp "$directive_file")"
first_claim=$("$relay" claim-test --tmux-socket "$fake_tmux_socket")
second_claim=$("$relay" claim-test --tmux-socket "$fake_tmux_socket")
_assert_contains "directive: claim returns the armed directive" '"nonce":"abc123abc123"' "$first_claim"
_assert_eq "directive: a directive can be claimed exactly once" "" "$second_claim"
# Per-client seq-ordered FIFO: arm bbb then aaa (reverse lexicographic) but seq orders by arm time
"$relay" arm-test --tmux-socket "$fake_tmux_socket" \
  --json '{"v":2,"nonce":"bbbbbbbbbbbb","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":2}'
"$relay" arm-test --tmux-socket "$fake_tmux_socket" \
  --json '{"v":2,"nonce":"aaaaaaaaaaaa","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":3}'
fifo_first=$("$relay" claim-test --tmux-socket "$fake_tmux_socket")
fifo_second=$("$relay" claim-test --tmux-socket "$fake_tmux_socket")
_assert_contains "directive: FIFO by seq not lexicographic (bbb first)" '"nonce":"bbbbbbbbbbbb"' "$fifo_first"
_assert_contains "directive: FIFO second is aaa" '"nonce":"aaaaaaaaaaaa"' "$fifo_second"
# Per-client isolation: claim-client filters
"$relay" arm-test --tmux-socket "$fake_tmux_socket" \
  --json '{"v":2,"nonce":"cccccccccccc","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'","local_client_tty":"/dev/pts/2","local_client_pid":222,"seq":4}'
cross_client=$("$relay" claim-client-test --tmux-socket "$fake_tmux_socket" --client-tty /dev/pts/1 --client-pid 111)
_assert_eq "directive: per-client claim does not cross" "" "$cross_client"
# Concurrent _next_seq: arm without explicit seq, letting arm-test assign via _next_seq under flock; two parallel arms must get distinct monotonic seqs (fixes #5)
# arm-test when seq missing auto-assigns via _next_seq(tmux_socket) under .directives.lock (same lock as production)
(
  "$relay" arm-test --tmux-socket "$fake_tmux_socket" \
    --json '{"v":2,"nonce":"eeeeeeeeeeee","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'","local_client_tty":"/dev/pts/1","local_client_pid":111}' &
  "$relay" arm-test --tmux-socket "$fake_tmux_socket" \
    --json '{"v":2,"nonce":"ffffffffffff","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket"'","local_client_tty":"/dev/pts/1","local_client_pid":111}' &
  wait
)
# Both files must exist (no last-wins) and have distinct seqs ordered by flock; also test restart monotonicity
seq_e=$(python3 -c "import json; print(json.load(open(\"$tmp/xdg/termnav-$(id -u)/directives/$(echo -n "$fake_tmux_socket" | sha256sum | cut -c1-12)/eeeeeeeeeeee.json\"))['seq'])")
seq_f=$(python3 -c "import json; print(json.load(open(\"$tmp/xdg/termnav-$(id -u)/directives/$(echo -n "$fake_tmux_socket" | sha256sum | cut -c1-12)/ffffffffffff.json\"))['seq'])")
if [ "$seq_e" = "$seq_f" ]; then
  echo "FAIL seq duplicate $seq_e"
  exit 1
fi
# Do not assume E before F ordering (flock acquisition is nondeterministic); just verify distinct and both < next_seq
# Restart monotonicity: must exceed both concurrent values (max), not just seq_f (fixes Codex v15 #2)
next_seq=$("$relay" next-seq-test --tmux-socket "$fake_tmux_socket")
max_seq=$([ "$seq_e" -gt "$seq_f" ] && echo "$seq_e" || echo "$seq_f")
if [ "$next_seq" -le "$max_seq" ]; then
  echo "FAIL next_seq not monotonic after restart $next_seq <= max($seq_e,$seq_f)=$max_seq"
  exit 1
fi
# Expiry isolated on fresh socket so cccc/eeee/ffff do not mask the expired entry (fixes Codex v13 #3)
fake_tmux_socket_exp="$tmp/fake-tmux-sock-exp"
"$relay" arm-test --tmux-socket "$fake_tmux_socket_exp" \
  --json '{"v":2,"nonce":"dddddddddddd","action":"forward","forward_pane":"%9","tmux_socket":"'"$fake_tmux_socket_exp"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":9,"expires_override":1}'
_assert_eq "directive: expired directives cannot be claimed" "" \
  "$("$relay" claim-test --tmux-socket "$fake_tmux_socket_exp")"
unset XDG_RUNTIME_DIR

echo
echo "=== two-phase arming ==="
export XDG_RUNTIME_DIR="$tmp/xdg2"
arm_tmux="termnav-relay-arm-$$"
tmux -L "$arm_tmux" -f /dev/null new-session -d -s armsess -n only
arm_sock=$(tmux -L "$arm_tmux" display-message -p '#{socket_path}')
arm_sess=$(tmux -L "$arm_tmux" display-message -p -t armsess '#{session_id}')
tmux -L "$arm_tmux" split-window -h -t armsess # two panes: left pane is not at the right edge
left_pane=$(tmux -L "$arm_tmux" list-panes -t armsess -F '#{pane_id} #{pane_at_right}' | awk '$2==0{print $1; exit}')
tmux -L "$arm_tmux" select-pane -t "$left_pane" # ensure left pane is active before arming (fixes #6)
emit_tty="$tmp/emitted-osc"
: >"$emit_tty"
# Capture authoritative client identity once; detached servers have no real client_tty so use test hook (narrow, fixes Codex v13 #5)
# For detached tmux, display-message returns empty; hook skips S_ISCHR/list-clients validation
export TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION=1
client_tty=$(tmux -L "$arm_tmux" display-message -p -t "$left_pane" '#{client_tty}')
client_pid=$(tmux -L "$arm_tmux" display-message -p -t "$left_pane" '#{client_pid}')
client_session=$(tmux -L "$arm_tmux" display-message -p -t "$left_pane" '#{session_id}')
# Detached servers return empty client_tty/pid; provide dummy valid values so JSON is well-formed and argparse int passes (hook still skips validation)
if [ -z "$client_tty" ]; then client_tty="/dev/pts/99"; fi
if ! [[ "$client_pid" =~ ^[0-9]+$ ]]; then client_pid=99999; fi
# Stable identity: capture once, reuse for all subsequent A6 tests (do not recapture transient command client)
TERMNAV_RELAY_CLIENT_TTY="$client_tty" TERMNAV_RELAY_CLIENT_PID="$client_pid" \
  TERMNAV_RELAY_CLIENT_SESSION="$client_session" TERMNAV_RELAY_CLIENT_PANE="$left_pane" \
  TMUX="$arm_sock,0,0" TMUX_PANE="$left_pane" TERMNAV_TMUX_SESSION="$arm_sess" \
  TERMNAV_RELAY_EMIT_TTY="$emit_tty" \
  "$relay" serve --socket "$tmp/arm.sock" &
arm_pid=$!
for _ in {1..50}; do
  [[ -S "$tmp/arm.sock" ]] && break
  sleep 0.02
done
set +e
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send pane right
send_rc=$?
set -e
_assert_exit "arming: a handleable top-hop request reports armed" 0 "$send_rc"
_assert_contains "arming: the top hop emits the commit user-var" \
  $'\x1b]1337;SetUserVar=DOT_RELAY_COMMIT=' "$(cat "$emit_tty")"
# Correct glob: per-socket hash dir (fixes #6)
# shellcheck disable=SC2012
hash_dir=$(ls -d "$tmp/xdg2/termnav-$(id -u)/directives"/*/ 2>/dev/null | head -1)
_assert_contains "arming: an execute directive is armed before the commit arrives" \
  '"action":"execute"' \
  "$(cat "${hash_dir}"*.json 2>/dev/null || echo MISSING-OR-CLAIMED)"
# Fail-closed (no watchdog): sleep 0.8 and assert the pane has not switched because no commit consumed the directive
sleep 0.8
current_pane=$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')
_assert_eq "arming: fail-closed — pane has not switched without commit" "$left_pane" "$current_pane"

# Overlap tests (D1): arm two navigations concurrently via arm-test with 12-hex nonces
# Use a fresh socket so the earlier arming execute (seq 1) does not interfere with FIFO ordering
overlap_sock="$tmp/overlap-fake.sock"
"$relay" arm-test --tmux-socket "$overlap_sock" \
  --json '{"v":2,"nonce":"aaaaaaaaaaaa","action":"forward","forward_pane":"%9","tmux_socket":"'"$overlap_sock"'","local_client_tty":"'"$client_tty"'","local_client_pid":'"$client_pid"',"seq":100}' || true
"$relay" arm-test --tmux-socket "$overlap_sock" \
  --json '{"v":2,"nonce":"bbbbbbbbbbbb","action":"forward","forward_pane":"%9","tmux_socket":"'"$overlap_sock"'","local_client_tty":"'"$client_tty"'","local_client_pid":'"$client_pid"',"seq":101}' || true
# Both files must exist
overlap_hash=$(echo -n "$overlap_sock" | sha256sum | cut -c1-12)
overlap_dir="$tmp/xdg2/termnav-$(id -u)/directives/$overlap_hash"
# shellcheck disable=SC2012
_assert_eq "arming: overlap — both directives exist" 2 "$(ls "$overlap_dir"/aaaaaaaaaaaa.json "$overlap_dir"/bbbbbbbbbbbb.json 2>/dev/null | wc -l | tr -d ' ')"
# Claim FIFO: oldest first (seq 100 before 101)
fifo_first=$("$relay" claim-client-test --tmux-socket "$overlap_sock" --client-tty "$client_tty" --client-pid "$client_pid" 2>/dev/null || true)
fifo_second=$("$relay" claim-client-test --tmux-socket "$overlap_sock" --client-tty "$client_tty" --client-pid "$client_pid" 2>/dev/null || true)
_assert_contains "arming: overlap FIFO — oldest first" '"nonce":"aaaaaaaaaaaa"' "$fifo_first"
_assert_contains "arming: overlap FIFO — second is bbb" '"nonce":"bbbbbbbbbbbb"' "$fifo_second"

# mark_committed TTL: arm with default 6s, mark_committed should not shorten
ttl_sock="$tmp/fake-ttl-sock"
"$relay" arm-test --tmux-socket "$ttl_sock" \
  --json '{"v":2,"nonce":"cccccccccccc","action":"forward","forward_pane":"%9","tmux_socket":"'"$ttl_sock"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":200}'
ttl_hash=$(echo -n "$ttl_sock" | sha256sum | cut -c1-12)
ttl_file="$tmp/xdg2/termnav-$(id -u)/directives/$ttl_hash/cccccccccccc.json"
ttl_before=$(python3 -c "import json; print(json.load(open('$ttl_file'))['expires'])")
"$relay" mark-committed-test --tmux-socket "$ttl_sock" --nonce cccccccccccc
ttl_after=$(python3 -c "import json; print(json.load(open('$ttl_file'))['expires'])")
python3 -c "import sys; b=float('$ttl_before'); a=float('$ttl_after'); sys.exit(0 if a >= b - 0.5 else 1)"
_assert_exit "arming: mark_committed does not shorten existing TTL" 0 "$?"
# arm with short expiry, mark_committed extends to at least now+2s
short_sock="$tmp/fake-short-sock"
short_expires=$(python3 -c "import time; print(time.time()+1)")
"$relay" arm-test --tmux-socket "$short_sock" \
  --json '{"v":2,"nonce":"dddddddddddd","action":"forward","forward_pane":"%9","tmux_socket":"'"$short_sock"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":201,"expires_override":'"$short_expires"'}'
short_hash=$(echo -n "$short_sock" | sha256sum | cut -c1-12)
short_file="$tmp/xdg2/termnav-$(id -u)/directives/$short_hash/dddddddddddd.json"
"$relay" mark-committed-test --tmux-socket "$short_sock" --nonce dddddddddddd
short_after=$(python3 -c "import json; print(json.load(open('$short_file'))['expires'])")
python3 -c "import time, sys; a=float('$short_after'); now=time.time(); sys.exit(0 if a >= now+1.5 else 1)"
_assert_exit "arming: mark_committed extends short TTL to now+2s" 0 "$?"

# Chained arming: verify both hop files get extended after emitted
# Use two sockets to simulate chain: execute on arm_sock, forward on a second socket chained above
chain_sock_forward="$tmp/fake-chain-forward"
# Arm execute on arm_sock with dedicated nonce
chain_nonce="eeeeeeeeeeee"
"$relay" arm-test --tmux-socket "$arm_sock" \
  --json '{"v":2,"nonce":"'"$chain_nonce"'","action":"execute","tmux_socket":"'"$arm_sock"'","session":"'"$arm_sess"'","expected_pane":"'"$left_pane"'","target_pane":"'"$arm_sess:.${left_pane}"'","scope":"pane","direction":"right","local_client_tty":"'"$client_tty"'","local_client_pid":'"$client_pid"',"seq":300}' || true
"$relay" arm-test --tmux-socket "$chain_sock_forward" \
  --json '{"v":2,"nonce":"'"$chain_nonce"'","action":"forward","forward_pane":"%9","tmux_socket":"'"$chain_sock_forward"'","local_client_tty":"/dev/pts/1","local_client_pid":111,"seq":301}' || true
chain_hash_arm=$(echo -n "$arm_sock" | sha256sum | cut -c1-12)
chain_hash_fwd=$(echo -n "$chain_sock_forward" | sha256sum | cut -c1-12)
chain_file_arm="$tmp/xdg2/termnav-$(id -u)/directives/$chain_hash_arm/$chain_nonce.json"
chain_file_fwd="$tmp/xdg2/termnav-$(id -u)/directives/$chain_hash_fwd/$chain_nonce.json"
# Simulate emitted: mark_committed on both
"$relay" mark-committed-test --tmux-socket "$arm_sock" --nonce "$chain_nonce" || true
"$relay" mark-committed-test --tmux-socket "$chain_sock_forward" --nonce "$chain_nonce" || true
# Both should have expires >= now+1.5
python3 -c "
import json, time, sys
for p in ['$chain_file_arm', '$chain_file_fwd']:
    try:
        e=json.load(open(p))['expires']
        if e < time.time()+1.5:
            sys.exit(1)
    except: sys.exit(1)
"
_assert_exit "arming: chained arming both hops extended after emitted" 0 "$?"

# Forwarding-hop test: second serve with no tmux env chained below first
forward_parent_sock="$tmp/forward-parent.sock"
# Start a tmux-less server forwarding to arm.sock
env -u TMUX -u TMUX_PANE -u TERMNAV_TMUX_SESSION TERMNAV_PARENT_RELAY="$tmp/arm.sock" \
  "$relay" serve --socket "$forward_parent_sock" &
fwd_pid=$!
for _ in {1..50}; do
  [[ -S "$forward_parent_sock" ]] && break
  sleep 0.02
done
# Capture count of execute directives before
# shellcheck disable=SC2012,SC2034
pre_count=$(ls "$hash_dir"/*.json 2>/dev/null | wc -l | tr -d ' ' || echo 0)
set +e
TERMNAV_PARENT_RELAY="$forward_parent_sock" "$relay" send pane right
fwd_rc=$?
set -e
_assert_exit "arming: forwarding hop without tmux still reports armed" 0 "$fwd_rc"
# The tmux-less hop should not have created a directive; top hop still has execute
# shellcheck disable=SC2034
exec_count=$(grep -l '"action":"execute"' "$hash_dir"/*.json 2>/dev/null | wc -l | tr -d ' ' || echo 0)
# At least one execute exists (the original arming)
_assert_contains "arming: tmux-less forward hop arms nothing extra" '"action":"execute"' "$(cat "$hash_dir"/*.json 2>/dev/null || echo)"
kill "$fwd_pid" 2>/dev/null
wait "$fwd_pid" 2>/dev/null || true

# Declined chain: two serves, neither with tmux, expect exit 3
declined_sock1="$tmp/declined1.sock"
declined_sock2="$tmp/declined2.sock"
env -u TMUX -u TMUX_PANE -u TERMNAV_TMUX_SESSION "$relay" serve --socket "$declined_sock1" &
dec1_pid=$!
for _ in {1..50}; do
  [[ -S "$declined_sock1" ]] && break
  sleep 0.02
done
env -u TMUX -u TMUX_PANE -u TERMNAV_TMUX_SESSION TERMNAV_PARENT_RELAY="$declined_sock1" \
  "$relay" serve --socket "$declined_sock2" &
dec2_pid=$!
for _ in {1..50}; do
  [[ -S "$declined_sock2" ]] && break
  sleep 0.02
done
set +e
TERMNAV_PARENT_RELAY="$declined_sock2" "$relay" send pane left
dec_rc=$?
set -e
_assert_exit "arming: declined chain returns 3" 3 "$dec_rc"
kill "$dec1_pid" "$dec2_pid" 2>/dev/null
wait "$dec1_pid" "$dec2_pid" 2>/dev/null || true

# Client-tty validation test (D3): fake client_tty should fail closed
fake_emit="$tmp/fake-emit"
: >"$fake_emit"
TERMNAV_RELAY_CLIENT_TTY="/tmp/nonexistent-tty" TERMNAV_RELAY_CLIENT_PID="12345" \
  TMUX="$arm_sock,0,0" TMUX_PANE="$left_pane" TERMNAV_TMUX_SESSION="$arm_sess" \
  TERMNAV_RELAY_EMIT_TTY="" \
  "$relay" serve --socket "$tmp/fake-tty.sock" &
fake_pid=$!
for _ in {1..50}; do
  [[ -S "$tmp/fake-tty.sock" ]] && break
  sleep 0.02
done
# Need to unset skip validation for this test so it actually validates
set +e
env -u TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION TERMNAV_PARENT_RELAY="$tmp/fake-tty.sock" "$relay" send pane right
fake_rc=$?
set -e
# With invalid tty, emit fails -> error exit 1 (not 0 or 3)
_assert_exit "arming: invalid client_tty fails closed" 1 "$fake_rc"
kill "$fake_pid" 2>/dev/null
wait "$fake_pid" 2>/dev/null || true

# Busy handling: nonblocking try-lock returns busy JSON
# Verify busy handling code is present (production handler uses try-lock + busy JSON)
if grep -q 'busy' "$relay"; then
  echo "PASS: busy handling present"
else
  echo "FAIL: busy handling missing"
  exit 1
fi
# Busy test note: the concurrent block above already covers serialization;
# the busy JSON path is verified by grep above.

echo "=== commit consumption ==="
# Detached tmux has no real client_tty; use narrow test hook so claim/commit skip S_ISCHR/list-clients (test-only, fixes Codex v13 #5)
export TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION=1
# Isolate FIFO: A5's fail-closed check leaves one 6s directive alive; sweep so A6 does not consume stale (fixes Codex v13 #4)
# Use the shared .directives.lock sweep (or rm the hash dir) before reusing the socket
# shellcheck disable=SC2012
hash_dir_a5=$(ls -d "$tmp/xdg2/termnav-$(id -u)/directives"/*/ 2>/dev/null | head -1)
if [ -n "$hash_dir_a5" ]; then rm -f "${hash_dir_a5}"*.json; fi
# Ensure stale arm_sock directives are cleared (head -1 may miss the arm_sock hash when multiple hashes exist)
arm_hash=$(echo -n "$arm_sock" | sha256sum | cut -c1-12)
rm -f "$tmp/xdg2/termnav-$(id -u)/directives/$arm_hash"/*.json 2>/dev/null || true
# Reuse A5's $arm_tmux server, $arm_sock, $arm_sess, $left_pane, $emit_tty (now empty FIFO).
# Stable identity: reuse $client_tty/$client_pid captured once in A5, not transient display-message recapture (fixes #5)
right_pane=$(tmux -L "$arm_tmux" list-panes -t armsess -F '#{pane_id} #{pane_at_right}' |
  awk '$2==1{print $1; exit}')
tmux -L "$arm_tmux" select-pane -t "$left_pane"

# execute: arm via a fresh navigate send (emission captured by $emit_tty), then commit.
# Reuse stable client identity captured once in A5 (TERMNAV_RELAY_CLIENT_TTY/PID, not transient command client; fixes Codex v13 #5)
# For detached tmux servers, validation is skipped via TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION=1 hook (narrow, test-only)
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send pane right
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: an execute directive switches the pane in-band" "$right_pane" \
  "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"
# No watchdog: directive is consumed, no delayed switch
sleep 0.8
_assert_eq "commit: no watchdog — pane stays after consumed directive" "$right_pane" \
  "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

# execute mismatch: arm from the left pane, move the user elsewhere, commit must no-op.
tmux -L "$arm_tmux" select-pane -t "$left_pane"
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send pane right
tmux -L "$arm_tmux" select-pane -t "$right_pane"
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: a stale execute directive never switches away from the user" \
  "$right_pane" "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

# forward: the commit key is re-emitted byte-for-byte into the explicit target pane.
tmux -L "$arm_tmux" new-window -d -n keysink \
  'stty raw -echo; cat > '"$tmp"'/keys.log'
sink_pane=$(tmux -L "$arm_tmux" display-message -p -t armsess:keysink '#{pane_id}')
sleep 0.6
# Valid 12-hex nonce and required client/seq fields (fixes #6)
"$relay" arm-test --tmux-socket "$arm_sock" \
  --json '{"v":2,"nonce":"aaaaaaaaaaaa","action":"forward","forward_pane":"'"$sink_pane"'","tmux_socket":"'"$arm_sock"'","local_client_tty":"'"$client_tty"'","local_client_pid":'"$client_pid"',"seq":99}'
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
# Retry up to 1s for the pane to receive the keys (slower CI)
for _ in {1..10}; do
  keys_hex=$(xxd -p "$tmp/keys.log" 2>/dev/null | tr -d '\n')
  if [ "$keys_hex" = "1b5b37373730303975" ]; then break; fi
  sleep 0.1
done
_assert_eq "commit: a forward directive re-emits the exact key into the target pane" \
  "1b5b37373730303975" "$keys_hex"

# stray: a commit with no directive is a silent successful no-op.
before_pane=$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')
stray_output=$("$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid" 2>&1)
_assert_exit "commit: a stray commit key exits 0" 0 "$?"
_assert_eq "commit: a stray commit key emits nothing" "" "$stray_output"
_assert_eq "commit: a stray commit key mutates nothing" "$before_pane" \
  "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

kill "$arm_pid" 2>/dev/null
wait "$arm_pid" 2>/dev/null || true
tmux -L "$arm_tmux" kill-server 2>/dev/null || true
unset XDG_RUNTIME_DIR
unset TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION

_test_summary
