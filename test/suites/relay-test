# Detached tmux has no real client_tty; use narrow test hook so claim/commit skip S_ISCHR/list-clients (test-only, fixes Codex v13 #5)
export TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION=1
# Isolate FIFO: A5's fail-closed check leaves one 6s directive alive; sweep so A6 does not consume stale (fixes Codex v13 #4)
# Use the shared .directives.lock sweep (or rm the hash dir) before reusing the socket
# shellcheck disable=SC2012
hash_dir_a5=$(ls -d "$tmp/xdg2/termnav-$(id -u)/directives"/*/ 2>/dev/null | head -1)
if [ -n "$hash_dir_a5" ]; then rm -f "${hash_dir_a5}"*.json; fi
# Ensure stale arm_sock directives are cleared (head -1 may miss the arm_sock hash when multiple hashes exist)
arm_hash=$(echo -n "$arm_sock" | sha256sum | cut -c1-12)
rm -f "$tmp/xdg2/termnav-$(id -u)/directives/$arm_hash"/*.json 2>/dev/null || true
# Reuse A5's $arm_tmux server, $arm_sock, $arm_sess, $left_pane, $emit_tty (now empty FIFO).
# Stable identity: reuse $client_tty/$client_pid captured once in A5, not transient display-message recapture (fixes #5)
right_pane=$(tmux -L "$arm_tmux" list-panes -t armsess -F '#{pane_id} #{pane_at_right}' |
  awk '$2==1{print $1; exit}')
tmux -L "$arm_tmux" select-pane -t "$left_pane"

# execute: arm via a fresh navigate send (emission captured by $emit_tty), then commit.
# Reuse stable client identity captured once in A5 (TERMNAV_RELAY_CLIENT_TTY/PID, not transient command client; fixes Codex v13 #5)
# For detached tmux servers, validation is skipped via TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION=1 hook (narrow, test-only)
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send pane right
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: an execute directive switches the pane in-band" "$right_pane" \
  "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"
# No watchdog: directive is consumed, no delayed switch
sleep 0.8
_assert_eq "commit: no watchdog — pane stays after consumed directive" "$right_pane" \
  "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

# execute mismatch: arm from the left pane, move the user elsewhere, commit must no-op.
tmux -L "$arm_tmux" select-pane -t "$left_pane"
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send pane right
tmux -L "$arm_tmux" select-pane -t "$right_pane"
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: a stale execute directive never switches away from the user" \
  "$right_pane" "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

# Cross-window staleness: pane_active is window-local, so every execute scope
# must compare the session's selected pane with expected_pane at mutation time.
tmux -L "$arm_tmux" select-pane -t "$left_pane"
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send pane right
tmux -L "$arm_tmux" new-window -d -n elsewhere
elsewhere_pane=$(tmux -L "$arm_tmux" display-message -p -t armsess:elsewhere '#{pane_id}')
tmux -L "$arm_tmux" select-window -t armsess:elsewhere
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: stale cross-window pane directive leaves its old window unchanged" \
  "$left_pane" "$(tmux -L "$arm_tmux" display-message -p -t armsess:0 '#{pane_id}')"
_assert_eq "commit: stale cross-window pane directive keeps the user's window" \
  "$elsewhere_pane" "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

tmux -L "$arm_tmux" select-window -t armsess:0
tmux -L "$arm_tmux" select-pane -t "$left_pane"
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send window next
tmux -L "$arm_tmux" select-window -t armsess:elsewhere
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: stale cross-window window directive keeps the user's window" \
  "$elsewhere_pane" "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

tmux -L "$arm_tmux" select-window -t armsess:0
TERMNAV_PARENT_RELAY="$tmp/arm.sock" "$relay" send move right
tmux -L "$arm_tmux" select-window -t armsess:elsewhere
window_order_before=$(tmux -L "$arm_tmux" list-windows -t armsess -F '#{window_id}')
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
_assert_eq "commit: stale cross-window move directive does not reorder windows" \
  "$window_order_before" "$(tmux -L "$arm_tmux" list-windows -t armsess -F '#{window_id}')"

# forward: the commit key is re-emitted byte-for-byte into the explicit target pane.
tmux -L "$arm_tmux" new-window -d -n keysink \
  'stty raw -echo; cat > '"$tmp"'/keys.log'
sink_pane=$(tmux -L "$arm_tmux" display-message -p -t armsess:keysink '#{pane_id}')
sleep 0.6
# Valid 12-hex nonce and required client/seq fields (fixes #6)
"$relay" arm-test --tmux-socket "$arm_sock" \
  --json '{"v":2,"nonce":"aaaaaaaaaaaa","action":"forward","forward_pane":"'"$sink_pane"'","tmux_socket":"'"$arm_sock"'","local_client_tty":"'"$client_tty"'","local_client_pid":'"$client_pid"',"seq":99}'
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid"
# Retry up to 1s for the pane to receive the keys (slower CI)
for _ in {1..10}; do
  keys_hex=$(python3 -c "import pathlib; p=pathlib.Path('$tmp/keys.log'); print(p.read_bytes().hex() if p.exists() else '')" 2>/dev/null | tr -d '\n')
  if [ "$keys_hex" = "1b5b37373730303975" ]; then break; fi
  sleep 0.1
done
_assert_eq "commit: a forward directive re-emits the exact key into the target pane" \
  "1b5b37373730303975" "$keys_hex"

# stray: a commit with no directive is a silent successful no-op.
before_pane=$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')
stray_output=$("$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" --client-pid "$client_pid" 2>&1)
_assert_exit "commit: a stray commit key exits 0" 0 "$?"
_assert_eq "commit: a stray commit key emits nothing" "" "$stray_output"
_assert_eq "commit: a stray commit key mutates nothing" "$before_pane" \
  "$(tmux -L "$arm_tmux" display-message -p -t armsess '#{pane_id}')"

# A DECRQM response that has no pending Termnav directive belongs to the pane
# application on older tmux releases, which forward the query to their client.
tmux -L "$arm_tmux" respawn-pane -k -t "$sink_pane" \
  'stty raw -echo; cat > '"$tmp"'/decrqm-keys.log'
sleep 0.6
"$relay" commit --tmux-socket "$arm_sock" --client-tty "$client_tty" \
  --client-pid "$client_pid" --passthrough-decrqm 2 --pane "$sink_pane"
for _ in {1..10}; do
  decrqm_hex=$(python3 -c "import pathlib; p=pathlib.Path('$tmp/decrqm-keys.log'); print(p.read_bytes().hex() if p.exists() else '')" 2>/dev/null | tr -d '\n')
  if [ "$decrqm_hex" = "1b5b3f323030343b322479" ]; then break; fi
  sleep 0.1
done
_assert_eq "commit: unmatched DECRQM replies return to the originating pane" \
  "1b5b3f323030343b322479" "$decrqm_hex"

kill "$arm_pid" 2>/dev/null
wait "$arm_pid" 2>/dev/null || true
tmux -L "$arm_tmux" kill-server 2>/dev/null || true
unset XDG_RUNTIME_DIR
unset TERMNAV_RELAY_TEST_SKIP_TTY_VALIDATION

_test_summary
