#!/usr/bin/env bash
# relay-test - hop-by-hop navigation transport and SSH integration.

set -euo pipefail
export NO_COLOR=1

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"
# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"

relay_adapter=$(_tmpdir)/termnav-relay
_termnav_command_adapter "$relay_adapter" \
  "${TERMNAV_TEST_BINARY:-$root/target/release/termnav}" relay
relay=$relay_adapter
relay_server="$test_dir/support/relay-server.py"
relay_ssh=$(_tmpdir)/termnav-ssh
_termnav_command_adapter "$relay_ssh" \
  "${TERMNAV_TEST_BINARY:-$root/target/release/termnav}" ssh
tmp=$(_tmpdir)
log="$tmp/route.log"
socket="$tmp/parent.sock"

echo "=== relay listener readiness ==="
bound_socket="$tmp/bound-only.sock"
bound_marker="$tmp/bound-only.ready"
python3 - "$bound_socket" "$bound_marker" <<'PY' &
import pathlib
import socket
import sys
import time

server = socket.socket(socket.AF_UNIX)
server.bind(sys.argv[1])
pathlib.Path(sys.argv[2]).touch()
time.sleep(2)
PY
bound_pid=$!
for _ in {1..50}; do
  [[ -f "$bound_marker" ]] && break
  sleep 0.02
done
_assert_file_exists "relay readiness: bound-only fixture starts" "$bound_marker"
set +e
_wait_for_unix_listener "$bound_socket" 0.1 2>/dev/null
bound_wait_rc=$?
set -e
_assert_exit "relay readiness: a bound-only socket is not ready" 1 "$bound_wait_rc"
kill "$bound_pid" 2>/dev/null || true
wait "$bound_pid" 2>/dev/null || true

listening_socket="$tmp/listening.sock"
listening_marker="$tmp/listening.ready"
python3 - "$listening_socket" "$listening_marker" <<'PY' &
import pathlib
import signal
import socket
import sys

server = socket.socket(socket.AF_UNIX)
server.bind(sys.argv[1])
server.listen(1)
pathlib.Path(sys.argv[2]).touch()
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
connection, _ = server.accept()
connection.close()
PY
listening_pid=$!
for _ in {1..50}; do
  [[ -f "$listening_marker" ]] && break
  sleep 0.02
done
_assert_file_exists "relay readiness: listening fixture starts" "$listening_marker"
set +e
_wait_for_unix_listener "$listening_socket" 1 2>/dev/null
listening_wait_rc=$?
set -e
_assert_exit "relay readiness: a listening socket is ready" 0 "$listening_wait_rc"
kill "$listening_pid" 2>/dev/null || true
wait "$listening_pid" 2>/dev/null || true

echo "=== relay protocol ==="
python3 "$relay_server" --socket "$socket" --log "$log" &
server_pid=$!
_wait_for_unix_listener "$socket"
TERMNAV_PARENT_RELAY="$socket" "$relay" send pane-select left
TERMNAV_PARENT_RELAY="$socket" "$relay" send pane-select down
TERMNAV_PARENT_RELAY="$socket" "$relay" send tab-select next
TERMNAV_PARENT_RELAY="$socket" "$relay" send tab-select previous
TERMNAV_PARENT_RELAY="$socket" "$relay" send tab-move left
TERMNAV_PARENT_RELAY="$socket" "$relay" send tab-move right
socket_mode="$(stat -c %a "$socket" 2>/dev/null || stat -f %Lp "$socket")"
kill "$server_pid"
wait "$server_pid" 2>/dev/null || true
_assert_eq "relay: accepts every navigation operation" \
  $'pane left\npane down\nwindow next\nwindow previous\nmove left\nmove right' "$(cat "$log")"
_assert_eq "relay: owner-only socket permissions" 600 "$socket_mode"
_assert_eq "relay: removes its local socket on shutdown" false "$([[ -e "$socket" ]] && echo true || echo false)"

set +e
bad_output=$(TERMNAV_PARENT_RELAY="$socket" "$relay" send pane-select diagonal 2>&1)
bad_rc=$?
missing_output=$(env -u TERMNAV_PARENT_RELAY "$relay" send pane-select left 2>&1)
missing_rc=$?
set -e
_assert_exit "relay: rejects invalid directions" 2 "$bad_rc"
_assert_contains "relay: invalid direction is actionable" "invalid pane-select direction" "$bad_output"
_assert_exit "relay: absent parent fails silently" 3 "$missing_rc"
_assert_eq "relay: absent parent emits nothing" "" "$missing_output"

echo
echo "=== depth-independent forwarding ==="
outer_socket="$tmp/outer.sock"
inner_socket="$tmp/inner.sock"
chain_log="$tmp/chain.log"
env -u TMUX -u TMUX_PANE python3 "$relay_server" \
  --socket "$outer_socket" --log "$chain_log" &
outer_pid=$!
_wait_for_unix_listener "$outer_socket"
env -u TMUX -u TMUX_PANE TERMNAV_PARENT_RELAY="$outer_socket" \
  "$relay" serve --socket "$inner_socket" &
inner_pid=$!
_wait_for_unix_listener "$inner_socket"
TERMNAV_PARENT_RELAY="$inner_socket" "$relay" send tab-select previous
TERMNAV_PARENT_RELAY="$inner_socket" "$relay" send pane-select right
TERMNAV_PARENT_RELAY="$inner_socket" "$relay" send tab-move left
kill "$inner_pid" "$outer_pid"
wait "$inner_pid" "$outer_pid" 2>/dev/null || true
_assert_eq "relay: two arbitrary hops preserve forward and reverse operations" \
  $'window previous\npane right\nmove left' "$(cat "$chain_log")"

malformed_socket="$tmp/malformed.sock"
malformed_log="$tmp/malformed.log"
python3 "$relay_server" --socket "$malformed_socket" --log "$malformed_log" &
malformed_pid=$!
_wait_for_unix_listener "$malformed_socket"
python3 - "$malformed_socket" <<'PY'
import socket
import sys
for payload in (b"not-json\n", b'{"v":2,"scope":"pane","direction":"left"}\n', b"x" * 257):
    with socket.socket(socket.AF_UNIX) as client:
        client.connect(sys.argv[1])
        client.sendall(payload)
PY
TERMNAV_PARENT_RELAY="$malformed_socket" "$relay" send pane-select up
kill "$malformed_pid"
wait "$malformed_pid" 2>/dev/null || true
_assert_eq "relay: malformed and oversized messages cannot trigger routing" \
  "pane up" "$(cat "$malformed_log")"

concurrent_socket="$tmp/concurrent.sock"
concurrent_log="$tmp/concurrent.log"
python3 "$relay_server" --socket "$concurrent_socket" --log "$concurrent_log" &
concurrent_pid=$!
_wait_for_unix_listener "$concurrent_socket"
python3 - "$concurrent_socket" <<'PY'
import json
import socket
import sys

stalled = socket.socket(socket.AF_UNIX)
stalled.connect(sys.argv[1])
stalled.sendall(b"{")

fragmented = socket.socket(socket.AF_UNIX)
fragmented.connect(sys.argv[1])
payload = json.dumps({"v": 1, "scope": "pane", "direction": "left"}, separators=(",", ":")).encode() + b"\n"
for byte in payload:
    fragmented.send(bytes([byte]))
# v1 is rejected per v18 — must not return b"1" via legacy route()
assert fragmented.recv(1) != b"1"
fragmented.close()
stalled.close()
PY
# With BUSY nonblocking try-lock, 12 parallel would get busy errors; run serially with gap
for _ in {1..12}; do
  TERMNAV_PARENT_RELAY="$concurrent_socket" "$relay" send tab-select next
  sleep 0.02
done
_assert_eq "relay: stalled and concurrent clients cannot block valid fragmented requests" \
  12 "$(wc -l <"$concurrent_log" | tr -d ' ')" # v1 is now rejected (not counted) per v18 #1
set +e
TERMNAV_PARENT_RELAY="$concurrent_socket" "$relay" send pane-select left \
  --client-pid "$$" --client-tty /dev/definitely-not-this-tty >/dev/null 2>&1
tty_mismatch_rc=$?
set -e
_assert_exit "relay: a PID with the wrong client TTY fails closed" 1 "$tty_mismatch_rc"
kill "$concurrent_pid"
wait "$concurrent_pid" 2>/dev/null || true

negative_socket="$tmp/negative.sock"
env -u TMUX -u TMUX_PANE -u TERMNAV_PARENT_RELAY \
  "$relay" serve --socket "$negative_socket" &
negative_pid=$!
_wait_for_unix_listener "$negative_socket"
set +e
TERMNAV_PARENT_RELAY="$negative_socket" "$relay" send pane-select left >/dev/null 2>&1
negative_rc=$?
set -e
_assert_exit "relay: an unhandled request propagates a negative acknowledgement" 3 "$negative_rc"
kill "$negative_pid"
wait "$negative_pid" 2>/dev/null || true

echo
echo "=== stale socket cleanup ==="
# Explicit listener tests do not pass through Termnav's socket-path fallback,
# so give them their own short, owner-only root on macOS. Using /tmp itself
# would correctly fail Termnav's permission checks; the private child keeps the
# security contract realistic while leaving enough sockaddr_un space. Termux
# lacks /tmp and keeps using its application-private temporary root.
if [[ -d /tmp && -w /tmp ]]; then
  portable_tmp=$(mktemp -d /tmp/tnrelay.XXXXXX)
  CLEANUP_DIRS+=("$portable_tmp")
else
  portable_tmp=$(python3 -c 'import tempfile; print(tempfile.gettempdir())')
fi
stale_socket="$portable_tmp/termnav-relay-test-stale-$$.sock"
active_socket="$portable_tmp/termnav-relay-test-active-$$.sock"
unrelated_file="$portable_tmp/termnav-relay-test-file-$$.sock"
symlink_path="$portable_tmp/termnav-relay-test-link-$$.sock"
python3 - "$stale_socket" <<'PY'
import os
import socket
import sys
server = socket.socket(socket.AF_UNIX)
server.bind(sys.argv[1])
server.close()
old = 1
os.utime(sys.argv[1], (old, old))
PY
: >"$unrelated_file"
ln -s "$unrelated_file" "$symlink_path"
"$relay" serve --socket "$active_socket" &
active_pid=$!
_wait_for_unix_listener "$active_socket"
python3 - "$active_socket" <<'PY'
import os
import sys
os.utime(sys.argv[1], (1, 1))
PY
# Point the sweeper at the same portable temporary root. Production discovers
# this through its inherited TMPDIR; making that boundary explicit here keeps
# the fixture independent of the host's much longer default macOS path.
TMPDIR="$portable_tmp" "$relay" sweep
_assert_eq "relay sweep: removes an old dead owner socket" false "$([[ -e "$stale_socket" ]] && echo true || echo false)"
_assert_eq "relay sweep: preserves an old active socket" true "$([[ -S "$active_socket" ]] && echo true || echo false)"
_assert_eq "relay sweep: preserves unrelated regular files" true "$([[ -f "$unrelated_file" ]] && echo true || echo false)"
_assert_eq "relay sweep: preserves symlinks" true "$([[ -L "$symlink_path" ]] && echo true || echo false)"
kill "$active_pid"
wait "$active_pid" 2>/dev/null || true
rm -f "$unrelated_file" "$symlink_path"

echo
echo "=== arbitrary-host SSH integration ==="
fake_bin="$tmp/bin"
# This assertion specifically exercises the preferred XDG runtime branch, so
# give it a path that is provably short even when macOS starts mktemp below its
# long /var/folders hierarchy. Platforms without /tmp (notably Termux) retain
# their application-private temporary root, which already fits there.
if [[ -d /tmp && -w /tmp ]]; then
  ssh_runtime=$(mktemp -d /tmp/tnssh.XXXXXX)
  CLEANUP_DIRS+=("$ssh_runtime")
else
  ssh_runtime="$_TEST_TMP_ROOT"
fi
mkdir -p "$fake_bin"
export XDG_RUNTIME_DIR="$ssh_runtime"
cat >"$fake_bin/ssh-real" <<'EOF'
#!/usr/bin/env bash
if [[ ${1:-} == -G ]]; then
  printf '<%s>\n' "$@" >"$TERMNAV_TEST_SSH_LOG"
  printf '%s\n' "${TERMNAV_TEST_EFFECTIVE_CONFIG:-requesttty auto
sessiontype default}"
  exit 0
fi
printf '<%s>\n' "$@" >"$TERMNAV_TEST_SSH_LOG"
exit "${TERMNAV_TEST_SSH_RC:-0}"
EOF
chmod +x "$fake_bin/ssh-real"
ln -s ssh-real "$fake_bin/ssh"
PATH="$fake_bin:$PATH"
export PATH

for destination in arbitrary.example alice@host-with-alias '[2001:db8::7]'; do
  ssh_log="$tmp/ssh-${destination//[^a-zA-Z0-9]/_}.log"
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default' \
    TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay_ssh" -t -p 2222 "$destination"
  ssh_args=$(cat "$ssh_log")
  _assert_contains "ssh relay: preserves arbitrary destination $destination" "<$destination>" "$ssh_args"
  _assert_contains "ssh relay: uses the original SSH process for forwarding" "<RemoteForward=" "$ssh_args"
  forward=${ssh_args#*<RemoteForward=}
  forward=${forward%%>*}
  local_socket=${forward#*:}
  _assert_eq "ssh relay: short fixture root exercises the primary runtime path" \
    true "$([[ $local_socket == "$ssh_runtime"/termnav-*/* ]] && echo true || echo false)"
  _assert_eq "ssh relay: generated local socket fits portable sockaddr_un" \
    true "$([[ ${#local_socket} -le 103 ]] && echo true || echo false)"
  _assert_contains "ssh relay: requests per-session environment forwarding" \
    "<SendEnv=TERMNAV_PARENT_RELAY>" "$ssh_args"
  _assert_not_contains "ssh relay: does not pin metadata in ControlMaster configuration" \
    "<SetEnv=TERMNAV_PARENT_RELAY=" "$ssh_args"
  _assert_eq "ssh relay: leaves the remote command channel empty for $destination" \
    "<$destination>" "$(tail -n 1 "$ssh_log")"
done

ssh_log="$tmp/option-separator.log"
TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default' \
  TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" -t -- option-like.example
separator_line=$(grep -n '^<-->$' "$ssh_log" | cut -d: -f1)
forward_line=$(grep -n '^<RemoteForward=' "$ssh_log" | cut -d: -f1)
_assert_eq "ssh relay: generated options stay before the option separator" \
  true "$([[ $forward_line -lt $separator_line ]] && echo true || echo false)"
_assert_contains "ssh relay: option separator preserves its destination" \
  '<option-like.example>' "$(cat "$ssh_log")"

for destination in -target.example -N-target.example; do
  ssh_log="$tmp/hostile-destination-${destination//[^a-zA-Z0-9]/_}.log"
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default' \
    TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay_ssh" -- "$destination" </dev/null
  _assert_eq "ssh relay: option-like destination never implies tty mode" \
    $'<-->\n<'"$destination"'>' "$(cat "$ssh_log")"
done

ssh_log="$tmp/explicit.log"
TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" other.example printf hello
_assert_eq "ssh relay: explicit commands without a tty remain ordinary SSH" \
  $'<other.example>\n<printf>\n<hello>' "$(cat "$ssh_log")"

ssh_log="$tmp/explicit-tty.log"
TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty force\nsessiontype default' \
  TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" -t other.example printf hello
_assert_contains "ssh relay: explicit tty commands receive the relay forward" \
  "RemoteForward=" "$(cat "$ssh_log")"
_assert_contains "ssh relay: explicit tty commands request relay environment forwarding" \
  "<SendEnv=TERMNAV_PARENT_RELAY>" "$(cat "$ssh_log")"
_assert_eq "ssh relay: explicit tty commands preserve the explicit command arguments" \
  $'<other.example>\n<printf>\n<hello>' "$(tail -n 3 "$ssh_log")"

for mode in '-N mode.example' '-Nf background.example' '-TN no-session.example' '-G config.example' '-O check control.example' '-W target:22 jump.example' '-T no-tty.example' '-f background-only.example'; do
  ssh_log="$tmp/mode-${mode//[^a-zA-Z0-9]/_}.log"
  # shellcheck disable=SC2086 # each fixture intentionally expands to argv.
  TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay_ssh" -t $mode
  _assert_not_contains "ssh relay: control mode $mode is never enhanced" "RemoteForward=" "$(cat "$ssh_log")"
done

ssh_log="$tmp/redirected.log"
TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" redirected.example </dev/null
_assert_not_contains "ssh relay: redirected stdin remains an ordinary session" "RemoteForward=" "$(cat "$ssh_log")"

ssh_log="$tmp/forced-tty.log"
TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" -t forced.example </dev/null
_assert_contains "ssh relay: explicit tty enables a redirected interactive login" "RemoteForward=" "$(cat "$ssh_log")"

ssh_log="$tmp/attached-option.log"
TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty force\nsessiontype default' \
  TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" -t -oRequestTTY=force attached-option.example
_assert_contains "ssh relay: attached option values are not mistaken for flag clusters" \
  "RemoteForward=" "$(cat "$ssh_log")"
_assert_not_contains "ssh relay: configured TTY policy needs no synthetic flag" \
  '<-tt>' "$(cat "$ssh_log")"

for remote_command in 'tmux attach' 'exec dashboard'; do
  ssh_log="$tmp/remote-command-${remote_command//[^a-zA-Z0-9]/_}.log"
  TERMNAV_TEST_EFFECTIVE_CONFIG="requesttty auto
sessiontype default
remotecommand $remote_command" \
    TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay_ssh" -t -oRemoteCommand="$remote_command" configured-command.example
  _assert_eq "ssh relay: configured RemoteCommand remains ordinary SSH" \
    $'<-t>\n<-oRemoteCommand='"$remote_command"$'>\n<configured-command.example>' "$(cat "$ssh_log")"
done

ssh_log="$tmp/strict-forward-failure.log"
TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default\nexitonforwardfailure yes' \
  TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" -t strict.example
_assert_eq "ssh relay: strict forwarding policy remains ordinary SSH" \
  $'<-t>\n<strict.example>' "$(cat "$ssh_log")"

control_ssh="$fake_bin/ssh-control"
cat >"$control_ssh" <<'EOF'
#!/usr/bin/env bash
if [[ ${1:-} == -G ]]; then
  printf '%s\n' "$TERMNAV_TEST_EFFECTIVE_CONFIG"
  exit 0
fi
printf '%s\n' CALL >>"$TERMNAV_TEST_SSH_LOG"
printf '<%s>\n' "$@" >>"$TERMNAV_TEST_SSH_LOG"
EOF
chmod +x "$control_ssh"
ln -sfn ssh-control "$fake_bin/ssh"
ssh_log="$tmp/control.log"
TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default\ncontrolpath /tmp/TermNav-Control-Test' \
  TERMNAV_TEST_SSH_LOG="$ssh_log" \
  "$relay_ssh" -t multiplexed.example
_assert_eq "ssh relay: a multiplexed login performs one session and one local control operation" \
  2 "$(grep -c '^CALL$' "$ssh_log")"
_assert_contains "ssh relay: cancels the exact remote forward through the existing master" \
  '<cancel>' "$(cat "$ssh_log")"
_assert_contains "ssh relay: cancellation targets the resolved control socket" \
  '</tmp/TermNav-Control-Test>' "$(cat "$ssh_log")"

session_env_ssh="$fake_bin/ssh-session-env"
cat >"$session_env_ssh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == -G ]]; then
  printf '%s\n' "$TERMNAV_TEST_EFFECTIVE_CONFIG"
  exit 0
fi

for argument in "$@"; do
  case "$argument" in
    RemoteForward=*) current=${argument#RemoteForward=} ; current=${current%%:*} ;;
    SendEnv=TERMNAV_PARENT_RELAY) offered=1 ;;
    cancel) exit 0 ;;
  esac
done

[[ ${offered:-0} == 1 ]] || exit 9
printf '%s\n' "${current:-}" >>"$TERMNAV_TEST_EXPECTED_RELAYS"
printf '%s\n' "${TERMNAV_PARENT_RELAY:-}" >>"$TERMNAV_TEST_ACTUAL_RELAYS"
EOF
chmod +x "$session_env_ssh"
ln -sfn ssh-session-env "$fake_bin/ssh"
expected_relays="$tmp/expected-relays"
actual_relays="$tmp/actual-relays"
for _ in first second; do
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default\ncontrolpath /tmp/TermNav-Control-Test' \
    TERMNAV_TEST_EXPECTED_RELAYS="$expected_relays" TERMNAV_TEST_ACTUAL_RELAYS="$actual_relays" \
    "$relay_ssh" -t multiplexed.example
done
_assert_eq "ssh relay: each session pairs its current SendEnv value with its forward" \
  "$(cat "$expected_relays")" "$(cat "$actual_relays")"
_assert_eq "ssh relay: session environment regression exercises distinct relay paths" \
  "$(wc -l <"$actual_relays" | tr -d ' ')" "$(sort -u "$actual_relays" | wc -l | tr -d ' ')"

for effective_config in 'sessiontype none' 'sessiontype subsystem' $'sessiontype default\nrequesttty no'; do
  ln -sfn ssh-real "$fake_bin/ssh"
  ssh_log="$tmp/config-mode-${RANDOM}.log"
  TERMNAV_TEST_EFFECTIVE_CONFIG="$effective_config" \
    TERMNAV_TEST_SSH_LOG="$ssh_log" \
    "$relay_ssh" -t configured.example
  _assert_not_contains "ssh relay: configured noninteractive mode is never enhanced" \
    "RemoteForward=" "$(cat "$ssh_log")"
done

ssh_log="$tmp/failure.log"
ln -sfn ssh-real "$fake_bin/ssh"
set +e
TERMNAV_TEST_SSH_LOG="$ssh_log" \
  TERMNAV_TEST_EFFECTIVE_CONFIG=$'requesttty auto\nsessiontype default' \
  TERMNAV_TEST_SSH_RC=37 "$relay_ssh" -t random-host.example
ssh_rc=$?
set -e
_assert_exit "ssh relay: preserves the original SSH failure" 37 "$ssh_rc"

echo
echo "=== SSH relay lifecycle ==="
set +e
# Lifecycle tests intentionally create process trees and exercise SIGKILL. The
# outer group deadline guarantees that a regression in teardown cannot leak a
# relay or SSH fixture and hold the remaining suite indefinitely.
_with_timeout 5m python3 "$test_dir/support/relay_lifecycle_test.py"
lifecycle_rc=$?
set -e
_assert_exit "relay lifecycle: ownership and hard-kill cleanup cases pass" 0 "$lifecycle_rc"

_test_summary
