#!/usr/bin/env bash
# vscode-adapter-test — portable contract checks for the bundled extension.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

extension="$TERMNAV_ROOT/share/termnav/vscode/termnav-0.3.0/extension.js"
manifest="$TERMNAV_ROOT/share/termnav/vscode/termnav-0.3.0/package.json"

echo "=== VS Code adapter contract ==="
_assert_file_exists "focus adapter: versioned manifest is shipped" "$manifest"
_assert_file_exists "focus adapter: implementation is shipped" "$extension"
for retired in termnav-0.1.0 termnav-0.2.0; do
  _assert_eq "focus adapter: retired payload is not shipped: $retired" false \
    "$([[ -e "$TERMNAV_ROOT/share/termnav/vscode/$retired" ]] && echo true || echo false)"
done
content=$(cat "$extension")
_assert_not_contains "focus adapter: sandbox does not inspect host procfs" \
  '/proc/' "$content"
_assert_not_contains "focus adapter: sandbox does not spawn host tools" \
  'child_process' "$content"

if command -v node >/dev/null 2>&1; then
  module_root=$(_tmpdir)
  mkdir -p "$module_root/node_modules/vscode"
  printf 'module.exports = global.__termnavVscode;\n' >"$module_root/node_modules/vscode/index.js"
  output=$(
    _with_timeout 20s env NODE_PATH="$module_root/node_modules" \
      node "$TERMNAV_TEST_DIR/support/vscode-adapter.js" "$extension" "$module_root"
  )
  _assert_contains "focus adapter: production behavior passes" \
    "vscode-adapter: production controller, server, and lifecycle pass" "$output"
else
  echo "  SKIP: VS Code adapter behavior requires Node.js"
fi

_test_summary
