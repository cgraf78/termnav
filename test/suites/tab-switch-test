#!/usr/bin/env bash
# tab-switch-test - nearest-scope tab routing across tmux and terminal hosts.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"

router="$TERMNAV_ROOT/bin/termnav-switch-tab"
socket_backend="$TERMNAV_ROOT/lib/termnav/shell/vscode-backend-socket.sh"
extension_dir="$TERMNAV_ROOT/share/termnav/vscode/termnav-0.2.0"

echo "=== generic tab router surface ==="

set +e
router_help=$("$router" --help 2>&1)
router_help_rc=$?
set -e
_assert_exit "tab router: help exits successfully" 0 "$router_help_rc"
_assert_contains "tab router: documents client-scoped routing" \
  "--client-pid" "$router_help"
_assert_file_exists "VS Code socket backend is shipped" "$socket_backend"
_assert_file_exists "VS Code socket adapter manifest is shipped" "$extension_dir/package.json"
_assert_file_exists "VS Code socket adapter implementation is shipped" "$extension_dir/extension.js"

if [[ ! -x "$router" || ! -r "$socket_backend" || ! -r "$extension_dir/package.json" ||
  ! -r "$extension_dir/extension.js" ]]; then
  _test_summary
fi

router_symlink_bin=$(_tmpdir)
ln -s "$router" "$router_symlink_bin/termnav-switch-tab"
set +e
router_symlink_help=$("$router_symlink_bin/termnav-switch-tab" --help 2>&1)
router_symlink_rc=$?
set -e
_assert_exit "tab router: shdeps-style symlink resolves repository libraries" \
  0 "$router_symlink_rc"
_assert_contains "tab router: symlinked entry point retains its help" \
  "nearest tab scope" "$router_symlink_help"
_assert_not_contains "tab router: Bash 3.2 parsing does not depend on extglob" \
  "+([0-9])" "$(cat "$router")"

echo
echo "=== vscode-backend-socket.sh: per-window adapter routing ==="

mock_bin=$(_tmpdir)
socket_code_log=$(_tmpdir)/socket-code.log
cat >"$mock_bin/curl" <<'EOF'
#!/usr/bin/env bash
{
  printf 'cli=<curl> argv:'
  printf ' <%s>' "$@"
  printf '\n'
} >>"$SOCKET_CODE_LOG"
printf '{}\n'
EOF
chmod +x "$mock_bin/curl"

: >"$socket_code_log"
TERMNAV_VSCODE_SOCKET=/tmp/termnav-window-a.sock SOCKET_CODE_LOG="$socket_code_log" \
  PATH="$mock_bin:$PATH" bash -c "
    . '$socket_backend'
    termnav_vscode_socket_execute_command 'workbench.action.terminal.focusNext'
  "
socket_output=$(cat "$socket_code_log")
_assert_contains "socket backend: preserves the originating adapter socket" \
  "<--unix-socket> </tmp/termnav-window-a.sock>" "$socket_output"
_assert_contains "socket backend: posts directly through the per-window socket" \
  "cli=<curl>" "$socket_output"
_assert_contains "socket backend: sends the next direction as JSON" \
  '{"direction":"next"}' "$socket_output"

set +e
missing_socket_output=$(env -u TERMNAV_VSCODE_SOCKET PATH="$mock_bin:$PATH" bash -c "
  . '$socket_backend'
  termnav_vscode_socket_execute_command 'workbench.action.terminal.focusNext'
" 2>&1)
missing_socket_rc=$?
unsupported_output=$(TERMNAV_VSCODE_SOCKET=/tmp/termnav-window.sock \
  PATH="$mock_bin:$PATH" bash -c "
    . '$socket_backend'
    termnav_vscode_socket_execute_command 'workbench.action.nextEditor'
  " 2>&1)
unsupported_rc=$?
set -e
_assert_exit "socket backend: missing per-window socket fails closed" 1 "$missing_socket_rc"
_assert_eq "socket backend: missing per-window socket is silent" "" "$missing_socket_output"
_assert_exit "socket backend: unrelated commands fail closed" 1 "$unsupported_rc"
_assert_eq "socket backend: unrelated commands are silent" "" "$unsupported_output"

echo
echo "=== VS Code per-window socket extension ==="

manifest_contract=$(
  python3 - "$extension_dir/package.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as manifest_file:
    manifest = json.load(manifest_file)

activation_events = manifest.get("activationEvents", [])
untrusted_workspace = (
    manifest.get("capabilities", {}).get("untrustedWorkspaces", {}).get("supported")
)
print(f"{manifest.get('publisher', '')}.{manifest.get('name', '')}")
print(manifest.get("version", ""))
print(str("onUri" in activation_events).lower())
print(str("*" in activation_events).lower())
print(str(untrusted_workspace is True).lower())
PY
)
_assert_eq "socket adapter: extension id is cgraf.termnav" \
  "cgraf.termnav" "$(sed -n '1p' <<<"$manifest_contract")"
_assert_eq "socket adapter: versioned directory matches its manifest" \
  "termnav-$(sed -n '2p' <<<"$manifest_contract")" "${extension_dir##*/}"
_assert_eq "socket adapter: does not depend on custom URI activation" \
  "false" "$(sed -n '3p' <<<"$manifest_contract")"
_assert_eq "socket adapter: eagerly publishes terminal environment" \
  "true" "$(sed -n '4p' <<<"$manifest_contract")"
_assert_eq "socket adapter: works in restricted workspaces" \
  "true" "$(sed -n '5p' <<<"$manifest_contract")"

if command -v node >/dev/null 2>&1; then
  node_modules=$(_tmpdir)/node_modules
  mkdir -p "$node_modules/vscode"
  cat >"$node_modules/vscode/index.js" <<'EOF'
const calls = [];
const environment = [];
const terminal = { processId: Promise.resolve(process.pid) };

module.exports = {
  commands: {
    executeCommand(command) {
      calls.push(command);
      return Promise.resolve();
    },
  },
  window: {
    activeTerminal: terminal,
    state: { focused: true },
    onDidChangeActiveTerminal() {
      return { dispose() {} };
    },
    onDidCloseTerminal() {
      return { dispose() {} };
    },
    onDidChangeWindowState() {
      return { dispose() {} };
    },
  },
  __calls: calls,
  __environment: environment,
  env: {
    get sessionId() {
      return process.env.TERMNAV_TEST_VSCODE_SESSION_ID;
    },
  },
};
EOF

  extension_output=$(
    NODE_PATH="${node_modules%/node_modules}/node_modules" node - "$extension_dir/extension.js" <<'NODE'
const fs = require("fs");
const http = require("http");
process.env.TERMNAV_TEST_VSCODE_SESSION_ID = "termnav-extension-test-" + process.pid;
const extension = require(process.argv[2]);
const vscode = require("vscode");
const subscriptions = [];
const environment = new Map();

function makeEnvironmentCollection(values = new Map()) {
  return {
    persistent: true,
    get(name) {
      const value = values.get(name);
      return value === undefined ? undefined : { value };
    },
    replace(name, value) {
      values.set(name, value);
      vscode.__environment.push(name + "=published");
    },
    delete(name) {
      values.delete(name);
    },
  };
}

function pathEntryExists(entryPath) {
  try {
    fs.lstatSync(entryPath);
    return true;
  } catch (error) {
    if (error.code === "ENOENT") return false;
    throw error;
  }
}

function request(socketPath, method, path, body) {
  return new Promise((resolve, reject) => {
    const request = http.request({
      socketPath,
      method,
      path,
      headers: { "content-type": "application/json" },
    }, (response) => {
      const chunks = [];
      response.on("data", (chunk) => chunks.push(chunk));
      response.on("end", () => resolve({
        status: response.statusCode,
        body: Buffer.concat(chunks).toString("utf8"),
      }));
    });
    request.on("error", reject);
    if (body !== undefined) request.write(JSON.stringify(body));
    request.end();
  });
}

async function main() {
  const firstWindowCollection = makeEnvironmentCollection();
  const secondWindowCollection = makeEnvironmentCollection();
  const firstWindowPath = extension.socketLocation(firstWindowCollection).socketPath;
  const secondWindowPath = extension.socketLocation(secondWindowCollection).socketPath;
  firstWindowCollection.replace("TERMNAV_VSCODE_SOCKET", firstWindowPath);
  const retainedFirstWindowPath = extension.socketLocation(firstWindowCollection).socketPath;
  console.log("telemetry-session-independent=" + (
    firstWindowPath === secondWindowPath ? "collide" : "isolated"
  ));
  console.log("stored-path-not-reused=" + (
    firstWindowPath === retainedFirstWindowPath ? "reused" : "fresh"
  ));

  const environmentVariableCollection = makeEnvironmentCollection(environment);
  await extension.activate({ subscriptions, environmentVariableCollection });
  const socketPath = environment.get("TERMNAV_VSCODE_SOCKET");
  const directoryMode = fs.statSync(require("path").dirname(socketPath)).mode & 0o777;
  const socketMode = fs.statSync(socketPath).mode & 0o777;
  const next = await request(socketPath, "POST", "/switch-tab", { direction: "next" });
  const previous = await request(socketPath, "POST", "/switch-tab", { direction: "previous" });
  const invalid = await request(socketPath, "POST", "/switch-tab", { direction: "sideways" });
  const nullBody = await request(socketPath, "POST", "/switch-tab", null);
  const tooLarge = await request(socketPath, "POST", "/switch-tab", "x".repeat(1024));
  const wrongPath = await request(socketPath, "POST", "/other", { direction: "next" });

  const sharedWorkspaceValues = new Map([["TERMNAV_VSCODE_SOCKET", socketPath]]);
  const sharedWorkspaceCollection = makeEnvironmentCollection(sharedWorkspaceValues);
  const sharedWorkspaceSubscriptions = [];
  delete require.cache[require.resolve(process.argv[2])];
  const secondWindowExtension = require(process.argv[2]);
  await secondWindowExtension.activate({
    subscriptions: sharedWorkspaceSubscriptions,
    environmentVariableCollection: sharedWorkspaceCollection,
  });
  const liveSecondWindowPath = sharedWorkspaceValues.get("TERMNAV_VSCODE_SOCKET");
  console.log("same-workspace-windows=" + (
    liveSecondWindowPath === socketPath ? "collide" : "isolated"
  ));
  await Promise.all(sharedWorkspaceSubscriptions.map(
    (subscription) => Promise.resolve(subscription.dispose()),
  ));

  console.log(vscode.__calls.join("\n"));
  console.log(vscode.__environment.join("\n"));
  console.log("statuses=" + [
    next.status,
    previous.status,
    invalid.status,
    nullBody.status,
    tooLarge.status,
    wrongPath.status,
  ].join(","));
  console.log("directory-mode=" + directoryMode.toString(8));
  console.log("socket-mode=" + socketMode.toString(8));
  console.log("subscriptions=" + subscriptions.length);
  console.log("collection-persistent=" + environmentVariableCollection.persistent);

  await Promise.all(subscriptions.map((subscription) => Promise.resolve(subscription.dispose())));
  for (let attempt = 0; attempt < 100 && pathEntryExists(socketPath); attempt += 1) {
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  console.log("cleanup=" + (pathEntryExists(socketPath) ? "present" : "removed"));
  console.log("claim-cleanup=" + (
    pathEntryExists(socketPath + ".claim") ? "present" : "removed"
  ));
  console.log("environment-cleanup=" + (
    environment.has("TERMNAV_VSCODE_SOCKET") ? "present" : "removed"
  ));

  const restartedSubscriptions = [];
  await extension.activate({
    subscriptions: restartedSubscriptions,
    environmentVariableCollection,
  });
  const restartedSocketPath = environment.get("TERMNAV_VSCODE_SOCKET");
  console.log("restart-path=" + (restartedSocketPath === socketPath ? "stable" : "changed"));
  console.log("socket-length=" + restartedSocketPath.length);
  await Promise.all(restartedSubscriptions.map(
    (subscription) => Promise.resolve(subscription.dispose()),
  ));
  try {
    fs.rmdirSync(require("path").dirname(restartedSocketPath));
  } catch (error) {
    if (error.code !== "ENOTEMPTY") throw error;
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
NODE
  )
  _assert_contains "socket adapter: next selects the next integrated terminal" \
    "workbench.action.terminal.focusNext" "$extension_output"
  _assert_contains "socket adapter: telemetry session ids are not window identity" \
    "telemetry-session-independent=isolated" "$extension_output"
  _assert_contains "socket adapter: live windows sharing one workspace stay isolated" \
    "same-workspace-windows=isolated" "$extension_output"
  _assert_contains "socket adapter: stored workspace paths are never reassigned" \
    "stored-path-not-reused=fresh" "$extension_output"
  _assert_contains "socket adapter: previous selects the previous integrated terminal" \
    "workbench.action.terminal.focusPrevious" "$extension_output"
  _assert_contains "socket adapter: rejects unknown paths and directions" \
    "statuses=200,200,400,400,413,404" "$extension_output"
  _assert_contains "socket adapter: private directory is owner-only" \
    "directory-mode=700" "$extension_output"
  _assert_contains "socket adapter: socket is owner-only" \
    "socket-mode=600" "$extension_output"
  _assert_contains "socket adapter: lifecycle is owned by the extension context" \
    "subscriptions=1" "$extension_output"
  _assert_contains "socket adapter: environment collection is activation-scoped" \
    "collection-persistent=false" "$extension_output"
  _assert_contains "socket adapter: publishes its per-window socket" \
    "TERMNAV_VSCODE_SOCKET=published" "$extension_output"
  _assert_contains "socket adapter: removes its socket on disposal" \
    "cleanup=removed" "$extension_output"
  _assert_contains "socket adapter: removes its ownership claim on disposal" \
    "claim-cleanup=removed" "$extension_output"
  _assert_contains "socket adapter: removes its terminal environment on disposal" \
    "environment-cleanup=removed" "$extension_output"
  _assert_contains "socket adapter: extension-host restart cannot reassign an old path" \
    "restart-path=changed" "$extension_output"
  _assert_eq "socket adapter: path stays below the macOS Unix-socket limit" \
    "true" \
    "$(printf '%s\n' "$extension_output" | sed -n 's/^socket-length=//p' | awk '{ print ($1 < 104 ? "true" : "false") }')"
else
  echo "  SKIP: VS Code extension runtime assertions (node unavailable)"
fi

echo
echo "=== nearest tmux/terminal scope ==="

client_pids=()
_client_has_env() {
  local pid="$1" expected="$2"
  if [[ -r "/proc/$pid/environ" ]]; then
    tr '\0' '\n' <"/proc/$pid/environ" | grep -Fqx "$expected"
    return
  fi
  ps eww -p "$pid" -o command= 2>/dev/null |
    tr ' ' '\n' |
    grep -Fqx "$expected"
}
_spawn_client() {
  local expected ready attempts=200

  env -u TMUX -u TMUX_PANE -u TERMNAV_VSCODE_SOCKET \
    -u VSCODE_IPC_HOOK_CLI -u TERM_PROGRAM "$@" sleep 60 &
  REPLY=$!
  client_pids+=("$REPLY")

  while ((attempts--)); do
    ready=1
    for expected in "$@"; do
      if ! _client_has_env "$REPLY" "$expected"; then
        ready=0
        break
      fi
    done
    ((ready)) && return 0
    sleep 0.01
  done
  return 1
}
_cleanup_tab_switch_test() {
  if ((${#client_pids[@]})); then
    kill "${client_pids[@]}" 2>/dev/null || true
    wait "${client_pids[@]}" 2>/dev/null || true
  fi
  _cleanup
}
trap _cleanup_tab_switch_test EXIT

process_env_bin=$(_tmpdir)
process_env_ps_log=$(_tmpdir)/process-env-ps.log
cat >"$process_env_bin/ps" <<'EOF'
#!/usr/bin/env bash
printf '<%s>\n' "$*" >>"$TERMNAV_PROCESS_ENV_PS_LOG"
printf 'sleep TERM_PROGRAM=WezTerm\n'
EOF
chmod +x "$process_env_bin/ps"

_spawn_client TERMNAV_PROCESS_ENV_READY=1
client_without_term_program=$REPLY
if [[ -r "/proc/$client_without_term_program/environ" ]]; then
  : >"$process_env_ps_log"
  TERMNAV_PROCESS_ENV_PS_LOG="$process_env_ps_log" PATH="$process_env_bin:$PATH" \
    "$router" next --client-pid "$client_without_term_program" --client-tty /dev/null \
    --client-termtype xterm-256color
  _assert_eq "tab router: readable proc miss does not invoke the macOS ps fallback" \
    "" "$(cat "$process_env_ps_log")"
else
  echo "  SKIP: readable /proc environment assertion (/proc unavailable)"
fi

: >"$process_env_ps_log"
TERMNAV_PROCESS_ENV_PS_LOG="$process_env_ps_log" PATH="$process_env_bin:$PATH" \
  "$router" next --client-pid 999999999 --client-tty /dev/null \
  --client-termtype xterm-256color
_assert_contains "tab router: missing proc environment retains the ps fallback" \
  "eww -p 999999999 -o command=" "$(cat "$process_env_ps_log")"

router_bin=$(_tmpdir)
router_log=$(_tmpdir)/router-code.log
cat >"$router_bin/curl" <<'EOF'
#!/usr/bin/env bash
original=("$@")
socket=""
while (($#)); do
  if [[ "$1" == "--unix-socket" && $# -gt 1 ]]; then
    socket="$2"
    shift 2
  else
    shift
  fi
done
{
  printf 'socket=<%s> argv:' "$socket"
  printf ' <%s>' "${original[@]}"
  printf '\n'
} >>"$TERMNAV_ROUTER_CODE_LOG"
printf '{}\n'
EOF
chmod +x "$router_bin/curl"

_spawn_client TERMNAV_VSCODE_SOCKET=/tmp/termnav-window-a.sock TERM_PROGRAM=vscode
client_a=$REPLY
_spawn_client TERMNAV_VSCODE_SOCKET=/tmp/termnav-window-b.sock TERM_PROGRAM=vscode
client_b=$REPLY

: >"$router_log"
TERMNAV_ROUTER_CODE_LOG="$router_log" PATH="$router_bin:$PATH" \
  "$router" next --client-pid "$client_a" --client-tty /dev/pts/100 \
  --client-termtype 'xterm.js(5.3.0)'
TERMNAV_ROUTER_CODE_LOG="$router_log" PATH="$router_bin:$PATH" \
  "$router" previous --client-pid "$client_b" --client-tty /dev/pts/101 \
  --client-termtype 'xterm.js(5.3.0)'
_assert_eq "tab router: simultaneous VS Code windows retain separate IPC identities" \
  "$(printf 'socket=</tmp/termnav-window-a.sock>\nsocket=</tmp/termnav-window-b.sock>')" \
  "$(sed -n 's/ .*//p' "$router_log")"
_assert_contains "tab router: forwards next to the first VS Code window" \
  '"direction":"next"' "$(sed -n '1p' "$router_log")"
_assert_contains "tab router: forwards previous to the second VS Code window" \
  '"direction":"previous"' "$(sed -n '2p' "$router_log")"

_spawn_client VSCODE_IPC_HOOK_CLI=/tmp/not-a-window-identity TERM_PROGRAM=vscode
client_without_socket=$REPLY
: >"$router_log"
set +e
TERMNAV_VSCODE_SOCKET=/tmp/stale-session-global.sock \
  TERMNAV_ROUTER_CODE_LOG="$router_log" PATH="$router_bin:$PATH" \
  "$router" next --client-pid "$client_without_socket" --client-tty /dev/pts/102 \
  --client-termtype 'xterm.js(5.3.0)'
missing_client_socket_rc=$?
set -e
_assert_exit "tab router: missing client socket fails closed instead of using inherited state" \
  1 "$missing_client_socket_rc"
_assert_eq "tab router: inherited socket and CLI hook are never treated as window identity" \
  "" "$(cat "$router_log")"

parent_socket=$(_tmpdir)/parent.sock
tmux_log=$(_tmpdir)/tmux.log
tmux_clients=$(_tmpdir)/tmux-clients
tmux_panes=$(_tmpdir)/tmux-panes
parent_session="\$parent"
linked_one_session="\$linked-one"
linked_two_session="\$linked-two"
cat >"$router_bin/tmux" <<'EOF'
#!/usr/bin/env bash
args="$*"
socket=""
while (($#)); do
  if [[ "$1" == "-S" && $# -gt 1 ]]; then
    socket="$2"
    shift 2
  else
    shift
  fi
done
printf '<%s>\n' "$args" >>"$TERMNAV_TMUX_LOG"
case "$args" in
  *list-panes*)
    cat "$TERMNAV_TMUX_PANES"
    ;;
  *list-clients*)
    if [[ -n "${TERMNAV_TMUX_OUTER_SOCKET:-}" &&
      "$socket" == "$TERMNAV_TMUX_OUTER_SOCKET" ]]; then
      cat "$TERMNAV_TMUX_OUTER_CLIENTS"
    else
      cat "$TERMNAV_TMUX_CLIENTS"
    fi
    ;;
  *next-window* | *previous-window*)
    ;;
  *)
    exit 1
    ;;
esac
EOF
chmod +x "$router_bin/tmux"

_spawn_client TMUX="$parent_socket,1234,0" TMUX_PANE=%7
nested_client=$REPLY
printf '%%7\t%s\n' "$parent_session" >"$tmux_panes"
printf '200\t%s\t/dev/pts/120\txterm.js(5.3.0)\t%s\t3\t%%7\tattached,focused,UTF-8\n' \
  "$client_b" "$parent_session" >"$tmux_clients"
: >"$tmux_log"
: >"$router_log"
TERMNAV_TMUX_CLIENTS="$tmux_clients" TERMNAV_TMUX_PANES="$tmux_panes" \
  TERMNAV_TMUX_LOG="$tmux_log" TERMNAV_ROUTER_CODE_LOG="$router_log" \
  PATH="$router_bin:$PATH" \
  "$router" next --client-pid "$nested_client" --client-tty /dev/pts/110 \
  --client-termtype tmux-256color
_assert_contains "tab router: switches the nearest parent tmux with multiple windows" \
  "next-window -t \$parent" "$(cat "$tmux_log")"
_assert_eq "tab router: parent tmux ownership stops outer-terminal routing" \
  "" "$(cat "$router_log")"

lineage_pid_file=$(_tmpdir)/child.pid
# shellcheck disable=SC2016  # Variables intentionally expand in the child shell.
env -u TMUX -u TMUX_PANE TMUX="$parent_socket,1234,0" TMUX_PANE=%8 \
  bash -c 'env -u TMUX -u TMUX_PANE sleep 60 & child=$!; printf "%s\n" "$child" >"$1"; wait "$child"' \
  bash "$lineage_pid_file" &
lineage_parent=$!
client_pids+=("$lineage_parent")
_attempt=0
while ((_attempt < 200)); do
  [[ -s "$lineage_pid_file" ]] && break
  _attempt=$((_attempt + 1))
  sleep 0.01
done
lineage_client=$(cat "$lineage_pid_file")
client_pids+=("$lineage_client")
lineage_tty=$(_tmpdir)/lineage.tty
: >"$lineage_tty"
: >"$tmux_log"
printf '%%8\t%s\n' "$parent_session" >"$tmux_panes"
printf '200\t%s\t/dev/pts/120\txterm.js(5.3.0)\t%s\t2\t%%8\tattached,focused,UTF-8\n' \
  "$client_b" "$parent_session" >"$tmux_clients"
TERMNAV_TMUX_CLIENTS="$tmux_clients" TERMNAV_TMUX_PANES="$tmux_panes" \
  TERMNAV_TMUX_LOG="$tmux_log" PATH="$router_bin:$PATH" \
  "$router" next --client-pid "$lineage_client" --client-tty "$lineage_tty" \
  --client-termtype tmux-256color
_assert_contains "tab router: scrubbed nested clients recover the parent from their shell" \
  "next-window -t \$parent" "$(cat "$tmux_log")"

printf '%%7\t%s\n' "$parent_session" >"$tmux_panes"
printf '200\t%s\t/dev/pts/120\txterm.js(5.3.0)\t%s\t1\t%%7\tattached,focused,UTF-8\n' \
  "$client_b" "$parent_session" >"$tmux_clients"
: >"$tmux_log"
: >"$router_log"
TERMNAV_TMUX_CLIENTS="$tmux_clients" TERMNAV_TMUX_PANES="$tmux_panes" \
  TERMNAV_TMUX_LOG="$tmux_log" TERMNAV_ROUTER_CODE_LOG="$router_log" \
  PATH="$router_bin:$PATH" \
  "$router" previous --client-pid "$nested_client" --client-tty /dev/pts/110 \
  --client-termtype tmux-256color
_assert_contains "tab router: one-window parent resolves its attached VS Code client" \
  "socket=</tmp/termnav-window-b.sock>" "$(cat "$router_log")"
_assert_contains "tab router: nested VS Code request keeps its direction" \
  '"direction":"previous"' "$(cat "$router_log")"

outer_socket=$(_tmpdir)/outer.sock
outer_clients=$(_tmpdir)/outer-clients
outer_session="\$outer"
_spawn_client TMUX="$outer_socket,2345,0" TMUX_PANE=%9
middle_client=$REPLY
