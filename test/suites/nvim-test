#!/usr/bin/env bash
# nvim-test — repo-owned Neovim behavior for termnav modules.

set -o pipefail
export NO_COLOR=1

TERMNAV_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TERMNAV_ROOT="$(cd -- "$TERMNAV_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$TERMNAV_TEST_DIR/helpers.sh"
# shellcheck source=../../lib/termnav/nvim-open/common.sh
. "$TERMNAV_ROOT/lib/termnav/nvim-open/common.sh"

_nvim_lua() {
  nvim --headless --noplugin -u NONE -i NONE \
    -c "lua $1" \
    -c "qa!" 2>&1 |
    tr -d '\r'
}

if ! command -v nvim >/dev/null 2>&1; then
  echo "  SKIP: termnav nvim module assertions (nvim unavailable)"
  _test_summary
fi

opener_module="$TERMNAV_ROOT/lib/termnav/nvim/nvim-tmux-open.lua"
vars_module="$TERMNAV_ROOT/lib/termnav/nvim/wezterm-vars.lua"
setup_module="$TERMNAV_ROOT/lib/termnav/nvim/setup.lua"

echo "=== nvim-tmux-open ==="

_assert_not_contains "setup: publish events avoid per-cursor-move disk writes" \
  "CursorMoved" "$(cat "$opener_module")"

result=$(_nvim_lua "
  vim.env.TMUX = '/tmp/tmux.sock,1,0'
  vim.env.TMUX_PANE = '%42'
  local vars = dofile('$vars_module')
  local old_system = vim.fn.system
  local old_open = io.open
  local calls = 0
  local opened = {}
  vim.fn.system = function(cmd)
    calls = calls + 1
    if calls == 1 then
      return '\n'
    end
    if cmd[#cmd] == '#{client_termname}' then
      return 'xterm-256color\n'
    end
    print(table.concat(cmd, ' '))
    return '/dev/pts/42\n'
  end
  io.open = function(path, mode)
    opened[#opened + 1] = path .. ' ' .. mode
    return {
      write = function(_, text)
        local esc = string.char(27)
        local bel = string.char(7)
        local bs = string.char(92)
        local raw = esc .. ']1337;SetUserVar=IS_NVIM=dHJ1ZQ==' .. bel
        local expected = esc .. 'Ptmux;' .. raw:gsub(esc, esc .. esc) .. esc .. bs
        opened[#opened + 1] = text == expected and 'user-var' or text
      end,
      flush = function() end,
      close = function() end,
    }
  end
  print(tostring(vars.set('IS_NVIM', 'true')))
  print(tostring(calls))
  print(tostring(#opened))
  print(tostring(vars.set('IS_NVIM', 'true')))
  print(tostring(calls))
  print(opened[1])
  print(opened[2])
  vim.fn.system = old_system
  io.open = old_open
")
expected="$(printf 'false\n1\n0\ntmux display-message -t %%42 -p #{pane_tty}\ntrue\n3\n/dev/pts/42 w\nuser-var')"
_assert_eq "wezterm-vars: empty tmux tty is not cached and next publish can recover" \
  "$expected" "$result"

result=$(_nvim_lua "
  vim.env.TMUX = nil
  vim.env.TMUX_PANE = nil
  local old_base64 = vim.base64
  vim.base64 = nil
  local vars = dofile('$vars_module')
  vars.tty_path = function()
    return '/dev/pts/42'
  end
  local old_open = io.open
  local writes = {}
  io.open = function()
    return {
      write = function(_, text)
        writes[#writes + 1] = text
      end,
      flush = function() end,
      close = function() end,
    }
  end
  print(tostring(vars.set('IS_NVIM', 'true')))
  print(writes[1]:match('SetUserVar=IS_NVIM=dHJ1ZQ==') and 'encoded' or writes[1])
  vim.base64 = old_base64
  io.open = old_open
")
expected="$(printf 'true\nencoded')"
_assert_eq "wezterm-vars: base64 fallback supports older nvim" "$expected" "$result"

result=$(_nvim_lua "
  vim.env.TMUX = '/tmp/tmux.sock,1,0'
  vim.env.TMUX_PANE = '%42'
  local vars = dofile('$vars_module')
  vars.tty_path = function()
    return '/dev/pts/42'
  end
  local old_system = vim.fn.system
  local old_open = io.open
  vim.fn.system = function(cmd)
    if cmd[#cmd] == '#{client_termname}' then
      return 'tmux-256color\n'
    end
    return ''
  end
  local writes = {}
  io.open = function()
    return {
      write = function(_, text)
        writes[#writes + 1] = text
      end,
      flush = function() end,
      close = function() end,
    }
  end
  print(tostring(vars.set('DOT_PARENT_SWITCH_TAB', 'next:1')))
  local esc = string.char(27)
  local bel = string.char(7)
  local bs = string.char(92)
  local raw = esc .. ']1337;SetUserVar=DOT_PARENT_SWITCH_TAB=bmV4dDox' .. bel
  local single = esc .. 'Ptmux;' .. raw:gsub(esc, esc .. esc) .. esc .. bs
  local expected = esc .. 'Ptmux;' .. single:gsub(esc, esc .. esc) .. esc .. bs
  local _, passthrough_count = writes[1]:gsub(esc .. 'Ptmux;', '')
  print(tostring(passthrough_count))
  print(writes[1] == expected and 'exact' or writes[1])
  vim.fn.system = old_system
  io.open = old_open
")
expected="$(printf 'true\n2\nexact')"
_assert_eq "wezterm-vars: nested tmux clients double-wrap OSC passthrough" \
  "$expected" "$result"

result=$(_nvim_lua "
  vim.env.TMUX = '/tmp/tmux.sock,1,0'
  vim.env.TMUX_PANE = '%42'
  local vars = dofile('$vars_module')
  vars.tty_path = function()
    return '/dev/pts/42'
  end
  local old_system = vim.fn.system
  local old_open = io.open
  local calls = 0
  local writes = {}
  vim.fn.system = function()
    calls = calls + 1
    return calls == 1 and 'xterm-256color\n' or 'tmux-256color\n'
  end
  io.open = function()
    return {
      write = function(_, text)
        local esc = string.char(27)
        local _, count = text:gsub(esc .. 'Ptmux;', '')
        writes[#writes + 1] = count
      end,
      flush = function() end,
      close = function() end,
    }
  end
  vars.set('FIRST', 'true', {})
  vars.set('SECOND', 'true', {})
  print(table.concat({ calls, writes[1], writes[2] }, ' '))
  vim.fn.system = old_system
  io.open = old_open
")
_assert_eq "wezterm-vars: a new publish observes a changed tmux client" "2 1 2" "$result"

result=$(_nvim_lua "
  vim.env.TMUX = '/tmp/tmux.sock,1,0'
  vim.env.TMUX_PANE = '%42'
  vim.env.TERMNAV_REMOTE_LINK_HOST = 'remote.example'
  local vars = dofile('$vars_module')
  local setup = dofile('$setup_module')
  local old_system = vim.fn.system
  local old_open = io.open
  local tty_calls = 0
  local termname_calls = 0
  local client_ready = false
  local writes = 0
  vim.fn.system = function(cmd)
    if cmd[#cmd] == '#{pane_tty}' then
      tty_calls = tty_calls + 1
      return '/dev/pts/42\n'
    end
    if cmd[#cmd] == '#{client_termname}' then
      termname_calls = termname_calls + 1
      return client_ready and 'xterm-256color\n' or ''
    end
    return ''
  end
  io.open = function()
    return {
      write = function()
        writes = writes + 1
      end,
      flush = function() end,
      close = function() end,
    }
  end
  local ctx = setup.new({
    opener = {
      server = function()
        return '/tmp/nvim.sock'
      end,
    },
    wezterm_vars = vars,
  })
  ctx.publish()
  print(table.concat({ tty_calls, termname_calls, writes }, ' '))
  client_ready = true
  ctx.publish()
  print(table.concat({ tty_calls, termname_calls, writes }, ' '))
  client_ready = false
  ctx.clear()
  print(table.concat({ tty_calls, termname_calls, writes }, ' '))
  client_ready = true
  ctx.publish()
  print(table.concat({ tty_calls, termname_calls, writes }, ' '))
  vim.fn.system = old_system
  io.open = old_open
")
_assert_eq "nvim setup: failed client classification retries the same publish values" \
  "$(printf '1 1 0\n1 2 6\n1 3 6\n1 4 12')" "$result"

result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  local old_jobpid = vim.fn.jobpid
  local old_executable = vim.fn.executable
  local old_systemlist = vim.fn.systemlist
  vim.b.terminal_job_id = 77
  vim.fn.jobpid = function()
    return 99999999
  end
  vim.fn.executable = function(name)
    if name == 'lsof' then
      return 0
    end
    return old_executable(name)
  end
  vim.fn.systemlist = function()
    print('systemlist-called')
    return {}
  end
  print(tostring(opener.terminal_cwd(0) == nil))
  vim.fn.jobpid = old_jobpid
  vim.fn.executable = old_executable
  vim.fn.systemlist = old_systemlist
")
_assert_eq "terminal_cwd: missing lsof fails closed" "true" "$result"

NVIM_TMUX_OPEN_TMP=$(_tmpdir)
mkdir -p "$NVIM_TMUX_OPEN_TMP/terminal-cwd"
touch "$NVIM_TMUX_OPEN_TMP/terminal-cwd/clicked.txt"
NVIM_TMUX_OPEN_TERMINAL_CWD=$(realpath "$NVIM_TMUX_OPEN_TMP/terminal-cwd")
NVIM_TMUX_OPEN_EXPECTED=$(realpath "$NVIM_TMUX_OPEN_TMP/terminal-cwd/clicked.txt")
result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  vim.cmd('edit $NVIM_TMUX_OPEN_TMP/editor.txt')
  vim.cmd('terminal')
  local job = vim.b.terminal_job_id
  vim.fn.chansend(job, 'cd $NVIM_TMUX_OPEN_TMP/terminal-cwd\n')
  local ready = vim.wait(5000, function()
    return opener.terminal_cwd(0) == '$NVIM_TMUX_OPEN_TERMINAL_CWD'
  end)
  if not ready then
    print('terminal cwd not ready: ' .. tostring(opener.terminal_cwd(0)))
    return
  end
  local win = vim.api.nvim_get_current_win()
  opener.open_now('clicked.txt', 1, 0, '$HOME', 'nvim')
  print(vim.api.nvim_buf_get_name(0))
  print(tostring(vim.api.nvim_get_current_win() == win))
  print(#vim.api.nvim_list_tabpages())
")
expected="$(printf '%s\ntrue\n1' "$NVIM_TMUX_OPEN_EXPECTED")"
_assert_eq "open_now: nvim terminal clicks reuse the current window" "$expected" "$result"

mkdir -p "$NVIM_TMUX_OPEN_TMP/editor-cwd" "$NVIM_TMUX_OPEN_TMP/other-terminal-cwd"
touch "$NVIM_TMUX_OPEN_TMP/editor-cwd/shared.txt" "$NVIM_TMUX_OPEN_TMP/other-terminal-cwd/shared.txt"
NVIM_TMUX_OPEN_OTHER_TERMINAL_CWD=$(realpath "$NVIM_TMUX_OPEN_TMP/other-terminal-cwd")
NVIM_TMUX_OPEN_EXPECTED=$(realpath "$NVIM_TMUX_OPEN_TMP/editor-cwd/shared.txt")
result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  vim.cmd('cd $NVIM_TMUX_OPEN_TMP/editor-cwd')
  local clicked_cwd = vim.fn.getcwd()
  vim.cmd('edit $NVIM_TMUX_OPEN_TMP/editor-cwd/editor.txt')
  vim.cmd('terminal')
  -- terminal_cwd() is covered above. Stub it here so this path-resolution
  -- test does not depend on shell startup and cd timing on slower hosts.
  opener.terminal_cwd = function()
    return '$NVIM_TMUX_OPEN_OTHER_TERMINAL_CWD'
  end
  opener.open_now('shared.txt', 1, 0, clicked_cwd, 'terminal')
  print(vim.api.nvim_buf_get_name(0))
")
_assert_eq "open_now: explicit clicked cwd wins when relative file exists there" \
  "$NVIM_TMUX_OPEN_EXPECTED" "$result"

touch "$NVIM_TMUX_OPEN_TMP/external-click.txt"
NVIM_TMUX_OPEN_EXPECTED=$(realpath "$NVIM_TMUX_OPEN_TMP/external-click.txt")
result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  vim.cmd('terminal')
  local win = vim.api.nvim_get_current_win()
  opener.open_now('$NVIM_TMUX_OPEN_TMP/external-click.txt', 1, 0, '', 'terminal')
  print(table.concat({
    vim.api.nvim_buf_get_name(0),
    tostring(vim.api.nvim_get_current_win() == win),
    tostring(#vim.api.nvim_list_tabpages()),
  }, string.char(10)))
")
expected="$(printf '%s\ntrue\n1' "$NVIM_TMUX_OPEN_EXPECTED")"
_assert_eq "open_now: external terminal clicks reuse current window when needed" "$expected" "$result"

NVIM_TMUX_OPEN_HOME="$NVIM_TMUX_OPEN_TMP/home"
mkdir -p "$NVIM_TMUX_OPEN_HOME/.local/share/example/core"
touch "$NVIM_TMUX_OPEN_HOME/.local/share/example/core/shell-loader.sh"
NVIM_TMUX_OPEN_EXPECTED=$(realpath "$NVIM_TMUX_OPEN_HOME/.local/share/example/core/shell-loader.sh")
result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  local old_home = vim.env.HOME
  vim.env.HOME = '$NVIM_TMUX_OPEN_HOME'
  opener.open_now('\$HOME/.local/share/example/core/shell-loader.sh', 8, 1, '$NVIM_TMUX_OPEN_HOME/.config/shell', 'nvim')
  print(vim.api.nvim_buf_get_name(0))
  vim.env.HOME = old_home
")
_assert_eq "open_now: expands literal HOME file references" "$NVIM_TMUX_OPEN_EXPECTED" "$result"

result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  local old_home = vim.env.HOME
  vim.env.HOME = '$NVIM_TMUX_OPEN_HOME'
  opener.open_now('\${HOME}/.local/share/example/core/shell-loader.sh', 8, 1, '$NVIM_TMUX_OPEN_HOME/.config/shell', 'nvim')
  print(vim.api.nvim_buf_get_name(0))
  vim.env.HOME = old_home
")
_assert_eq "open_now: expands braced HOME file references" "$NVIM_TMUX_OPEN_EXPECTED" "$result"

result=$(_nvim_lua "
  local opener = dofile('$opener_module')
  local old_home = vim.env.HOME
  vim.env.HOME = '$NVIM_TMUX_OPEN_HOME'
  opener.open_now('\$HOME/.local/share/example/core/shell-loader.sh', 8, 1, '$NVIM_TMUX_OPEN_HOME/.config/shell', 'cli')
  print(vim.api.nvim_buf_get_name(0))
  vim.env.HOME = old_home
")
_assert_eq "open_now: cli mode preserves literal HOME file references" \
  "$NVIM_TMUX_OPEN_HOME/.config/shell/\$HOME/.local/share/example/core/shell-loader.sh" "$result"

NVIM_TMUX_OPEN_HOME=$(_tmpdir)
NVIM_TMUX_OPEN_STATE=$(_tmpdir)
result=$(_nvim_lua "
  vim.env.TMUX = nil
  vim.env.TMUX_PANE = nil
  local old_home = vim.env.HOME
  local old_state_home = vim.env.XDG_STATE_HOME
  vim.env.HOME = '$NVIM_TMUX_OPEN_HOME'
  vim.env.XDG_STATE_HOME = '$NVIM_TMUX_OPEN_STATE'
  local opener = dofile('$opener_module')
  opener.setup()
  local current_record = vim.fn.glob('$NVIM_TMUX_OPEN_STATE/nvim-tmux-open/registry/current/owners/*', false, true)[1]
  local current = vim.fn.readfile(current_record)[4]
  print(tostring(current == vim.v.servername))
  print(vim.fn.isdirectory('$NVIM_TMUX_OPEN_STATE/nvim-tmux-open/registry/panes'))
  print(vim.fn.isdirectory('$NVIM_TMUX_OPEN_HOME/.local/state/nvim-tmux-open/registry'))
  vim.env.HOME = old_home
  vim.env.XDG_STATE_HOME = old_state_home
")
expected="$(printf 'true\n1\n0')"
_assert_eq "setup: publishes current nvim under XDG_STATE_HOME" "$expected" "$result"

NVIM_TMUX_OPEN_REGISTRY=$(_tmpdir)
registry_socket='/tmp/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
registry_key=$(TMUX="$registry_socket,101,0" nvim_open_pane_key '%1')
result=$(
  umask 000
  _nvim_lua "
  vim.env.HOME = nil
  vim.env.XDG_STATE_HOME = '$NVIM_TMUX_OPEN_REGISTRY'
  vim.env.TMUX = '$registry_socket,101,0'
  vim.env.TMUX_PANE = '%1'
  local opener = dofile('$opener_module')
  opener.setup()
  local root = '$NVIM_TMUX_OPEN_REGISTRY/nvim-tmux-open'
  local pane_records = vim.fn.glob(root .. '/registry/panes/**/owners/*', false, true)
  local current_records = vim.fn.glob(root .. '/registry/current/owners/*', false, true)
  local pane_dir = vim.fn.fnamemodify(vim.fn.fnamemodify(pane_records[1] or '', ':h'), ':h')
  print(#pane_records)
  print(#current_records)
  print(pane_dir:sub(#(root .. '/registry/panes/') + 1))
  print(vim.fn.getfperm(root))
  print(vim.fn.getfperm(root .. '/registry'))
  print(vim.fn.getfperm(root .. '/registry/panes'))
  print(vim.fn.getfperm(root .. '/registry/current'))
  print(vim.fn.getfperm(pane_dir))
  print(vim.fn.getfperm(pane_dir .. '/owners'))
  print(vim.fn.getfperm(root .. '/registry/current/owners'))
  print(vim.fn.getfperm(pane_records[1] or ''))
  print(vim.fn.getfperm(current_records[1] or ''))
  print(vim.fn.getfperm(pane_dir .. '/latest'))
  print(vim.fn.getfperm(root .. '/registry/current/latest'))
  print(tostring(vim.fn.readfile(pane_records[1] or '')[4] == opener.server()))
  print(tostring(vim.fn.readfile(current_records[1] or '')[4] == opener.server()))
  print(tostring(vim.fn.readfile(pane_dir .. '/latest')[3] == vim.fn.fnamemodify(pane_records[1] or '', ':t')))
  print(tostring(vim.fn.readfile(root .. '/registry/current/latest')[3] == vim.fn.fnamemodify(current_records[1] or '', ':t')))
  print(#vim.fn.glob(root .. '/registry/**/*.tmp.*', false, true))
"
)
expected="$(printf '1\n1\n%s\nrwx------\nrwx------\nrwx------\nrwx------\nrwx------\nrwx------\nrwx------\nrw-------\nrw-------\nrw-------\nrw-------\ntrue\ntrue\ntrue\ntrue\n0' "$registry_key")"
_assert_eq "setup: publishes private atomic owner-scoped registry records" \
  "$expected" "$result"

NVIM_TMUX_OPEN_COMMA=$(_tmpdir)
for server_pid in 101 202; do
  _nvim_lua "
    vim.env.HOME = nil
    vim.env.XDG_STATE_HOME = '$NVIM_TMUX_OPEN_COMMA'
    vim.env.TMUX = '/tmp/tmux,comma.sock,$server_pid,0'
    vim.env.TMUX_PANE = '%1'
    local opener = dofile('$opener_module')
    opener.setup()
  " >/dev/null
done
comma_server_one_key=$(TMUX='/tmp/tmux,comma.sock,101,0' nvim_open_pane_key '%1')
comma_server_two_key=$(TMUX='/tmp/tmux,comma.sock,202,0' nvim_open_pane_key '%1')
result="$(
  printf '%s\n' "$([[ -d "$NVIM_TMUX_OPEN_COMMA/nvim-tmux-open/registry/panes/$comma_server_one_key" ]] && echo true || echo false)"
  printf '%s\n' "$([[ -d "$NVIM_TMUX_OPEN_COMMA/nvim-tmux-open/registry/panes/$comma_server_two_key" ]] && echo true || echo false)"
  pane_dir_count=0
  for pane_dir in "$NVIM_TMUX_OPEN_COMMA/nvim-tmux-open/registry/panes"/*; do
    [[ -d "$pane_dir" ]] && pane_dir_count=$((pane_dir_count + 1))
  done
  printf '%s\n' "$pane_dir_count"
)"
expected="$(printf 'true\ntrue\n2')"
_assert_eq "setup: shell and Lua preserve comma socket server identity" \
  "$expected" "$result"

rename_failure_ok=true
for fail_at in 1 2 3 4 5; do
  NVIM_TMUX_OPEN_FAILURE=$(_tmpdir)
  result=$(_nvim_lua "
    vim.env.HOME = nil
    vim.env.XDG_STATE_HOME = '$NVIM_TMUX_OPEN_FAILURE'
    vim.env.TMUX = '/tmp/failure.sock,303,0'
    vim.env.TMUX_PANE = '%3'
    local uv = vim.uv or vim.loop
    local real_rename = uv.fs_rename
    local rename_count = 0
    uv.fs_rename = function(...)
      rename_count = rename_count + 1
      if rename_count == $fail_at then
        return nil, 'injected rename failure'
      end
      return real_rename(...)
    end
    local opener = dofile('$opener_module')
    local ok = pcall(opener.setup)
    uv.fs_rename = real_rename
    local root = '$NVIM_TMUX_OPEN_FAILURE/nvim-tmux-open/registry'
    local committed = vim.fn.glob(root .. '/owners/*', false, true)
    local retried = pcall(opener.setup)
    local address = opener.server()
    print(tostring(ok))
    print(#committed)
    print(#vim.fn.glob(root .. '/**/*.tmp.*', false, true))
    print(tostring(retried))
    print(vim.fn.getftype(address))
  ")
  expected="$(printf 'false\n0\n0\ntrue\nsocket')"
  if [[ "$result" != "$expected" ]]; then
    rename_failure_ok=false
    printf '  rename failure %s: expected %q, got %q\n' \
      "$fail_at" "$expected" "$result" >&2
  fi
done
_assert_eq "setup: every publication rename rolls back and can retry in-process" \
  "true" "$rename_failure_ok"

owned_failure_ok=true
for fail_at in 1 2 3 4 5; do
  result=$(_nvim_lua "
  local real_vim = vim
  local rename_count = 0
  local start_count = 0
  local stop_count = 0
  local fail_at = $fail_at
  local next_fd = 10
  _G.vim = {
    env = {
      HOME = nil,
      TMPDIR = '/tmp',
      XDG_STATE_HOME = '/state',
      XDG_RUNTIME_DIR = '/runtime',
      TMUX = '/tmp/tmux.sock,1,0',
      TMUX_PANE = '%1',
    },
    api = {
      nvim_create_augroup = function() return 1 end,
      nvim_create_autocmd = function() return 1 end,
      nvim_del_augroup_by_id = function() end,
    },
    fn = {
      delete = function() return 0 end,
      getpid = function() return 4321 end,
      getuid = function() return 501 end,
      isdirectory = function() return 1 end,
      mkdir = function() return 1 end,
      serverstart = function(path) start_count = start_count + 1; return path end,
      serverstop = function() stop_count = stop_count + 1; return 0 end,
      setfperm = function() return 1 end,
    },
    uv = {
      fs_close = function() return true end,
      fs_fsync = function() return true end,
      fs_lstat = function() return { type = 'directory', uid = 501 } end,
      fs_open = function() next_fd = next_fd + 1; return next_fd end,
      fs_rename = function()
        rename_count = rename_count + 1
        if rename_count == fail_at then return nil, 'injected rename failure' end
        return true
      end,
      fs_unlink = function() return true end,
      fs_write = function(_, content) return #content end,
      hrtime = function() return 1234 end,
    },
    v = { servername = '' },
  }
  local opener = dofile('$opener_module')
  local first_ok = pcall(opener.setup)
  fail_at = -1
  local retry_ok = pcall(opener.setup)
  _G.vim = real_vim
  print(tostring(first_ok))
  print(tostring(retry_ok))
  print(start_count)
  print(stop_count)
  ")
  expected="$(printf 'false\ntrue\n2\n1')"
