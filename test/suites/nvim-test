registry_ready_two="$NVIM_TMUX_OPEN_CONCURRENT/ready-two"
registry_stop_one="$NVIM_TMUX_OPEN_CONCURRENT/stop-one"
registry_stop_two="$NVIM_TMUX_OPEN_CONCURRENT/stop-two"

_registry_record_count() {
  local count=0 record
  for record in "$NVIM_TMUX_OPEN_CONCURRENT/nvim-tmux-open/registry/current/owners"/*; do
    [[ -f "$record" ]] && count=$((count + 1))
  done
  printf '%s\n' "$count"
}

_wait_for_registry_condition() {
  local kind="$1" expected="$2" attempt=0
  while ((attempt < 200)); do
    if [[ "$kind" == file && -f "$expected" ]]; then
      return 0
    fi
    if [[ "$kind" == count && "$(_registry_record_count)" == "$expected" ]]; then
      return 0
    fi
    sleep 0.05
    attempt=$((attempt + 1))
  done
  return 1
}

_start_registry_owner() {
  local ready="$1" stop="$2" log="$3"
  nvim --headless --noplugin -u NONE -i NONE \
    -c "lua vim.env.HOME = nil; vim.env.XDG_STATE_HOME = '$NVIM_TMUX_OPEN_CONCURRENT'; vim.env.TMUX = '/tmp/concurrent.sock,404,0'; vim.env.TMUX_PANE = '%4'; local opener = dofile('$opener_module'); opener.setup(); vim.fn.writefile({'ready'}, '$ready'); vim.wait(15000, function() return vim.fn.filereadable('$stop') == 1 end)" \
    -c 'qa!' >"$log" 2>&1 &
  REPLY=$!
}

_start_registry_owner "$registry_ready_one" "$registry_stop_one" \
  "$NVIM_TMUX_OPEN_CONCURRENT/owner-one.log"
registry_pid_one=$REPLY
_wait_for_registry_condition file "$registry_ready_one"
registry_ready_one_rc=$?
_start_registry_owner "$registry_ready_two" "$registry_stop_two" \
  "$NVIM_TMUX_OPEN_CONCURRENT/owner-two.log"
registry_pid_two=$REPLY
_wait_for_registry_condition file "$registry_ready_two"
registry_ready_two_rc=$?
_wait_for_registry_condition count 2
registry_two_count_rc=$?

if [[ "$registry_ready_one_rc" -eq 0 && "$registry_ready_two_rc" -eq 0 &&
  "$registry_two_count_rc" -eq 0 ]]; then
  _pass "setup: concurrent owners publish separate pane records"
else
  _fail "setup: concurrent owners publish separate pane records"
fi

: >"$registry_stop_one"
wait "$registry_pid_one"
registry_owner_one_rc=$?
_wait_for_registry_condition count 1
registry_one_count_rc=$?
if [[ "$registry_owner_one_rc" -eq 0 && "$registry_one_count_rc" -eq 0 ]] &&
  kill -0 "$registry_pid_two" 2>/dev/null; then
  _pass "cleanup: one owner cannot remove a concurrent owner's pane record"
else
  _fail "cleanup: one owner cannot remove a concurrent owner's pane record"
fi

: >"$registry_stop_two"
wait "$registry_pid_two"
registry_owner_two_rc=$?
_wait_for_registry_condition count 0
registry_zero_count_rc=$?
if [[ "$registry_owner_two_rc" -eq 0 && "$registry_zero_count_rc" -eq 0 ]]; then
  _pass "cleanup: each owner removes its own pane record"
else
  _fail "cleanup: each owner removes its own pane record"
fi

