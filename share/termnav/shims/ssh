#!/usr/bin/env sh
# termnav-ssh-shim-v1
# Keep SSH interposition inherited by child processes without installing a
# global command named ssh. Tell the native supervisor the exact shim directory
# that invoked it: checkout, staging, and installed copies can all coexist
# during an update, and the release binary cannot infer those runtime paths.
case "$0" in
  */*) shim_parent=${0%/*} ;;
  *) shim_parent=. ;;
esac
shim_dir=$(CDPATH='' cd -P -- "$shim_parent" 2>/dev/null && pwd)

# Fail closed if a resolver ever selects another copy of this shim. The native
# supervisor waits for its SSH child, so recursive process creation exhausts a
# host instead of behaving like a harmless executable loop.
if [ -n "${TERMNAV_SSH_SHIM_ACTIVE-}" ]; then
  printf '%s\n' 'termnav ssh shim: refusing recursive shim invocation' >&2
  exit 126
fi

termnav_path=$(command -v termnav 2>/dev/null || true)
if [ -n "$termnav_path" ] && [ -x "$termnav_path" ]; then
  # The preceding release knew only its own install directory. Remove every
  # provider-owned shim directory before invoking it so a new checkout shim
  # can safely bootstrap through an older binary. The new binary restores the
  # original PATH only after it has selected a non-Termnav SSH executable.
  original_path=${PATH-/usr/bin:/bin}
  search_path=$original_path
  safe_path=
  safe_components=0
  while :; do
    case "$search_path" in
      *:*)
        directory=${search_path%%:*}
        search_path=${search_path#*:}
        ;;
      *)
        directory=$search_path
        search_path=
        last_component=1
        ;;
    esac
    probe_directory=${directory:-.}
    canonical_directory=$(CDPATH='' cd -P -- "$probe_directory" 2>/dev/null && pwd)
    case "$canonical_directory" in
      */share/termnav/shims) ;;
      *)
        if [ "$safe_components" -eq 0 ]; then
          safe_path=$directory
        else
          safe_path=$safe_path:$directory
        fi
        safe_components=$((safe_components + 1))
        ;;
    esac
    [ "${last_component-0}" -eq 1 ] && break
  done
  TERMNAV_SSH_SHIM_ACTIVE=1 \
    TERMNAV_SSH_SHIM_DIR=$shim_dir \
    TERMNAV_SSH_ORIGINAL_PATH=$original_path \
    PATH=$safe_path \
    exec "$termnav_path" ssh "$@"
fi

# Repository synchronization can replace this shim before the dependency
# installer activates the matching Termnav binary. Use only trusted platform
# locations during that bounded bootstrap window; older macOS shells do not
# reliably make `command -p -v` ignore the inherited shim-bearing PATH.
if [ -n "${PREFIX-}" ] && [ -x "$PREFIX/bin/ssh" ]; then
  exec "$PREFIX/bin/ssh" "$@"
fi
if [ -x /usr/bin/ssh ]; then
  exec /usr/bin/ssh "$@"
fi
if [ -x /bin/ssh ]; then
  exec /bin/ssh "$@"
fi

printf '%s\n' 'termnav ssh shim: neither termnav nor ssh is available' >&2
exit 127
