#!/usr/bin/env bash
# Print the host token used by OSC-8 file hyperlinks.

set -o pipefail

_termnav_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_termnav_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_termnav_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_termnav_script_parent "$path")" && pwd
}

script_dir=$(_termnav_script_dir "${BASH_SOURCE[0]}") || {
  echo "nvim-link-host: cannot resolve executable path" >&2
  exit 2
}
lib_dir="${script_dir%/bin}/lib/termnav"

# shellcheck source=../lib/termnav/nvim-link-context.sh
. "$lib_dir/nvim-link-context.sh" || exit 1

nvim_link_context_host
