#!/bin/bash
# Route nvim open requests from explicit input modes.
#
# `cli` preserves `nvim <file>` argv semantics for the local launcher.
# `link` interprets terminal/WezTerm/tmux link text and may route locally or
# remotely. Keeping those modes separate prevents terminal-link normalization
# from leaking into CLI-style file opens.

set -o pipefail

# GUI apps and remote noninteractive ssh commands don't inherit shell PATH.
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"

_termnav_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_termnav_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_termnav_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_termnav_script_parent "$path")" && pwd
}

script_dir=$(_termnav_script_dir "${BASH_SOURCE[0]}") || {
  echo "nvim-tmux-open: cannot resolve executable path" >&2
  exit 2
}
lib_dir="${script_dir%/bin}/lib/termnav/nvim-open"

# shellcheck source=../lib/termnav/nvim-open/common.sh
. "$lib_dir/common.sh" || exit 1
# shellcheck source=../lib/termnav/nvim-open/remote.sh
. "$lib_dir/remote.sh" || exit 1
# shellcheck source=../lib/termnav/nvim-open/cli.sh
. "$lib_dir/cli.sh" || exit 1
# shellcheck source=../lib/termnav/nvim-open/link.sh
. "$lib_dir/link.sh" || exit 1

mode="${1:-}"
case "$mode" in
  cli)
    shift
    nvim_open_cli "$@"
    ;;
  link)
    shift
    nvim_open_link "$@"
    ;;
  tmux-link)
    shift
    nvim_open_tmux_link "$@"
    ;;
  *)
    printf 'usage: nvim-tmux-open {cli|link|tmux-link} ...\n' >&2
    exit 2
    ;;
esac
