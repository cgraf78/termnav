#!/usr/bin/env bash
# Switch the nearest parent tmux window or outer terminal tab.

set -euo pipefail

_termnav_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_termnav_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_termnav_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_termnav_script_parent "$path")" && pwd
}

script_dir=$(_termnav_script_dir "${BASH_SOURCE[0]}") || {
  echo "termnav-switch-tab: cannot resolve executable path" >&2
  exit 2
}
lib_dir="${script_dir%/bin}/lib/termnav"

# shellcheck source=../lib/termnav/shell/vscode-command.sh
. "$lib_dir/shell/vscode-command.sh" || exit 1

_usage() {
  cat <<'EOF'
usage: termnav-switch-tab [next|previous] --client-pid PID
                          --client-tty TTY --client-termtype TYPE

Switch the nearest tab scope outside the current one-window tmux session.
Locally nested tmux clients are walked from inner to outer. The first parent
session with multiple windows owns the switch; otherwise the outer VS Code or
WezTerm client handles it.

Arguments:
  next|previous          Direction to switch. Defaults to next.

Options:
  --client-pid PID       PID of the tmux client that received the key.
  --client-tty TTY       TTY of that tmux client.
  --client-termtype TYPE Terminal type reported for that tmux client.
  -h, --help             Show this help.
EOF
}

_die() {
  printf 'termnav-switch-tab: %s\n' "$*" >&2
  exit 2
}

_is_uint() {
  case "$1" in
    "" | *[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

_process_env() {
  local pid="$1" name="$2" entry

  _is_uint "$pid" || return 1
  if [[ -r "/proc/$pid/environ" ]]; then
    while IFS= read -r entry; do
      case "$entry" in
        "$name="*)
          printf '%s\n' "${entry#*=}"
          return 0
          ;;
      esac
    done < <(tr '\0' '\n' <"/proc/$pid/environ")
    return 1
  fi

  # macOS has no /proc. The values used by this router contain no spaces, so
  # ps's environment suffix is an adequate compatibility fallback.
  while IFS= read -r entry; do
    case "$entry" in
      "$name="*)
        printf '%s\n' "${entry#*=}"
        return 0
        ;;
    esac
  done < <(ps eww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n')
  return 1
}

_process_ppid() {
  local pid="$1" key ppid value

  _is_uint "$pid" || return 1
  if [[ -r "/proc/$pid/status" ]]; then
    while read -r key value _; do
      if [[ "$key" == "PPid:" ]]; then
        _is_uint "$value" || return 1
        printf '%s\n' "$value"
        return 0
      fi
    done <"/proc/$pid/status"
  fi

  ppid=$(ps -p "$pid" -o ppid= 2>/dev/null) || return 1
  ppid="${ppid//[[:space:]]/}"
  _is_uint "$ppid" || return 1
  printf '%s\n' "$ppid"
}

_parent_tmux_context() {
  local pid="$1" depth=0 pane tmux_value

  PARENT_TMUX_VALUE=""
  PARENT_TMUX_PANE=""
  tmux_value=$(_process_env "$pid" TMUX 2>/dev/null || true)
  pane=$(_process_env "$pid" TMUX_PANE 2>/dev/null || true)
  if [[ -n "$tmux_value" && -n "$pane" ]]; then
    PARENT_TMUX_VALUE="$tmux_value"
    PARENT_TMUX_PANE="$pane"
    return 0
  fi

  # Nested launchers commonly clear one or both tmux variables for the client.
  # Recover only a complete pair from an ancestor; a top-level client simply
  # reaches the depth or PID guard without finding one.
  while ((depth < 8)); do
    depth=$((depth + 1))
    pid=$(_process_ppid "$pid") || return 1
    ((10#$pid > 1)) || return 1
    tmux_value=$(_process_env "$pid" TMUX 2>/dev/null || true)
    pane=$(_process_env "$pid" TMUX_PANE 2>/dev/null || true)
    if [[ -n "$tmux_value" && -n "$pane" ]]; then
      PARENT_TMUX_VALUE="$tmux_value"
      PARENT_TMUX_PANE="$pane"
      return 0
    fi
  done
  return 1
}

_parent_tmux_socket() {
  local without_slot

  case "$1" in
    *,*,*) ;;
    *) return 1 ;;
  esac
  without_slot="${1%,*}"
  REPLY="${without_slot%,*}"
  [[ -n "$REPLY" ]]
}

_parent_scope() {
  local client_pid="$1" tmux_value pane socket clients
  local activity pid tty termtype session windows active_pane client_flags
  local best_activity=-1 best_count=0 best_focused_count=0 is_focused
  local best_pid best_tty best_termtype best_session best_windows
  local focused_pid focused_tty focused_termtype focused_session focused_windows

  case "$CLIENT_TERMTYPE" in
    tmux* | screen*) ;;
    *) return 1 ;;
  esac

  _parent_tmux_context "$client_pid" || return 1
  tmux_value="$PARENT_TMUX_VALUE"
  pane="$PARENT_TMUX_PANE"
  _parent_tmux_socket "$tmux_value" || return 1
  socket="$REPLY"

  case "$visited" in
    *"|$socket:$pane|"*) return 1 ;;
  esac
  visited="$visited$socket:$pane|"

  clients=$(TMUX="" command tmux -S "$socket" list-clients -F \
    '#{client_activity}	#{client_pid}	#{client_tty}	#{client_termtype}	#{session_id}	#{session_windows}	#{pane_id}	#{client_flags}' \
    2>/dev/null) || return 1
  while IFS=$'\t' read -r activity pid tty termtype session windows active_pane client_flags; do
    if ! _is_uint "$activity" || ! _is_uint "$pid" || ! _is_uint "$windows"; then
      continue
    fi
    [[ -n "$tty" && -n "$session" && "$active_pane" == "$pane" ]] || continue

    is_focused=0
    case ",$client_flags," in
      *,focused,*) is_focused=1 ;;
    esac

    if ((10#$activity > best_activity)); then
      best_activity=$((10#$activity))
      best_count=1
      best_focused_count=0
      best_pid="$pid"
      best_tty="$tty"
      best_termtype="$termtype"
      best_session="$session"
      best_windows="$windows"
      if ((is_focused)); then
        best_focused_count=1
        focused_pid="$pid"
        focused_tty="$tty"
        focused_termtype="$termtype"
        focused_session="$session"
        focused_windows="$windows"
      fi
    elif ((10#$activity == best_activity)); then
      best_count=$((best_count + 1))
      if ((is_focused)); then
        best_focused_count=$((best_focused_count + 1))
        focused_pid="$pid"
        focused_tty="$tty"
        focused_termtype="$termtype"
        focused_session="$session"
        focused_windows="$windows"
      fi
    fi
  done <<<"$clients"

  ((best_activity >= 0)) || return 1
  if ((best_count == 1)); then
    :
  elif ((best_focused_count == 1)); then
    best_pid="$focused_pid"
    best_tty="$focused_tty"
    best_termtype="$focused_termtype"
    best_session="$focused_session"
    best_windows="$focused_windows"
  else
    return 11
  fi

  CLIENT_PID="$best_pid"
  CLIENT_TTY="$best_tty"
  CLIENT_TERMTYPE="$best_termtype"
  if ((10#$best_windows > 1)); then
    if [[ "$direction" == "previous" ]]; then
      TMUX="" command tmux -S "$socket" previous-window -t "$best_session" \
        >/dev/null 2>&1
    else
      TMUX="" command tmux -S "$socket" next-window -t "$best_session" \
        >/dev/null 2>&1
    fi
    return 0
  fi
  return 10
}

_route_vscode() {
  local backend command_id socket

  socket=$(_process_env "$CLIENT_PID" TERMNAV_VSCODE_SOCKET 2>/dev/null || true)
  command_id="workbench.action.terminal.focusNext"
  [[ "$direction" == "previous" ]] &&
    command_id="workbench.action.terminal.focusPrevious"

  if [[ -n "$socket" ]]; then
    TERMNAV_VSCODE_BACKEND=socket TERMNAV_VSCODE_SOCKET="$socket" \
      termnav_vscode_execute_command "$command_id"
    return
  fi

  backend="${TERMNAV_VSCODE_FALLBACK_BACKEND:-}"
  [[ -n "$backend" ]] || return 1
  TERMNAV_VSCODE_SOCKET="" TERMNAV_VSCODE_BACKEND="$backend" \
    termnav_vscode_execute_command "$command_id"
}

_route_terminal() {
  local term_program

  term_program=$(_process_env "$CLIENT_PID" TERM_PROGRAM 2>/dev/null || true)
  if [[ "$CLIENT_TERMTYPE" == xterm.js* || "$term_program" == "vscode" ]]; then
    _route_vscode
    return
  fi

  if [[ "$CLIENT_TERMTYPE" == tmux* || "$CLIENT_TERMTYPE" == screen* ]]; then
    "$script_dir/wezterm-switch-tab" --parent "$direction" "$CLIENT_TTY"
  else
    "$script_dir/wezterm-switch-tab" "$direction" "$CLIENT_TTY"
  fi
}

direction="next"
CLIENT_PID=""
CLIENT_TTY=""
CLIENT_TERMTYPE=""

while (($#)); do
  case "$1" in
    next | previous)
      direction="$1"
      shift
      ;;
    --client-pid)
      shift
      (($#)) || _die "--client-pid requires a value"
      CLIENT_PID="$1"
      shift
      ;;
    --client-pid=*)
      CLIENT_PID="${1#--client-pid=}"
      shift
      ;;
    --client-tty)
      shift
      (($#)) || _die "--client-tty requires a value"
      CLIENT_TTY="$1"
      shift
      ;;
    --client-tty=*)
      CLIENT_TTY="${1#--client-tty=}"
      shift
      ;;
    --client-termtype)
      shift
      (($#)) || _die "--client-termtype requires a value"
      CLIENT_TERMTYPE="$1"
      shift
      ;;
    --client-termtype=*)
      CLIENT_TERMTYPE="${1#--client-termtype=}"
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    -*)
      _die "unknown option: $1"
      ;;
    *)
      _die "unexpected argument: $1"
      ;;
  esac
done

_is_uint "$CLIENT_PID" || _die "--client-pid must be a process id"
[[ -n "$CLIENT_TTY" ]] || _die "--client-tty is required"
[[ -n "$CLIENT_TERMTYPE" ]] || _die "--client-termtype is required"

visited="|"
for _depth in 1 2 3 4 5 6 7 8; do
  if _parent_scope "$CLIENT_PID"; then
    exit 0
  else
    parent_rc=$?
  fi
  [[ "$parent_rc" -eq 11 ]] && exit 1
  [[ "$parent_rc" -eq 10 ]] || break
done

_route_terminal
