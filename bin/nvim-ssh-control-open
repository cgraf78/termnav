#!/usr/bin/env bash
# Open a remote nvim target through an existing SSH ControlMaster only.

set -o pipefail

host="${1:-}"
target="${2:-}"

if [[ -z "$host" || -z "$target" ]]; then
  exit 2
fi

case "$host" in
  *[!A-Za-z0-9_.-]* | .* | *..* | "")
    exit 11
    ;;
esac

host_allowed() {
  local allowed="${TERMNAV_SSH_CONTROL_HOSTS:-}" candidate
  local -a candidates

  [[ -n "$allowed" ]] || return 1
  IFS=, read -r -a candidates <<<"$allowed"
  for candidate in "${candidates[@]}"; do
    candidate="${candidate#"${candidate%%[![:space:]]*}"}"
    candidate="${candidate%"${candidate##*[![:space:]]}"}"
    [[ "$candidate" == "$host" ]] && return 0
  done
  return 1
}

if ! host_allowed; then
  # Reusing an existing SSH master is powerful enough that the public helper
  # requires each installation to opt in explicitly. Callers treat 13 as
  # "not allowed here" and can fall back to pane-based remote routing.
  exit 13
fi

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

ssh_common_opts=(
  -o BatchMode=yes
  -o ConnectTimeout=1
  -o ConnectionAttempts=1
  -o NumberOfPasswordPrompts=0
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
  -o PubkeyAuthentication=no
  -o GSSAPIAuthentication=no
  -o HostbasedAuthentication=no
)

if ! ssh "${ssh_common_opts[@]}" -O check "$host" >/dev/null 2>&1; then
  exit 10
fi

remote_command="\"\$HOME/.local/bin/nvim-tmux-open\" link $(shell_quote "$target") '' terminal"
# shellcheck disable=SC2029 # remote_command is built for the remote shell.
if ssh "${ssh_common_opts[@]}" "$host" "$remote_command"; then
  exit 0
fi

exit 12
