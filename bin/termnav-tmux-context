#!/usr/bin/env bash
# Publish tmux ownership to the terminal client that just attached.

set -euo pipefail

_termnav_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_termnav_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_termnav_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_termnav_script_parent "$path")" && pwd
}

script_dir=$(_termnav_script_dir "${BASH_SOURCE[0]}") || {
  echo "termnav-tmux-context: cannot resolve executable path" >&2
  exit 2
}
lib_dir="${script_dir%/bin}/lib/termnav"

# shellcheck source=../lib/termnav/shell/wezterm-vars.sh
. "$lib_dir/shell/wezterm-vars.sh" || exit 1

_usage() {
  cat <<'EOF'
usage: termnav-tmux-context --tty TTY --client-termname TERM
                            [--control-mode 0]
       termnav-tmux-context --control-mode 1

Publish TERMNAV_TMUX=true to a newly attached tmux client's terminal. tmux
hooks supply the client tty and terminal name so nested clients receive the
one passthrough layer needed to reach their parent terminal.

Options:
  --tty TTY               Client terminal device to write to.
  --client-termname TERM  tmux client terminal name.
  --control-mode 0|1      Skip control-mode clients without requiring terminal
                          metadata. Defaults to 0.
  -h, --help              Show this help.
EOF
}

_die() {
  printf 'termnav-tmux-context: %s\n' "$*" >&2
  exit 2
}

tty=""
client_termname=""
control_mode="0"

while (($#)); do
  case "$1" in
    --tty)
      shift
      (($#)) || _die "--tty requires a value"
      tty="$1"
      shift
      ;;
    --tty=*)
      tty="${1#--tty=}"
      [[ -n "$tty" ]] || _die "--tty requires a value"
      shift
      ;;
    --client-termname)
      shift
      (($#)) || _die "--client-termname requires a value"
      client_termname="$1"
      shift
      ;;
    --client-termname=*)
      client_termname="${1#--client-termname=}"
      [[ -n "$client_termname" ]] || _die "--client-termname requires a value"
      shift
      ;;
    --control-mode)
      shift
      (($#)) || _die "--control-mode requires a value"
      control_mode="$1"
      shift
      ;;
    --control-mode=*)
      control_mode="${1#--control-mode=}"
      [[ -n "$control_mode" ]] || _die "--control-mode requires a value"
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# == 0)) || _die "unexpected argument: $1"
      ;;
    -*) _die "unknown option: $1" ;;
    *) _die "unexpected argument: $1" ;;
  esac
done

case "$control_mode" in
  0) ;;
  1) exit 0 ;;
  *) _die "--control-mode must be 0 or 1" ;;
esac
[[ -n "$tty" ]] || _die "--tty is required"
[[ -n "$client_termname" ]] || _die "--client-termname is required"

# Writing to the client tty bypasses this tmux server. An immediate parent tmux
# needs passthrough framing; tmux clients can advertise either tmux-* or legacy
# screen-* terminfo names. Direct terminal clients receive the raw OSC sequence.
mode="raw"
case "$client_termname" in
  tmux* | screen*) mode="tmux" ;;
esac

termnav_wezterm_set_user_var "TERMNAV_TMUX" "true" "$tty" "$mode"
