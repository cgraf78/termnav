#!/usr/bin/env bash
# Follow a Ctrl-click received by tmux.
#
# WezTerm cannot conditionally intercept a mouse event and then pass the same
# event through to nvim with its click coordinates intact. Let tmux own
# mouse-reporting panes instead: nvim panes get the raw event via send-keys -M,
# while terminal panes call this helper with tmux's mouse formats.

set -o pipefail

# tmux run-shell inherits the server environment, not the interactive pane's
# freshly initialized shell. Keep the helper and opener discoverable when tmux
# was started before PATH gained ~/.local/bin or mise shims.
PATH="$PATH:$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin"

tmux_follow_token_detectors=()

# Environment overlays can teach the generic click parser about local token
# shapes without forking this helper. Detectors set `target` and `target_kind`
# when they claim a token.
tmux_follow_register_token_detector() {
  local detector="$1"

  [[ -n "$detector" ]] || return 1
  tmux_follow_token_detectors+=("$detector")
}

tmux_follow_extension_dir() {
  local config_home

  if [[ -n "${TERMNAV_TMUX_FOLLOW_EXTENSION_DIR:-}" ]]; then
    printf '%s\n' "$TERMNAV_TMUX_FOLLOW_EXTENSION_DIR"
    return 0
  fi

  # Token policy is user configuration, not part of the installed executable.
  # Keep the default under XDG config so the standalone termnav repo can be
  # installed by shdeps without depending on any caller-specific layout.
  config_home="${XDG_CONFIG_HOME:-}"
  if [[ -z "$config_home" ]]; then
    [[ -n "${HOME:-}" ]] || return 1
    config_home="$HOME/.config"
  fi
  printf '%s\n' "$config_home/termnav/tmux-follow/extensions.d"
}

tmux_follow_source_extensions() {
  local extension_dir
  local extension
  local had_nullglob=0
  local extensions=()

  extension_dir=$(tmux_follow_extension_dir)
  [[ -d "$extension_dir" ]] || return 0

  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob
  extensions=("$extension_dir"/*.sh)
  [[ "$had_nullglob" -eq 1 ]] || shopt -u nullglob

  for extension in "${extensions[@]}"; do
    # shellcheck disable=SC1090
    source "$extension"
  done
}

target_from_token_extensions() {
  local token="$1" original="${2:-$1}" detector

  for detector in "${tmux_follow_token_detectors[@]+"${tmux_follow_token_detectors[@]}"}"; do
    "$detector" "$token" "$original" && return 0
  done

  return 1
}

uri_decode() {
  local input="$1" out="" prefix hex rest char

  while [[ "$input" =~ ^([^%]*)%([0-9A-Fa-f][0-9A-Fa-f])(.*)$ ]]; do
    prefix="${BASH_REMATCH[1]}"
    hex="${BASH_REMATCH[2]}"
    rest="${BASH_REMATCH[3]}"
    printf -v char '%b' "\\x$hex"
    out+="$prefix$char"
    input="$rest"
  done

  printf '%s%s\n' "$out" "$input"
}

lower_ascii() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
}

url_like() {
  local value="$1" scheme

  # Path fallback intentionally accepts any token containing a slash so terminal
  # output such as `src/foo.cpp:12` works without semantic hyperlinks. Browser
  # URLs also contain slashes, so classify the schemes WezTerm normally owns
  # before path matching gets a chance to send them to nvim. URI schemes are
  # case-insensitive, and terminals can preserve user-written casing in plain
  # text, so normalize only the scheme for routing while preserving the original
  # URL bytes passed to WezTerm.
  case "$value" in
    *:*) scheme="${value%%:*}" ;;
    *) return 1 ;;
  esac
  case "$(lower_ascii "$scheme")" in
    file | nvim-open | nvim-remote | lazygit-edit) return 1 ;;
    http | https | ftp | mailto) return 0 ;;
  esac

  # Examples: wss://example.com/socket, postgres://user@localhost/db.
  [[ "$value" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]]
}

local_web_endpoint_like() {
  local value="$1"

  # Examples: localhost:5173, host.docker.internal:8080,
  # 192.168.1.20:8080/status.
  [[ "$value" =~ ^(localhost|host\.docker\.internal|127(\.[0-9]{1,3}){3}|10(\.[0-9]{1,3}){3}|192\.168(\.[0-9]{1,3}){2}|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2}|0\.0\.0\.0|\[::1\]):[0-9]{2,5}($|[/?#]) ]]
}

schemeless_web_like() {
  local value="$1"

  # Bare filenames are too noisy to classify by TLD alone. Require either an
  # explicit www. host or a slash-delimited URL path, which catches common
  # terminal output like `www.example.com` and `github.com/user/repo` without
  # stealing `README.md`.
  [[ "$value" =~ ^www\.([A-Za-z0-9-]+\.)+[A-Za-z]{2,}(:[0-9]{2,5})?($|[/?#]) ]] && return 0
  [[ "$value" =~ ^([A-Za-z0-9-]+\.)+[A-Za-z]{2,}(:[0-9]{2,5})?/ ]] && return 0

  return 1
}

git_remote_url() {
  local value="$1" host path

  # Examples: git@github.com:example/project.git,
  # git@gitlab.com:org/subgroup/project.
  if [[ "$value" =~ ^git@(github\.com|gitlab\.com|bitbucket\.org):([A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[1]}"
    path="${BASH_REMATCH[2]%.git}"
    printf 'https://%s/%s\n' "$host" "$path"
    return 0
  fi

  return 1
}

cve_url() {
  local value="$1" cve_id

  # Example: CVE-2024-12345.
  if [[ "$value" =~ ^[Cc][Vv][Ee]-([0-9]{4})-([0-9]{4,})$ ]]; then
    cve_id="CVE-${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
    printf 'https://www.cve.org/CVERecord?id=%s\n' "$cve_id"
    return 0
  fi

  return 1
}

rfc_url() {
  local value="$1"

  # Example: RFC-9110. Spaced references such as `RFC 9110` are handled from
  # the clicked line because tmux reports them as separate words.
  if [[ "$value" =~ ^[Rr][Ff][Cc]-?([0-9]{3,5})$ ]]; then
    printf 'https://www.rfc-editor.org/rfc/rfc%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi

  return 1
}

public_token_url() {
  local token="$1" url

  if local_web_endpoint_like "$token"; then
    printf 'http://%s\n' "$token"
    return 0
  fi
  if schemeless_web_like "$token"; then
    printf 'https://%s\n' "$token"
    return 0
  fi
  if url=$(git_remote_url "$token"); then
    printf '%s\n' "$url"
    return 0
  fi
  if url=$(cve_url "$token"); then
    printf '%s\n' "$url"
    return 0
  fi
  if url=$(rfc_url "$token"); then
    printf '%s\n' "$url"
    return 0
  fi

  return 1
}

claim_url() {
  local url="$1"

  target="$url"
  target_kind="url"
}

target_from_public_token() {
  local token="$1" url

  url=$(public_token_url "$token") || return 1
  claim_url "$url"
}

target_from_public_line() {
  local line="$1" x="$2" rest offset=0 match prefix start end number before after

  numeric "$x" || return 1
  rest="$line"
  # Example: clicking either word in `RFC 9110` opens the RFC page.
  while [[ "$rest" =~ ([Rr][Ff][Cc][[:space:]-]+([0-9]{3,5})) ]]; do
    match="${BASH_REMATCH[1]}"
    number="${BASH_REMATCH[2]}"
    prefix="${rest%%"$match"*}"
    start=$((offset + ${#prefix}))
    end=$((start + ${#match}))
    before=""
    after=""
    ((start > 0)) && before="${line:start-1:1}"
    ((end < ${#line})) && after="${line:end:1}"

    if [[ ! "$before" =~ [[:alnum:]_] && ! "$after" =~ [[:alnum:]_] ]]; then
      if ((x >= start && x < end)); then
        claim_url "https://www.rfc-editor.org/rfc/rfc$number"
        return 0
      fi
    fi

    rest="${rest:${#prefix}+${#match}}"
    offset="$end"
  done

  return 1
}

wezterm_user_var() {
  local name="$1" value="$2" encoded

  encoded=$(printf '%s' "$value" | base64 | tr -d '\n') || return 1
  printf '\033]1337;SetUserVar=%s=%s\007' "$name" "$encoded"
}

open_url() {
  local url="$1" osc discovered_client_tty

  osc=$(wezterm_user_var term_open_url "$url") || return 1

  # tmux starts this helper from a run-shell hook, so stdout is not a reliable
  # path back to the user's terminal. The mouse binding passes #{client_tty}
  # from the actual click context because rediscovering "the current client"
  # from a detached background helper is ambiguous when more than one client is
  # attached. Writing the OSC directly to that TTY asks the outer WezTerm to open
  # the URL in the local browser, which keeps remote tmux sessions from trying to
  # launch a browser on the server.
  if [[ -n "${click_client_tty:-}" ]] && printf '%s' "$osc" >"$click_client_tty" 2>/dev/null; then
    return 0
  fi

  # Keep a fallback for older tmux bindings and for direct/manual helper
  # invocations. It is best-effort only; the explicit click client above is the
  # reliable path for the installed config.
  if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    discovered_client_tty=$(tmux display-message -p '#{client_tty}' 2>/dev/null || true)
    if [[ -n "$discovered_client_tty" ]] && printf '%s' "$osc" >"$discovered_client_tty" 2>/dev/null; then
      return 0
    fi
  fi

  # Outside tmux, stdout is the terminal. This also gives a harmless fallback if
  # tmux cannot report a writable client TTY for an unusual invocation.
  printf '%s' "$osc"
}

open_file_target() {
  if ! command -v nvim-tmux-open >/dev/null 2>&1; then
    if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
      tmux display-message "Cannot open file link: nvim-tmux-open is not installed" 2>/dev/null || true
    else
      printf '%s\n' "Cannot open file link: nvim-tmux-open is not installed" >&2
    fi
    return 0
  fi

  # This helper runs under `tmux run-shell`, where a nonzero exit causes tmux to
  # print the entire generated here-doc command. Use the opener's tmux-facing
  # mode so user-visible failures stay as short status messages.
  if [[ -n "$target_context" ]]; then
    nvim-tmux-open tmux-link "$target" "$cwd" "$target_source" "$target_context"
  else
    nvim-tmux-open tmux-link "$target" "$cwd" "$target_source"
  fi
  return 0
}

local_file_host() {
  local host short fqdn published

  host=$(lower_ascii "$1")

  [[ -z "$host" || "$host" == "localhost" || "$host" == "127.0.0.1" || "$host" == "::1" ]] && return 0
  short=$(hostname -s 2>/dev/null || true)
  fqdn=$(hostname -f 2>/dev/null || true)
  [[ -n "$short" && "$host" == "$(lower_ascii "$short")" ]] && return 0
  [[ -n "$fqdn" && "$host" == "$(lower_ascii "$fqdn")" ]] && return 0

  published="${TERMNAV_REMOTE_LINK_HOST:-}"
  if [[ -z "$published" && -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    published=$(tmux show-environment -g TERMNAV_REMOTE_LINK_HOST 2>/dev/null || true)
    published="${published#TERMNAV_REMOTE_LINK_HOST=}"
  fi
  # Remote devserver links are intentionally stamped with the user-facing alias
  # (`dev1`) instead of the machine hostname (`devvm...`). When this helper is
  # running on that same remote tmux server, the alias is local for opening.
  [[ -n "$published" && "$host" == "$(lower_ascii "$published")" ]] && return 0

  return 1
}

target_from_hyperlink() {
  local uri="$1" host path rest

  if url_like "$uri"; then
    target="$uri"
    target_kind="url"
    return 0
  fi

  case "$uri" in
    nvim-open://*)
      target=$(uri_decode "${uri#nvim-open://}")
      # Older or over-broad terminal hyperlink rules may already have wrapped a
      # URL as an nvim target. Keep this helper defensive so future file-link
      # patterns cannot silently regress browser links inside tmux.
      if url_like "$target"; then
        target_kind="url"
      else
        target_kind="file"
      fi
      return 0
      ;;
    lazygit-edit://*)
      target=$(uri_decode "${uri#lazygit-edit://}")
      target_kind="file"
      return 0
      ;;
    nvim-remote://*/*)
      rest="${uri#nvim-remote://}"
      host="${rest%%/*}"
      if ! local_file_host "$host"; then
        target_source="remote"
        target_context="$host"
      fi
      target=$(uri_decode "/${rest#*/}")
      target_kind="file"
      return 0
      ;;
    file://*)
      rest="${uri#file://}"
      if [[ "$rest" == /* ]]; then
        path="$rest"
      elif [[ "$rest" == */* ]]; then
        host="${rest%%/*}"
        # Remote hosts should keep using the existing ControlMaster/tmux
        # routing path. Links for this host are local from the helper's point
        # of view, which is what matters when this runs on a devserver.
        if ! local_file_host "$host"; then
          target_source="remote"
          target_context="$host"
        fi
        path="/${rest#*/}"
      else
        return 1
      fi
      target=$(uri_decode "$path")
      target_kind="file"
      return 0
      ;;
  esac

  return 1
}

trim_token() {
  local token="$1"

  token="${token//$'\r'/}"
  while [[ -n "$token" ]]; do
    case "${token:0:1}" in
      \" | \' | \` | "(" | "[" | "{" | "<") token="${token:1}" ;;
      *) break ;;
    esac
  done
  while [[ -n "$token" ]]; do
    case "${token: -1}" in
      \" | \' | \` | ")" | "]" | "}" | ">" | "." | "," | ";") token="${token%?}" ;;
      *) break ;;
    esac
  done

  printf '%s\n' "$token"
}

path_like() {
  local value="$1"

  [[ -n "$value" ]] || return 1
  if [[ "$value" =~ [[:space:]] ]]; then
    # Match literal spellings from terminal output; expansion happens later.
    # shellcheck disable=SC2088
    case "$value" in
      /* | "~/"* | "\$HOME/"* | "\${HOME}/"* | ./* | ../*) return 0 ;;
    esac
    [[ "$value" =~ ^[^[:space:]]+/ ]] && return 0
    return 1
  fi
  [[ "$value" == /* ]] && return 0
  # Match the literal spellings users see in terminal output. Expansion happens
  # later in nvim-tmux-open, after the target has been selected.
  # shellcheck disable=SC2088
  [[ "$value" == "~/"* || "$value" == "\$HOME/"* || "$value" == "\${HOME}/"* ]] && return 0
  [[ "$value" == ./* || "$value" == ../* ]] && return 0
  [[ "$value" == */* ]] && return 0
  [[ "$value" =~ ^[^/[:space:]]+\.[-A-Za-z0-9_+]+:[0-9]+(:[0-9]+)?$ ]] && return 0

  return 1
}

target_from_token() {
  local token="$1" trimmed

  trimmed=$(trim_token "$token")
  if url_like "$trimmed"; then
    claim_url "$trimmed"
    return 0
  fi
  if target_from_token_extensions "$trimmed" "$token"; then
    return 0
  fi
  if target_from_public_token "$trimmed"; then
    return 0
  fi
  if path_like "$trimmed"; then
    target="$trimmed"
    target_kind="file"
    return 0
  fi

  return 1
}

target_from_embedded_token() {
  local token="$1" rel_x="$2" len start=0 end char
  local segments_start=() segments_end=()
  local clicked=-1 i j segment best=""

  [[ "$rel_x" =~ ^[0-9]+$ ]] || return 1
  len=${#token}

  while ((start < len)); do
    while ((start < len)); do
      char="${token:start:1}"
      [[ "$char" =~ [[:space:]] ]] || break
      start=$((start + 1))
    done
    ((start < len)) || break

    end="$start"
    while ((end < len)); do
      char="${token:end:1}"
      [[ "$char" =~ [[:space:]] ]] && break
      end=$((end + 1))
    done

    if ((rel_x >= start && rel_x < end)); then
      clicked="${#segments_start[@]}"
    fi
    segments_start+=("$start")
    segments_end+=("$end")

    start="$end"
  done

  ((clicked >= 0)) || return 1

  for ((i = 0; i <= clicked; i++)); do
    for ((j = ${#segments_start[@]} - 1; j >= clicked; j--)); do
      segment="${token:${segments_start[$i]}:${segments_end[$j]}-${segments_start[$i]}}"
      if path_like "$(trim_token "$segment")"; then
        best="$segment"
        break
      fi
    done
    [[ -n "$best" ]] && break
  done

  if [[ -n "$best" ]]; then
    target_from_token "$best"
    return $?
  fi

  segment="${token:${segments_start[$clicked]}:${segments_end[$clicked]}-${segments_start[$clicked]}}"
  target_from_token "$segment"
}

target_from_word() {
  target_from_token "$1"
}

target_from_line() {
  local line="$1" x="$2" len start=0 end char quote token

  [[ "$x" =~ ^[0-9]+$ ]] || return 1
  len=${#line}
  target_from_public_line "$line" "$x" && return 0

  # `mouse_word` can be too narrow for slash-delimited paths depending on tmux's
  # word separators. Use the clicked line as a conservative fallback, while
  # respecting simple quotes so paths such as './dir with spaces/file.cpp:12'
  # stay one candidate token.
  while ((start < len)); do
    while ((start < len)); do
      char="${line:start:1}"
      [[ "$char" =~ [[:space:]] ]] || break
      start=$((start + 1))
    done
    ((start < len)) || break

    quote="${line:start:1}"
    if [[ "$quote" == \" || "$quote" == "'" || "$quote" == "\`" ]]; then
      end=$((start + 1))
      while ((end < len)) && [[ "${line:end:1}" != "$quote" ]]; do
        end=$((end + 1))
      done
      if ((end < len)); then
        end=$((end + 1))
      fi
    else
      end="$start"
      while ((end < len)); do
        char="${line:end:1}"
        [[ "$char" =~ [[:space:]] ]] && break
        end=$((end + 1))
      done
    fi

    if ((x >= start && x < end)); then
      token="${line:start:end-start}"
      target_from_token "$token" && return 0
      target_from_embedded_token "$token" "$((x - start))"
      return $?
    fi

    start="$end"
  done

  return 1
}

numeric() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

capture_physical_lines=()
capture_joined_lines=()

capture_pane_lines() {
  local pane_id="$1" physical joined line

  [[ -n "$pane_id" ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1

  physical=$(tmux capture-pane -p -S 0 -E - -t "$pane_id" 2>/dev/null) || return 1
  joined=$(tmux capture-pane -p -J -S 0 -E - -t "$pane_id" 2>/dev/null) || return 1

  capture_physical_lines=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    capture_physical_lines+=("$line")
  done <<<"$physical"

  capture_joined_lines=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    capture_joined_lines+=("$line")
  done <<<"$joined"

  [[ "${#capture_physical_lines[@]}" -gt 0 && "${#capture_joined_lines[@]}" -gt 0 ]]
}

click_row_from_capture() {
  local y="$1" mouse_line="$2" pane_top="$3"
  local candidates=() candidate row count match
  local physical_count="${#capture_physical_lines[@]}"

  if numeric "$y"; then
    candidates+=("$y")
    if ((y > 0)); then
      candidates+=("$((y - 1))")
    fi
    if numeric "$pane_top"; then
      candidates+=("$((y - pane_top))")
      if ((y - pane_top > 0)); then
        candidates+=("$((y - pane_top - 1))")
      fi
    fi
  fi

  # tmux mouse coordinates vary by context: pane events usually give pane-local
  # rows, while some commands report window-local rows. Prefer candidates that
  # also match `mouse_line`, then fall back to a unique text match.
  for candidate in "${candidates[@]}"; do
    if ((candidate >= 0 && candidate < physical_count)); then
      if [[ -z "$mouse_line" || "${capture_physical_lines[$candidate]}" == "$mouse_line" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done

  if [[ -n "$mouse_line" ]]; then
    count=0
    match=""
    for ((row = 0; row < physical_count; row++)); do
      if [[ "${capture_physical_lines[$row]}" == "$mouse_line" ]]; then
        count=$((count + 1))
        match="$row"
      fi
    done
    if [[ "$count" -eq 1 ]]; then
      printf '%s\n' "$match"
      return 0
    fi
  fi

  for candidate in "${candidates[@]}"; do
    if ((candidate >= 0 && candidate < physical_count)); then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

target_from_joined_capture() {
  local clicked_row="$1" click_x="$2" logical part offset adjusted
  local physical_index=0 joined_index=0 matched
  local physical_count="${#capture_physical_lines[@]}"
  local joined_count="${#capture_joined_lines[@]}"

  numeric "$clicked_row" && numeric "$click_x" || return 1

  for ((joined_index = 0; joined_index < joined_count && physical_index < physical_count; joined_index++)); do
    logical="${capture_joined_lines[$joined_index]}"
    offset=0
    matched=0

    while ((physical_index < physical_count)); do
      part="${capture_physical_lines[$physical_index]}"
      if [[ "${logical:offset:${#part}}" != "$part" ]]; then
        if ((matched == 0)); then
          if ((physical_index == clicked_row)); then
            target_from_line "$part" "$click_x" && return 0
          fi
          physical_index=$((physical_index + 1))
        fi
        break
      fi

      if ((physical_index == clicked_row)); then
        adjusted=$((click_x + offset))
        target_from_line "$logical" "$adjusted" && return 0
        target_from_line "$part" "$click_x" && return 0
        return 1
      fi

      offset=$((offset + ${#part}))
      matched=1
      physical_index=$((physical_index + 1))
      if ((offset >= ${#logical})); then
        break
      fi
    done
  done

  return 1
}

target_from_pane_capture() {
  local pane_id="$1" click_x="$2" click_y="$3" mouse_line="$4" pane_top="$5" pane_left="$6"
  local row x_candidates=() candidate_x

  [[ -n "$pane_id" ]] || return 1
  numeric "$click_x" || return 1

  capture_pane_lines "$pane_id" || return 1
  row=$(click_row_from_capture "$click_y" "$mouse_line" "$pane_top") || return 1

  x_candidates+=("$click_x")
  if numeric "$pane_left"; then
    x_candidates+=("$((click_x - pane_left))")
    if ((click_x - pane_left > 0)); then
      x_candidates+=("$((click_x - pane_left - 1))")
    fi
  fi

  for candidate_x in "${x_candidates[@]}"; do
    if numeric "$candidate_x"; then
      target_from_joined_capture "$row" "$candidate_x" && return 0
    fi
  done

  return 1
}

line_has_quote() {
  case "$1" in
    *\'* | *\"* | *\`*) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ "${1:-}" == "--stdin" ]]; then
  # tmux mouse fields are terminal text, not shell syntax. Reading them from a
  # quoted here-doc avoids fragile inline VAR=value parsing for indented command
  # output, and preserves literal `$HOME` paths for later
  # expansion in nvim-tmux-open.
  IFS= read -r hyperlink || hyperlink=""
  IFS= read -r word || word=""
  IFS= read -r line || line=""
  IFS= read -r x || x=""
  IFS= read -r cwd || cwd=""
  IFS= read -r click_client_tty || click_client_tty=""
  IFS= read -r pane_id || pane_id=""
  IFS= read -r y || y=""
  IFS= read -r pane_top || pane_top=""
  IFS= read -r pane_left || pane_left=""
else
  hyperlink="${1-${TMUX_MOUSE_HYPERLINK:-}}"
  word="${2-${TMUX_MOUSE_WORD:-}}"
  line="${3-${TMUX_MOUSE_LINE:-}}"
  x="${4-${TMUX_MOUSE_X:-}}"
  cwd="${5-${TMUX_MOUSE_CWD:-}}"
  click_client_tty="${6-${TMUX_CLIENT_TTY:-}}"
  pane_id="${7-${TMUX_MOUSE_PANE_ID:-}}"
  y="${8-${TMUX_MOUSE_Y:-}}"
  pane_top="${9-${TMUX_MOUSE_PANE_TOP:-}}"
  pane_left="${10-${TMUX_MOUSE_PANE_LEFT:-}}"
fi

tmux_follow_source_extensions

target=""
target_kind="file"
target_source="terminal"
target_context=""
line_tried=0
if [[ -n "$hyperlink" ]]; then
  target_from_hyperlink "$hyperlink" || true
fi
if [[ -z "$target" && -n "$pane_id" ]]; then
  target_from_pane_capture "$pane_id" "$x" "$y" "$line" "$pane_top" "$pane_left" || true
fi
if [[ -z "$target" && -n "$line" ]] && line_has_quote "$line"; then
  line_tried=1
  target_from_line "$line" "$x" || true
fi
if [[ -z "$target" && -n "$word" ]]; then
  target_from_word "$word" || true
fi
if [[ -z "$target" && -n "$line" && "$line_tried" -eq 0 ]]; then
  target_from_line "$line" "$x" || true
fi

[[ -n "$target" ]] || exit 0
if [[ "$target_kind" == "url" ]]; then
  open_url "$target"
  exit 0
fi
open_file_target
