#!/usr/bin/env bash
# Ask the outer WezTerm tab layer to move the current tab.

set -euo pipefail

_termnav_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_termnav_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_termnav_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_termnav_script_parent "$path")" && pwd
}

script_dir=$(_termnav_script_dir "${BASH_SOURCE[0]}") || {
  echo "wezterm-move-tab: cannot resolve executable path" >&2
  exit 2
}
lib_dir="${script_dir%/bin}/lib/termnav"

# shellcheck source=../lib/termnav/shell/wezterm-vars.sh
. "$lib_dir/shell/wezterm-vars.sh" || exit 1

_usage() {
  cat <<'EOF'
usage: wezterm-move-tab [left|right] [tty]
       wezterm-move-tab [left|right] --tty TTY

Emit a WezTerm OSC 1337 SetUserVar request that asks the outer WezTerm tab
layer to move the current tab left or right. tmux bindings are the common
caller, but any terminal program can call this when it has the terminal tty.

Arguments:
  left|right         Direction to move. Defaults to right.
  tty                Terminal device to write to. Defaults to
                     $WEZTERM_MOVE_TAB_TTY, then /dev/tty.

Options:
  --tty TTY          Terminal device to write to.
  --parent           Bubble the move to the parent tmux layer.
  -h, --help         Show this help.
EOF
}

_die() {
  printf 'wezterm-move-tab: %s\n' "$*" >&2
  exit 2
}

direction="right"
tty="${WEZTERM_MOVE_TAB_TTY:-}"
parent=0

while (($#)); do
  case "$1" in
    left | right)
      direction="$1"
      shift
      ;;
    --tty)
      shift
      (($#)) || _die "--tty requires a value"
      tty="$1"
      shift
      ;;
    --tty=*)
      tty="${1#--tty=}"
      [[ -n "$tty" ]] || _die "--tty requires a value"
      shift
      ;;
    --parent)
      parent=1
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# <= 1)) || _die "expected at most one tty"
      if (($#)); then
        tty="$1"
        shift
      fi
      ;;
    -*)
      _die "unknown option: $1"
      ;;
    *)
      if [[ -n "$tty" ]]; then
        _die "unexpected argument: $1"
      fi
      tty="$1"
      shift
      ;;
  esac
done

case "$direction" in
  left | right) ;;
  *) _die "direction must be left or right" ;;
esac

tty="${tty:-/dev/tty}"
[[ -n "$tty" ]] || _die "tty is empty"

payload=$(printf '%s:%s.%s.%s' "$direction" "$(date +%s)" "$$" "$RANDOM")
user_var="DOT_MOVE_TAB"
mode="raw"
if ((parent)); then
  user_var="DOT_PARENT_MOVE_TAB"
  mode="tmux"
fi

termnav_wezterm_set_user_var "$user_var" "$payload" "$tty" "$mode"
