#!/usr/bin/env bash
# Fast public relay entry point. Latency-sensitive commands use one resident
# Python service; maintenance and unusual CLI forms retain the full parser.

set -u
set -o pipefail

resolve_self() {
  local path=${BASH_SOURCE[0]} dir target
  while [[ -L $path ]]; do
    dir=$(cd -P -- "${path%/*}" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ $target == /* ]] || target="$dir/$target"
    path=$target
  done
  dir=$(cd -P -- "${path%/*}" && pwd) || return 1
  printf '%s/%s\n' "$dir" "${path##*/}"
}

die() {
  printf 'termnav-relay: %s\n' "$*" >&2
  exit 2
}

usage() {
  cat <<'EOF'
usage: termnav-relay [-h] {send,serve,commit,sweep,navigate,warm,stop,ssh} ...

positional arguments:
  {send,serve,commit,sweep,navigate,warm,stop,ssh}

options:
  -h, --help            show this help message and exit
EOF
}

self=$(resolve_self) || die "cannot resolve executable path"
root=${self%/bin/termnav-relay}
backend=$root/lib/termnav/relay.py
python=${TERMNAV_PYTHON:-python3}

runtime_base=${XDG_RUNTIME_DIR:-${TMPDIR:-${TEMP:-${TMP:-/tmp}}}}
case $runtime_base in
  /*) ;;
  *) runtime_base=/tmp ;;
esac
uid=${UID:-}
if [[ -z $uid ]]; then
  uid=$(id -u) || die "cannot determine user id"
fi
runtime=$runtime_base/termnav-$uid

# Keep independent checkouts from contending for one daemon. A small in-shell
# FNV-1a key avoids adding another process to every gesture; collisions remain
# safe because the request also carries the canonical provider root.
provider_key_for() {
  local value=$1 hash=2166136261 index byte
  local LC_ALL=C
  for ((index = 0; index < ${#value}; index++)); do
    printf -v byte '%d' "'${value:index:1}"
    hash=$(((hash ^ byte) * 16777619 & 0xffffffff))
  done
  printf -v provider_key '%08x' "$hash"
}
provider_key_for "$root"
socket=$runtime/hot-v1-$provider_key.sock

fallback() {
  if [[ ${1:-} == navigate ]]; then
    shift
    exec "$root/bin/termnav-navigate" "$@"
  fi
  exec "$python" "$backend" "$@"
}

start_service() {
  command -v curl >/dev/null 2>&1 || return 1
  # nohup belongs inside this short-lived wrapper, so an interactive parent
  # shell never owns or reports the daemon as one of its jobs.
  nohup "$python" "$backend" hot-serve --detach --socket "$socket" \
    </dev/null >/dev/null 2>&1 &
}

call_service() {
  local response status
  response=$(
    printf '%s\0' \
      termnav-hot-v1 \
      "$root" \
      "${TERMNAV_PARENT_RELAY:-}" \
      "${PATH:-}" \
      "${HOME:-}" \
      "${XDG_STATE_HOME:-}" \
      "${TERMNAV_VSCODE_CURL:-}" \
      "${TERMNAV_VSCODE_FALLBACK_BACKEND:-}" \
      "${VSCODE_MCP_PORT:-}" \
      "$@" |
      # A relay may legitimately spend six seconds awaiting the outer commit
      # receipt. Keep the client bound just above the provider's eight-second
      # RPC deadline; a shorter UI timeout would turn deep but valid routes
      # into false transport failures.
      command curl --silent --fail --max-time 9 --unix-socket "$socket" \
        --header 'Content-Type: application/octet-stream' \
        --data-binary @- http://localhost/v1
  )
  status=$?
  CALL_STATUS=$status
  [[ $status -eq 0 ]] || return 1
  case $response in
    0 | 1 | 3 | 125)
      REPLY=$response
      return 0
      ;;
  esac
  return 1
}

wait_for_service() {
  local attempt
  for ((attempt = 0; attempt < 100; attempt++)); do
    if [[ -S $socket ]] && call_service warm; then
      return 0
    fi
    sleep 0.01
  done
  return 1
}

stop_service() {
  local attempt
  [[ -S $socket ]] || return 0
  call_service stop >/dev/null 2>&1 || return 1
  [[ $REPLY == 0 ]] || return 1
  for ((attempt = 0; attempt < 1000; attempt++)); do
    [[ ! -S $socket ]] && return 0
    sleep 0.01
  done
  return 1
}

service_is_stale() {
  local source
  [[ -S $socket ]] || return 1
  for source in \
    "$backend" \
    "$root/lib/termnav/hot_service.py" \
    "$root/lib/termnav/navigation.py" \
    "$root/lib/termnav/navigation_protocol.py" \
    "$root/lib/termnav/process_info.py" \
    "$root/lib/termnav/relay_client.py"; do
    [[ $source -nt $socket ]] && return 0
  done
  return 1
}

case ${1:-} in
  -h | --help)
    # The resident-service controls belong to the public shell facade, while
    # hot-serve is an implementation detail of the Python backend. Keep the
    # top-level help aligned with the commands users can intentionally invoke.
    usage
    exit 0
    ;;
esac

# Most repository suites exercise the parser and relay semantics directly.
# Only the dedicated lifecycle and performance suites opt into detached state,
# keeping verification isolated from the developer's real terminal service.
if [[ ${REPO_TEST:-0} == 1 && ${TERMNAV_TEST_HOT:-0} != 1 ]]; then
  fallback "$@"
fi

case ${1:-} in
  warm)
    [[ $# -eq 1 ]] || die "warm accepts no arguments"
    command -v curl >/dev/null 2>&1 || fallback sweep
    if service_is_stale; then
      stop_service || true
    fi
    if [[ ! -S $socket ]]; then
      start_service || exit 0
    fi
    exit 0
    ;;
  stop)
    [[ $# -eq 1 ]] || die "stop accepts no arguments"
    stop_service
    exit $?
    ;;
  send | commit | navigate)
    command -v curl >/dev/null 2>&1 || fallback "$@"
    if service_is_stale; then
      # A draining old daemon may keep its socket alive beyond the bounded
      # shutdown wait. Never send a fresh gesture back through code we already
      # identified as stale; the one-shot backend is slower but authoritative
      # for this invocation, and the old daemon will retire after its work.
      stop_service || fallback "$@"
      start_service || fallback "$@"
      wait_for_service || fallback "$@"
    fi
    if [[ ! -S $socket ]]; then
      start_service || fallback "$@"
      wait_for_service || fallback "$@"
    fi
    if call_service "$@"; then
      [[ $REPLY != 125 ]] || fallback "$@"
      exit "$REPLY"
    fi
    if [[ ${CALL_STATUS:-} == 2 ]]; then
      # curl reports initialization and unsupported-option failures before it
      # can connect. Older platform builds without --unix-socket therefore
      # retain the complete Python behavior without risking a duplicate action.
      fallback "$@"
    fi
    if [[ ${CALL_STATUS:-} == 7 ]]; then
      # curl 7 means it never connected, so the gesture cannot have executed.
      # This is the only transport failure that is safe to recover and retry;
      # receive-side failures stay fail-closed to prevent duplicate movement.
      start_service || fallback "$@"
      wait_for_service || fallback "$@"
      if call_service "$@"; then
        [[ $REPLY != 125 ]] || fallback "$@"
        exit "$REPLY"
      fi
    fi
    # The request may have reached the service before the connection failed,
    # so never retry a gesture. Start a replacement only for the next keypress.
    start_service || true
    exit 1
    ;;
  *)
    fallback "$@"
    ;;
esac
